# /etc/systemd/system/choice-pm.service
# CHOICE 生产常驻服务：开机自启 + 崩溃自拉。
# 端口用环境变量 PORT 与同机其它站点隔离（默认 5050，这里用 5060）。
[Unit]
Description=CHOICE PM (Flask)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/choice-pm
Environment=PORT=5060          # 与 AGI 的 5050/其它端口错开，同机不冲突
ExecStart=/opt/choice-pm/.venv/bin/python app.py
Restart=always
RestartSec=3
# 生产数据与代码分离：把数据库/上传目录挂到持久盘更好，这里默认在部署目录内

[Install]
WantedBy=multi-user.target

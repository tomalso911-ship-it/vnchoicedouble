function bindCrossHighlight(){
var tbody=document.getElementById('wonTbody'); if(!tbody) return;
if(tbody.__chBound) return;
tbody.__chBound=true;
tbody.addEventListener('mouseover', onCrossOver);
tbody.addEventListener('mouseout', onCrossOut);
}

function onCrossOver(e){
var td = e.target.closest('td');
if(!td) return;
var tr = td.closest('tr');
if(!tr) return;

if(tr.classList.contains('fake-header-row')) {
document.querySelectorAll('#wonTbody td.row-hl,#wonTbody td.col-hl,#wonTbody td.cross-hl')
.forEach(function(c){ c.classList.remove('row-hl','col-hl','cross-hl'); });
return;
}

if(tr.closest('thead')){
document.querySelectorAll('#wonTbody td.row-hl,#wonTbody td.col-hl,#wonTbody td.cross-hl')
.forEach(function(c){ c.classList.remove('row-hl','col-hl','cross-hl'); });
return;
}

var col=td.dataset.col; if(col===undefined) return;
tr.querySelectorAll('td').forEach(function(c){ c.classList.add('row-hl'); });
document.querySelectorAll('#wonTbody td[data-col="' + col + '"]').forEach(function(c){
if(c.closest('tr.fake-header-row')) return;
c.classList.add('col-hl');
if(c.closest('tr')===tr) c.classList.add('cross-hl');
});
}

function onCrossOut(e){
var td=e.target.closest('td'); if(!td) return;
var tr=td.closest('tr'); if(!tr || tr.classList.contains('fake-header-row')) return;
var col=td.dataset.col; if(col===undefined) return;
tr.querySelectorAll('td').forEach(function(c){ c.classList.remove('row-hl'); });
document.querySelectorAll('#wonTbody td[data-col="' + col + '"]').forEach(function(c){
c.classList.remove('col-hl','cross-hl');
});
}


function bindSumOnHover(){
var tbody = document.getElementById('wonTbody');
if(!tbody) return;
if(tbody.__sumBound) return;
tbody.__sumBound=true;

var activeTooltip = null;

tbody.addEventListener('mouseover', function(e) {
var td = e.target.closest('td');
if(!td) return;

var tr = td.closest('tr');
if(!tr || !tr.classList.contains('fake-header-row')) {
if(activeTooltip) { activeTooltip.remove(); activeTooltip = null; }
return;
}

if(!td.classList.contains('won-rmb') && !td.classList.contains('won-usd') && !td.classList.contains('won-vnd')) {
if(activeTooltip) { activeTooltip.remove(); activeTooltip = null; }
return;
}

var colIdx = td.dataset.col;
if(colIdx === undefined) return;

var sum = 0;
tbody.querySelectorAll('tr.won-data-row').forEach(function(row) {
var cell = row.querySelector('td[data-col="' + colIdx + '"]');
if(cell) {
var valStr = cell.textContent.replace(/[^0-9-]/g, '');
var val = parseFloat(valStr);
if(!isNaN(val)) sum += val;
}
});

if(activeTooltip) { activeTooltip.remove(); activeTooltip = null; }

var currencySymbol = '';
if (td.classList.contains('won-rmb')) currencySymbol = '¥';
else if (td.classList.contains('won-usd')) currencySymbol = '$';
else if (td.classList.contains('won-vnd')) currencySymbol = '₫';

var formattedSum = sum.toLocaleString('en-US');
var tooltip = document.createElement('div');
tooltip.className = 'won-sum-tooltip';
tooltip.textContent = '∑ ' + currencySymbol + ' ' + formattedSum;

document.body.appendChild(tooltip);
activeTooltip = tooltip;

var rect = td.getBoundingClientRect();
var left = rect.right + 6;
var top = rect.top + (rect.height / 2);

if (left + 100 > window.innerWidth) {
left = rect.left - tooltip.offsetWidth - 6;
}

tooltip.style.left = left + 'px';
tooltip.style.top = top + 'px';
});

tbody.addEventListener('mouseout', function(e) {
var td = e.target.closest('td');
if(!td) {
if(activeTooltip) { activeTooltip.remove(); activeTooltip = null; }
return;
}
if(activeTooltip) { activeTooltip.remove(); activeTooltip = null; }
});
}



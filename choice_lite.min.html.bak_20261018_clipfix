function prod_houseSpecProduced(f){
var map = {};
var mm = prod_slatsMatrix();
var production = f.production || {};
for(var d in production){ if(!production.hasOwnProperty(d)) continue; var rec = production[d];
if(!rec || !rec.lines) continue;
for(var n in rec.lines){ if(!rec.lines.hasOwnProperty(n)) continue; var line = rec.lines[n];
if(!line) continue;

var doneSpec = {};
if(line.qtyDetail){
for(var ds in line.qtyDetail){ if(!line.qtyDetail.hasOwnProperty(ds)) continue;
var dm = line.qtyDetail[ds]; if(!dm) continue;
var dsum = 0;
for(var dh in dm){ if(!dm.hasOwnProperty(dh)) continue;
var dq = (+dm[dh]||0); if(dq<=0) continue;
if(!map[dh]) map[dh] = {};
map[dh][ds] = (map[dh][ds]||0) + dq;
dsum += dq;
}
if(dsum > 0) doneSpec[ds] = 1;
}
}

var hasRestQty = false;
if(line.qty){
for(var qs in line.qty){ if(line.qty.hasOwnProperty(qs) && !doneSpec[qs] && (+line.qty[qs]||0) > 0){ hasRestQty = true; break; } }
}
if(hasRestQty && line.houses && line.houses.length && !line.matrix){
for(var s in line.qty){ if(!line.qty.hasOwnProperty(s) || doneSpec[s]) continue;
var q = (+line.qty[s]||0);
if(q<=0) continue;
var eligible = [];
var totalDemand = 0;
for(var hi=0; hi<line.houses.length; hi++){
var hq = line.houses[hi];
var dem = ((mm.specs[s] && mm.specs[s].houses[hq]) || 0);
if(dem > 0){ eligible.push({h:hq, dem:dem}); totalDemand += dem; }
}
if(!eligible.length){

for(var hi2=0; hi2<line.houses.length; hi2++){
var hz = line.houses[hi2];
if(!map[hz]) map[hz] = {};
map[hz][s] = (map[hz][s]||0) + q;
}
continue;
}

var allocated = 0, maxIdx = 0;
for(var ei=0; ei<eligible.length; ei++){
var e = eligible[ei];
var share = totalDemand > 0 ? Math.round(q * e.dem / totalDemand) : 0;
e.share = share;
allocated += share;
if(share > eligible[maxIdx].share) maxIdx = ei;
}
if(allocated !== q && eligible.length) eligible[maxIdx].share += (q - allocated);
for(var ei2=0; ei2<eligible.length; ei2++){
var e2 = eligible[ei2];
if(e2.share <= 0) continue;
if(!map[e2.h]) map[e2.h] = {};
map[e2.h][s] = (map[e2.h][s]||0) + e2.share;
}
}
} else if(line.matrix){

for(var mh in line.matrix){ if(!line.matrix.hasOwnProperty(mh)) continue;
if(!map[mh]) map[mh] = {};
for(var ms in line.matrix[mh]){ if(!line.matrix[mh].hasOwnProperty(ms)) continue;
if(doneSpec[ms]) continue;
var mv = (+line.matrix[mh][ms]||0);
if(mv > 0) map[mh][ms] = (map[mh][ms]||0) + mv;
}
}
}
}
}
return map;
}

function prod_producedForHousesSpec(f, spec, houses){
var set={}; (houses||[]).forEach(function(h){ set[h]=1; });
if(!Object.keys(set).length) return 0;
var total=0;
var production=(f&&f.production)||{};
for(var d in production){ if(!production.hasOwnProperty(d)) continue;
var rec=production[d]; if(!rec || !rec.lines) continue;
for(var n in rec.lines){ if(!rec.lines.hasOwnProperty(n)) continue;
var line=rec.lines[n]; if(!line) continue;
var q=0;
if(line.qty && line.qty[spec]!=null){ q=+line.qty[spec]||0; }
else if(line.matrix){ for(var hh in line.matrix){ if(line.matrix.hasOwnProperty(hh) && line.matrix[hh][spec]!=null){ q+=(+line.matrix[hh][spec]||0); } } }
if(q<=0) continue;
var lh=(line.houses&&line.houses.length)?line.houses:(line.matrix?Object.keys(line.matrix):[]);
var hit=false; for(var i=0;i<lh.length;i++){ if(set[lh[i]]){ hit=true; break; } }
if(hit) total+=q;
}
}
return total;
}


function renderGanttChart(rows, t) {
if (!rows || rows.length === 0) {
return '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_gantt || '📈 收款进度甘特图') + '</div>' +
'<div class="cashflow-empty">' + (t.rpt_gantt_no_data || '暂无付款数据') + '</div>' +
'</div>';
}


var items = [];
for (var i = 0; i < rows.length; i++) {
var r = rows[i];

var planRmb = (r.plan && r.plan.rmb) || 0;
var planUsd = (r.plan && r.plan.usd) || 0;
var planVnd = (r.plan && r.plan.vnd) || 0;
if ((planRmb > 0 || planUsd > 0 || planVnd > 0) && r.planDate) {
items.push({
date: r.planDate,
rmb: planRmb,
usd: planUsd,
vnd: planVnd,
label: _trCat(r.cat) || (t.rpt_gantt_expected || '预计收款'),
type: 'plan',
bg: r.bg && r.bg.has === 'yes'
});
}

var actualRmb = (r.actual && r.actual.rmb) || 0;
var actualUsd = (r.actual && r.actual.usd) || 0;
var actualVnd = (r.actual && r.actual.vnd) || 0;
if ((actualRmb > 0 || actualUsd > 0 || actualVnd > 0) && r.actualDate) {
items.push({
date: r.actualDate,
rmb: actualRmb,
usd: actualUsd,
vnd: actualVnd,
label: _trCat(r.cat) || (t.rpt_gantt_actual || '实际收款'),
type: 'actual',
bg: r.bg && r.bg.has === 'yes'
});
}
}

if (items.length === 0) {
return '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_gantt || '📈 收款进度甘特图') + '</div>' +
'<div class="cashflow-empty">' + (t.rpt_gantt_no_data || '暂无付款数据') + '</div>' +
'</div>';
}


items.sort(function(a, b) {
var da = a.date.split('-').reverse().join('-');
var db = b.date.split('-').reverse().join('-');
return da.localeCompare(db);
});


var firstDate = items[0].date;
var lastDate = items[items.length - 1].date;
var firstParts = firstDate.split('-');
var lastParts = lastDate.split('-');
var firstTs = new Date(+firstParts[2], +firstParts[1] - 1, +firstParts[0]).getTime();
var lastTs = new Date(+lastParts[2], +lastParts[1] - 1, +lastParts[0]).getTime();
if (lastTs - firstTs < 24 * 3600 * 1000) {
lastTs = firstTs + 30 * 24 * 3600 * 1000;
}
var span = lastTs - firstTs;


var r2v = 25400;
var maxRmb = 0;
for (var mi = 0; mi < items.length; mi++) {
var it = items[mi];
var eq = it.rmb + it.usd * 7.2 + it.vnd / r2v;
if (eq > maxRmb) maxRmb = eq;
}

var html = '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_gantt || '📈 收款进度甘特图') + '</div>' +
'<div class="gantt-container">' +
'<div class="gantt-chart">' +
'<div class="gantt-axis">';


var startMonth = new Date(firstTs);
var endMonth = new Date(lastTs);
var monthLabels = [];
var cur = new Date(startMonth.getFullYear(), startMonth.getMonth(), 1);
while (cur <= endMonth) {
monthLabels.push(cur.getFullYear() + '-' + String(cur.getMonth() + 1).padStart(2, '0'));
cur.setMonth(cur.getMonth() + 1);
}
for (var li = 0; li < monthLabels.length; li++) {
var label = monthLabels[li];
var labelParts = label.split('-');
var labelTs = new Date(+labelParts[0], +labelParts[1] - 1, 1).getTime();
var pos = ((labelTs - firstTs) / span) * 100;
html += '<span style="position:relative;left:' + pos + '%;">' + labelParts[1] + '/' + labelParts[0] + '</span>';
}

html += '</div>';


for (var ii = 0; ii < items.length; ii++) {
var item = items[ii];
var parts = item.date.split('-');
var ts = new Date(+parts[2], +parts[1] - 1, +parts[0]).getTime();
var left = ((ts - firstTs) / span) * 100;
var eq = item.rmb + item.usd * 7.2 + item.vnd / r2v;
var width = maxRmb > 0 ? Math.max(3, (eq / maxRmb) * 60) : 3;
var cls = item.type === 'actual' ? 'bar-actual' : 'bar-plan';
if (item.bg) cls = 'bar-bg';
var labelText = item.label.length > 12 ? item.label.slice(0, 11) + '…' : item.label;
var amtText = '';
if (item.rmb > 0) amtText += '¥' + item.rmb.toLocaleString();
if (item.usd > 0) amtText += (amtText ? ' ' : '') + '$' + item.usd.toLocaleString();
if (item.vnd > 0) amtText += (amtText ? ' ' : '') + '₫' + (item.vnd / 1000000).toFixed(1) + 'M';
html += '' +
'<div class="gantt-row">' +
'<span class="gantt-label" title="' + item.label + ' · ' + item.date + '">' + labelText + '</span>' +
'<span class="gantt-track">' +

function rmLangVal(p, base){
var LANG = (window.CUR_LANG||'en');
var pick = function(v){ v = (v==null?'':String(v)); return (v.trim()==='0')?'':v; };
var cur = pick(LANG==='zh' ? p[base+'_zh'] : (LANG==='vi' ? p[base+'_vi'] : p[base+'_en']));
if (cur) return cur;
return pick(p[base+'_zh']) || pick(p[base+'_en']) || pick(p[base+'_vi']) || tlPick(p[base]) || '';
}



function tlObj(v){

if (typeof v === 'string') {
var str = v.trim();
if (str.charAt(0) === '{') {
try {
var parsed = JSON.parse(str);
if (parsed && typeof parsed === 'object' && !(parsed instanceof Array)) v = parsed;
} catch (e) {}
}
}
if (v && typeof v === 'object' && !(v instanceof Array)) {
return { zh: _tlCleanZero(v.zh), en: _tlCleanZero(v.en), vi: _tlCleanZero(v.vi) };
}
var s = _tlCleanZero(v);
return { zh: s, en: '', vi: '' };
}

function tlPick(v){
var o = tlObj(v), L = (window.CUR_LANG||'en');
var cur = L==='zh' ? o.zh : (L==='vi' ? o.vi : o.en);
return cur || o.zh || o.en || o.vi || '';
}



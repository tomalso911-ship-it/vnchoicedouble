if (mwForReport && (mwForReport.start || mwForReport.end)) {
dispStart = mwForReport.start || '-';
dispEnd = mwForReport.end || '-';
}
html += '' +
'<div class="cpr-row"><span class="k">' + (t.rpt_warranty_amt || '质保金金额') + ':</span> <span class="v">' + fmtMoney(wa) + '</span></div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_warranty_period || '质保金起止') + ':</span> <span class="v">' + dispStart + ' ~ ' + dispEnd + '</span></div>';
}
html += '</div>';


html += '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_plan_sec || '💰 付款计划汇总') + '</div>' +

'<div class="cpr-row"><span class="k" style="font-weight:700;color:#2c3e50;">' + (t.rpt_contract_total || '合同总金额') + ':</span> <span class="v" style="font-weight:700;color:#2c3e50;">' + fmtMoney(contractTotal) + '</span></div>' +

'<div class="cpr-row"><span class="k">' + (t.rpt_plan_sum || '预计合计') + ':</span> <span class="v">' + fmtMoney(planSum) + '</span></div>' +

'<div class="cpr-row"><span class="k">' + (t.rpt_actual_sum || '实际合计') + ':</span> <span class="v">' + fmtMoney(actualSum) + '</span></div>' +

'<div class="cpr-row"><span class="k" style="font-weight:700;color:#c0392b;">' + (t.rpt_outstanding || '待付金额') + ':</span> <span class="v" style="font-weight:700;color:#c0392b;">' + fmtMoney(outstanding) + '</span></div>' +

'<div class="cpr-row"><span class="k">' + (t.rpt_completion || '完成率') + ':</span>' +
'<span class="v"><b style="color:' + barColor + '">' + completion + '%</b></span>' +
'</div>' +
'<div class="cpr-comp-bar"><div class="cpr-comp-fill" style="width:' + completion + '%;background:' + barColor + ';"></div></div>' +
'<div class="cpr-row" style="margin-top:6px;"><span class="k">' + (t.rpt_pay_rows || '付款行数') + ':</span> <span class="v">' + rows.length + '</span></div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_actual_pay_count || '实际付款次数') + ':</span> <span class="v"><b style="color:#27ae60;">' + actualPayCount + '</b></span></div>' +
'</div>';


html += '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_bg_sec || '🏦 银行保函汇总') + '</div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_bg_enabled || '启用保函行数') + ':</span> <span class="v">' + bgRows.length + '</span></div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_bg_amt || '保函金额合计') + ':</span> <span class="v">' + fmtMoney(bgSum) + '</span></div>';
if (bgRows.length > 0) {
var partiesSet = new Set();
for (var bi = 0; bi < bgRows.length; bi++) {
var party = (bgRows[bi].bg.party || '').trim();
if (party) partiesSet.add(_trParty(party));
}
var parties = Array.from(partiesSet);
if (parties.length) {
html += '<div class="cpr-row"><span class="k">' + (t.rpt_bg_parties || '保函涉及双方') + ':</span> <span class="v">' + parties.join(' · ') + '</span></div>';
}
}
html += _buildBgDetailHtml(bgRows, t);
html += '</div>';


html += renderPaymentDetailTable(rows, t);


html += renderGanttChart(rows, t);


html += renderCashFlowTable(rows, t);


html += '<div class="cpr-sec">';
html += '<div class="cpr-sec-title">' + (t.rpt_risk_sec || '⚠️ 风险提示') + '</div>';
if (risks.length === 0) {
html += '<div class="cpr-row"><span class="k">' + (t.rpt_no_risk || '无风险') + '</span> <span class="v" style="color:#27ae60;">✅</span></div>';
} else {
var riskLabel = (t.rpt_risk_count || '{n} 项风险').replace('{n}', risks.length);
html += '<div class="cpr-risk"><b>⚠️ ' + riskLabel + ':</b><ul style="margin:6px 0 0 18px;padding:0;">';
for (var riski = 0; riski < risks.length; riski++) {
html += '<li style="margin-bottom:3px;">' + risks[riski] + '</li>';
}
html += '</ul></div>';
}
html += '</div>';


if (data.remark) {
html += '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_remark_sec || '📌 备注 / 风险提示') + '</div>' +
'<div style="font-size:12.5px;color:#4a5568;line-height:1.7;">' + data.remark.replace(/\n/g,'<br>') + '</div>' +
'</div>';
}


try {
localStorage.setItem('cust_payment_report_data', JSON.stringify({
actualPayCount: actualPayCount,
actualSum: actualSum,
outstanding: outstanding
}));
} catch(e) {}

return html;
}



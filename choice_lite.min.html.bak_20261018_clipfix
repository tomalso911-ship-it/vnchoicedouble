}


function resetMaximized(root) {
var boxes = (root || document).querySelectorAll
? (root || document).querySelectorAll('.mmax') : [];
boxes.forEach(function(b) {
b.classList.remove('mmax');
var s = b.getAttribute('data-mmax-style');
if (s) { b.setAttribute('style', s); } else { b.removeAttribute('style'); }
b.removeAttribute('data-mmax-style');
});
}

function update() {
var anyOpen = false;
document.querySelectorAll(selectors.join(',')).forEach(function(el) {
if (isVisible(el)) {
anyOpen = true;
} else {

resetMaximized(el);
}
});

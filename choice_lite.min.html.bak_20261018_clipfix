function initStickyHScrollbars(){
var bars = [
{ scroller: document.querySelector('#view-won .won-scroll-container'), bar: document.getElementById('wonHScroll'), table: document.getElementById('wonTable') }
];
bars.forEach(function(p){
if(!p.scroller || !p.bar || !p.table) return;
var inner = p.bar.querySelector('.won-hscroll-inner');
var dragging = false, startX = 0, startScroll = 0;

function metrics(){
var max = p.scroller.scrollWidth - p.scroller.clientWidth;
var trackW = p.bar.clientWidth;
var thumbW = max > 0 ? Math.max(24, trackW * p.scroller.clientWidth / p.scroller.scrollWidth) : trackW;
var ratio = max > 0 ? p.scroller.scrollLeft / max : 0;
var left = max > 0 ? Math.max(0, (trackW - thumbW) * ratio) : 0;
return { max:max, trackW:trackW, thumbW:thumbW, left:left };
}
function renderThumb(){
var m = metrics();
inner.style.width = m.thumbW + 'px';
inner.style.left = m.left + 'px';
}

p.scroller.addEventListener('scroll', renderThumb);

inner.addEventListener('mousedown', function(e){
e.preventDefault(); e.stopPropagation();
dragging = true; startX = e.clientX; startScroll = p.scroller.scrollLeft;
document.body.style.cursor = 'grabbing';
});
document.addEventListener('mousemove', function(e){
if(!dragging) return;
var m = metrics();
var dx = e.clientX - startX;
var delta = m.max > 0 ? dx * (m.max / (m.trackW - m.thumbW)) : 0;
p.scroller.scrollLeft = startScroll + delta;
});
document.addEventListener('mouseup', function(){
if(dragging){ dragging = false; document.body.style.cursor = ''; }
});

p.bar.addEventListener('mousedown', function(e){
if(e.target === inner) return;
var m = metrics();
if(m.max <= 0) return;
var rect = p.bar.getBoundingClientRect();
var clickX = e.clientX - rect.left;
var page = p.scroller.clientWidth * 0.9;
p.scroller.scrollLeft += (clickX < m.left) ? -page : page;
});

p.bar.addEventListener('dblclick', function(e){
e.preventDefault();
p.scroller.scrollLeft = Math.max(0, p.scroller.scrollWidth - p.scroller.clientWidth);
});
renderThumb();

var _thumbRaf = null;
function _scheduleThumb(){
if (_thumbRaf) return;
if (typeof requestAnimationFrame === 'function') { _thumbRaf = requestAnimationFrame(function(){ _thumbRaf = null; renderThumb(); }); }
else { _thumbRaf = setTimeout(function(){ _thumbRaf = null; renderThumb(); }, 16); }
}
var ro = new ResizeObserver(_scheduleThumb);
ro.observe(p.table);
var mo = new MutationObserver(_scheduleThumb);
mo.observe(p.table, { childList:true, subtree:true });
});



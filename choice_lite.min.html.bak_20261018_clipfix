function userNameById(uname){
if (!uname) return '';
if (usersData && usersData.length){
var u = usersData.find(function(z){ return String(z.id)===String(uname) || String(z.login)===String(uname) || String(z.username)===String(uname); });
if (u) return u.name || u.real_name || u.login || uname;
}

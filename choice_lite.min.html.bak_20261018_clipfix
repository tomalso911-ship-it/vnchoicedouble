for(var key in ho){ if(!ho.hasOwnProperty(key)) continue;
var rec = ho[key]||{}; var od = rec.outDaily||{};
for(var d in od){ if(!od.hasOwnProperty(d)) continue;
var e = od[d]||{};
var amAllowed = (d !== today) || (hh >= 9);
var pmAllowed = (d !== today) || (hh >= 14);
if(!amAllowed && e.weatherAm){ delete e.weatherAm; cleared = true; }
if(!pmAllowed && e.weatherPm){ delete e.weatherPm; cleared = true; }
var amNeed = amAllowed && (!e.weatherAm || e.weatherAm.v!==2);
var pmNeed = pmAllowed && (!e.weatherPm || e.weatherPm.v!==2);
if(amNeed || pmNeed){
if(!need[d]) need[d] = [];
need[d].push({ e:e, am:amNeed, pm:pmNeed });
}
}
}
var days = Object.keys(need);
if(!days.length){
if(cleared){ prod_save(f); if(PROD_ACTIVE_TAB==='H') prod_renderTab('H'); }
return;
}
days.sort();
PROD_WX_AUTO_BACKFILLING_OUT = true;
prodLoadWeatherArchive(prov, days[0], days[days.length-1], function(hr){
PROD_WX_AUTO_BACKFILLING_OUT = false;
var ch = cleared;
if(hr){
days.forEach(function(d){
var am = prodWxFromHourly(hr, prodHourIdx(hr, d, '09'));
var pm = prodWxFromHourly(hr, prodHourIdx(hr, d, '14'));
(need[d]||[]).forEach(function(it){
if(it.am && am){ it.e.weatherAm = am; ch = true; }
if(it.pm && pm){ it.e.weatherPm = pm; ch = true; }
});
});
}
if(ch){ prod_save(f); if(PROD_ACTIVE_TAB==='H') prod_renderTab('H'); }
});
}


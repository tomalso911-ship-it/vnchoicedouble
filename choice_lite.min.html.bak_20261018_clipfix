var totalH = step * (n - 1);
var startY = cy - totalH / 2;
arr.forEach(function(it, i){
it.sign = sign;
it.boxCy = startY + step * i;
it.boxCx = cx + sign * (pieSafe + boxW / 2);
it.boxInnerX = cx + sign * pieSafe;
it.layout = 'col';

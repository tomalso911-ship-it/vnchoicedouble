var s = fin_parseDateText(cd.v);
if (s != null) return s;
var n = Number(cd.v);
if (isFinite(n) && fin_isDateSerial(n)) return n;
}
var st = fin_cellStyle(snap, cd) || {};
var pat = (st.n && st.n.pattern) || '';
if (fin_isDatePattern(pat)){

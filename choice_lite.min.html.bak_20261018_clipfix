function resolveApproval(id, action){
var me = (authUser && authUser.username) || '';
var note = '';
fetch('/api/approval-requests/'+id+'/resolve', {
method:'POST', headers:{'Content-Type':'application/json'},
body: JSON.stringify({ action:action, resolver:me, resolver_name:(authUser&&authUser.real_name)||me, note:note })
}).then(function(r){ return r.json(); }).then(function(d){
if (d && d.ok){
var t = T().empty || {};
showToast(action==='approve' ? (t.user_approve_result_pass||'Application approved!')
: action==='return' ? (t.appr_returned||'Returned for edit')
: (t.user_approve_result_reject||'Application rejected'));
closeApprovalDetail(); loadApprovals(); refreshPendBadge();

var req = (APPROVAL_BY_ID && APPROVAL_BY_ID[id]) || {};
if (action==='approve' && (req.persist||'persistent')==='persistent' && typeof reloadSession === 'function'){ reloadSession(true); }

if (req.block_id==='PROD-RECEIPT'){
var _pl=null; try{ _pl=JSON.parse(req.payload||'{}'); }catch(e){}
if(_pl && _pl.receiptId){
if(action==='approve'){ prodApprApplyInbound(_pl); }
else if(action==='return'){ prodApprMarkNeedEdit(_pl); }
else { prodApprMarkReturned(_pl); }
}
}
}
else showToast(d.msg || (T().toast_op_fail||'Operation failed'));
}).catch(function(){ showToast(T().toast_op_fail||'Operation failed'); });
}


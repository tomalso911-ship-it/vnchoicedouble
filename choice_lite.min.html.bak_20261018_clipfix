function lib_unzipEntries(buf){
var u8 = new Uint8Array(buf), dv = new DataView(buf);
var eocd = -1;
for(var i = u8.length - 22; i >= 0 && i >= u8.length - 22 - 65535; i--){
if(dv.getUint32(i, true) === 0x06054b50){ eocd = i; break; }
}
if(eocd < 0) return Promise.reject(new Error('not zip'));
var count = dv.getUint16(eocd + 10, true);
var cdOff = dv.getUint32(eocd + 16, true);
var entries = [], p = cdOff;
for(var e = 0; e < count; e++){
if(dv.getUint32(p, true) !== 0x02014b50) break;
var method = dv.getUint16(p + 10, true);
var compSize = dv.getUint32(p + 20, true);
var fnLen = dv.getUint16(p + 28, true);
var exLen = dv.getUint16(p + 30, true);
var cmLen = dv.getUint16(p + 32, true);
var localOff = dv.getUint32(p + 42, true);
var name = new TextDecoder('utf-8').decode(u8.subarray(p + 46, p + 46 + fnLen));
entries.push({ name: name, method: method, compSize: compSize, localOff: localOff });
p += 46 + fnLen + exLen + cmLen;
}
var jobs = entries.map(function(en){
var lo = en.localOff;
var lfnLen = dv.getUint16(lo + 26, true);
var lexLen = dv.getUint16(lo + 28, true);
var start = lo + 30 + lfnLen + lexLen;
var comp = u8.subarray(start, start + en.compSize);
if(en.method === 0) return Promise.resolve({ name: en.name, data: comp });
try{
var ds = new DecompressionStream('deflate-raw');
var stream = new Blob([comp]).stream().pipeThrough(ds);
return new Response(stream).arrayBuffer().then(function(ab){ return { name: en.name, data: new Uint8Array(ab) }; });
}catch(err){ return Promise.reject(err); }
});
return Promise.all(jobs);
}
function lib_viewPptx(url, body){
if(typeof DecompressionStream === 'undefined'){ lib_viewFail(body); return; }
body.innerHTML = '<div class="libview-loading">' + lt('lib_previewing') + '</div>';
fetch(url).then(function(r){ return r.arrayBuffer(); })
.then(function(buf){ return lib_unzipEntries(buf); })
.then(function(entries){
var slides = entries.filter(function(e){ return /^ppt\/slides\/slide\d+\.xml$/.test(e.name); });
slides.sort(function(a, b){
return (parseInt((a.name.match(/(\d+)/) || [0, 0])[1], 10)) - (parseInt((b.name.match(/(\d+)/) || [0, 0])[1], 10));
});
if(!slides.length){ lib_viewFail(body); return; }
var dec = new TextDecoder('utf-8'), html = '';
slides.forEach(function(s, i){
var xml = dec.decode(s.data);
var texts = [], re = /<a:t[^>]*>([\s\S]*?)<\/a:t>/g, m;
while((m = re.exec(xml))){ texts.push(m[1]); }
html += '<div class="libview-slide"><h4>' + lt('lib_slide') + ' ' + (i + 1) + '</h4>';
if(texts.length){ html += '<ul>'; texts.forEach(function(t){ html += '<li>' + esc(t) + '</li>'; }); html += '</ul>'; }
else { html += '<div class="ls-none">—</div>'; }
html += '</div>';
});
body.innerHTML = html;
})
.catch(function(){ lib_viewFail(body); });
}


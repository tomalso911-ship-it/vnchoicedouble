function lib_viewOfficePdf(id, ext, raw, body){
var pdfUrl = '/api/library/files/' + id + '/pdfview';
function fallback(){
if(ext === 'docx') lib_viewDocx(raw, body);
else if(['xlsx','xls','xlsm','csv'].indexOf(ext) >= 0) lib_viewXlsx(raw, body);
else if(['pptx','pptm'].indexOf(ext) >= 0) lib_viewPptx(raw, body);
else lib_viewFail(body);
}
var ac = (typeof AbortController !== 'undefined') ? new AbortController() : null;
var timer = setTimeout(function(){ if(ac) try { ac.abort(); } catch(e){} }, 150000);
fetch(pdfUrl + '?check=1', ac ? { signal: ac.signal } : undefined)
.then(function(r){ return r.json().catch(function(){ return { ok: false }; }); })
.then(function(j){
clearTimeout(timer);
if(j && j.ok){ body.innerHTML = '<iframe class="libview-frame" src="' + lib_attr(pdfUrl) + '"></iframe>'; }
else { fallback(); }
})
.catch(function(){ clearTimeout(timer); fallback(); });
}


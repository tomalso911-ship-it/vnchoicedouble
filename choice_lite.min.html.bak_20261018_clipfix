function fmtThousands(v){ v=Math.round(Number(v)||0); var s=String(v); var neg=(s.charAt(0)==='-'); if(neg) s=s.slice(1); return (neg?'-':'') + s.replace(/\B(?=(\d{3})+(?!\d))/g, ','); }

function syncDashCrmCharts(){


var _anyOvOpen = ['crmOverviewModal','overviewModal','lostOverviewModal'].some(function(id){
var m = document.getElementById(id);
return m && (m.classList.contains('show') || (m.style.display && m.style.display !== 'none'));

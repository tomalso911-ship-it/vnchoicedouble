var minY = Math.min.apply(null, allY);
var maxLabelHeight = fs + 3;
var tooClose = false;
for(var i=0;i<items.length;i++){
for(var j=i+1;j<items.length;j++){
if(Math.abs(items[i].bar.y - items[j].bar.y) < maxLabelHeight){
tooClose = true;
break;
}
}
if(tooClose) break;
}
hasOverlap = tooClose;
}

items.forEach(function(info){

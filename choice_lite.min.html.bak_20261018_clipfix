function _anaAggregate(collected, keyOf, nameOf){
var cur = _repCur.toLowerCase();
var map = {};
function g(key, name){
if (!map[key]) map[key] = { key: key, label: name, need: 0, paid: 0, times: 0, projects: {} };
return map[key];
}
var rateCache = {};
collected.forEach(function(it, i){
var rec = it.rec, ck = rec.contract || ('#' + i);
if (!rateCache[ck]) rateCache[ck] = [parseMoney(rec.rateRMB) || 3800, parseMoney(rec.rateUSD) || 26000];
var k = keyOf(it), o = g(k, nameOf(it));
(it.ben.payments || []).forEach(function(p){
var c3 = _commRowThreeCur(p, rateCache[ck][0], rateCache[ck][1]);
o.need += c3[cur];
if (String(p.finished || '') === '结束') o.paid += c3[cur];
o.times++;
o.projects[rec.contract] = 1;
});
if (!(it.ben.payments && it.ben.payments.length)){
o.need += parseFloat(it.ben['total' + _repCur]) || 0;
o.projects[rec.contract] = 1;
}
});
var arr = [];
for (var k in map){
var o = map[k];
o.unpaid = o.need - o.paid;
o.projCount = Object.keys(o.projects).length;
arr.push(o);
}
arr.sort(function(a, b){ return b.need - a.need; });
return arr;
}

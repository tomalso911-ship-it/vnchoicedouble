function prod_dailyDraftFor(dmy){
var key = prod_dmy(dmy);
var f = prod_get(PROD_CUR);
var rec = (f.production && f.production[key]) ? f.production[key] : null;

var recAm = (rec && rec.weatherAm && rec.weatherAm.v===2) ? rec.weatherAm : null;
var recPm = (rec && rec.weatherPm && rec.weatherPm.v===2) ? rec.weatherPm : null;

var d = { _cur: PROD_CUR, date: key, _saved: !!rec, holiday:(rec&&rec.holiday)?rec.holiday:'no', recorder: prod_loginUser(), weatherAm: recAm, weatherPm: recPm, lines:{} };
var wrec = (f.workers && f.workers[key]) || null;
if(wrec){
if(!d.weatherAm && wrec.weatherAm && wrec.weatherAm.v===2) d.weatherAm = wrec.weatherAm;
if(!d.weatherPm && wrec.weatherPm && wrec.weatherPm.v===2) d.weatherPm = wrec.weatherPm;
}
if(rec && rec.lines){ for(var k in rec.lines){ if(!rec.lines.hasOwnProperty(k)) continue; var src=rec.lines[k]; var nl={houses:src.houses?src.houses.slice():[], qty:{}, qtyDetail:{}};
if(src.qtyDetail){
for(var s in src.qtyDetail){ if(!src.qtyDetail.hasOwnProperty(s)) continue; nl.qtyDetail[s]={}; var sd=src.qtyDetail[s]; for(var h in sd){ if(sd.hasOwnProperty(h)) nl.qtyDetail[s][h]=+sd[h]||0; } nl.qty[s]=0; }
}
if(src.qty){ for(var s in src.qty){ nl.qty[s]=+src.qty[s]||0; if(!nl.qtyDetail[s]) nl.qtyDetail[s]={}; } }
else if(src.matrix){ for(var hh in src.matrix){ for(var s in src.matrix[hh]){ nl.qty[s]=(nl.qty[s]||0)+(+src.matrix[hh][s]||0); if(!nl.qtyDetail[s]) nl.qtyDetail[s]={}; nl.qtyDetail[s][hh]=(+src.matrix[hh][s]||0); } if(!nl.houses.length){ nl.houses=Object.keys(src.matrix); } } }
for(var s in nl.qty){ if(nl.qty[s]!=null) prod_dailyEnsureQtyDetail(nl, s); }
for(var s in nl.qtyDetail){ prod_dailySyncQtyTotal(nl, s); }
d.lines[k]=nl;
} }
return d;
}

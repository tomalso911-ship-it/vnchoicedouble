case 'fromHouse': va=String(a.h||''); vb=String(b.h||''); break;
case 'spec': va=(a.k||'').toLowerCase(); vb=(b.k||'').toLowerCase(); break;
case 'toHouse':
va=String(a.destHouse||a.h||'')+' '+((a.destBuildings||[]).join(','));
vb=String(b.destHouse||b.h||'')+' '+((b.destBuildings||[]).join(','));

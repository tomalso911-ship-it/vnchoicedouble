function prod_sortLabor(th){
var table = th.closest('table');
if(!table) return;
var idx = th.cellIndex;
var tbody = table.querySelector('tbody');
if(!tbody) return;
var rows = Array.prototype.slice.call(tbody.rows);
if(!rows.length) return;
if(PROD_LABOR_SORT.col !== idx){ PROD_LABOR_SORT.col = idx; PROD_LABOR_SORT.dir = 1; }
else { PROD_LABOR_SORT.dir = PROD_LABOR_SORT.dir===1 ? -1 : (PROD_LABOR_SORT.dir===-1 ? 0 : 1); }
var dir = PROD_LABOR_SORT.dir;
var cls = ' ' + th.className + ' ';
var type = cls.indexOf(' pc-col-date ')>=0 ? 'date' : (cls.indexOf(' pc-col-role ')>=0 || cls.indexOf(' pc-col-total ')>=0 ? 'num' : 'text');
rows.sort(function(a,b){
if(dir===0){
var ao = parseInt(a.getAttribute('data-orig-idx')||0,10);
var bo = parseInt(b.getAttribute('data-orig-idx')||0,10);
return ao - bo;
}
var ac = a.cells[idx], bc = b.cells[idx];
var av = ac ? (ac.getAttribute('data-sort-val') || ac.innerText || ac.textContent || '') : '';
var bv = bc ? (bc.getAttribute('data-sort-val') || bc.innerText || bc.textContent || '') : '';
av = av.trim(); bv = bv.trim();
if(type==='date'){ av = dmyToYmd(av); bv = dmyToYmd(bv); }
else if(type==='num'){ av = parseFloat(av)||0; bv = parseFloat(bv)||0; }
if(av===bv) return 0;
var r = type==='text' ? String(av).localeCompare(String(bv)) : (av>bv?1:-1);
return dir===1 ? r : -r;
});
for(var i=0;i<rows.length;i++){ tbody.appendChild(rows[i]); }
prod_updateLaborSortInd(table, idx, dir);
}

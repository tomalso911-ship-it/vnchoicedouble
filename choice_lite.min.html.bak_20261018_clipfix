}
var lang = CUR_LANG || 'zh';


var planSum = { rmb: 0, usd: 0, vnd: 0 };
var actualSum = { rmb: 0, usd: 0, vnd: 0 };
var bgRows = [];
var bgSum = { rmb: 0, usd: 0, vnd: 0 };

for (var ri = 0; ri < rows.length; ri++) {
var r = rows[ri];
planSum.rmb += (r.plan ? r.plan.rmb : 0);
planSum.usd += (r.plan ? r.plan.usd : 0);
planSum.vnd += (r.plan ? r.plan.vnd : 0);
actualSum.rmb += (r.actual ? r.actual.rmb : 0);
actualSum.usd += (r.actual ? r.actual.usd : 0);
actualSum.vnd += (r.actual ? r.actual.vnd : 0);
if (r.bg && r.bg.has === 'yes') {
bgRows.push(r);
bgSum.rmb += (r.bg.amt && r.bg.amt.rmb) || 0;
bgSum.usd += (r.bg.amt && r.bg.amt.usd) || 0;
bgSum.vnd += (r.bg.amt && r.bg.amt.vnd) || 0;
}
}


var actualPayCount = 0;
for (var ai = 0; ai < rows.length; ai++) {
if (_hasActual(rows[ai])) actualPayCount++;
}


var contractTotal = { rmb: 0, usd: 0, vnd: 0 };
var rmbEl = document.getElementById('w_total_ei_rmb');
var usdEl = document.getElementById('w_total_ei_usd');
var vndEl = document.getElementById('w_total_ei_vnd');
if (rmbEl) contractTotal.rmb = stripToNumber(rmbEl.value) || 0;
if (usdEl) contractTotal.usd = stripToNumber(usdEl.value) || 0;
if (vndEl) contractTotal.vnd = stripToNumber(vndEl.value) || 0;


if (contractTotal.rmb === 0 && contractTotal.usd === 0 && contractTotal.vnd === 0 && wonData) {
contractTotal.rmb = wonData.total_ei_rmb || 0;
contractTotal.usd = wonData.total_ei_usd || 0;
contractTotal.vnd = wonData.total_ei_vnd || 0;
}


var outstanding = {
rmb: Math.max(0, contractTotal.rmb - actualSum.rmb),
usd: Math.max(0, contractTotal.usd - actualSum.usd),
vnd: Math.max(0, contractTotal.vnd - actualSum.vnd)
};


var completion = contractTotal.rmb > 0 ? Math.round(actualSum.rmb / contractTotal.rmb * 100) : 0;


var fmtN = function(n) { return (n||0).toLocaleString('en-US'); };
var fmtMoney = function(o) { return '<span style="margin-left:4px;">¥' + fmtN(o.rmb) + '</span> | <span>$' + fmtN(o.usd) + '</span> | <span>₫' + fmtN(o.vnd) + '</span>'; };

function rpt_faultStats(f){
var faults=((f.equipment&&f.equipment.faults)||[]).slice();
var down=0, incomplete=0, byEq={};
faults.forEach(function(r){
if(!r) return;
var dn=parseFloat(r.down); if(!isNaN(dn)&&dn>0) down+=dn; else if(String(r.down||'').trim()==='') incomplete++;
var eq=String(r.equip||'').trim(); if(eq){ byEq[eq]=(byEq[eq]||0)+1; }
});
var top=Object.keys(byEq).map(function(k){return {eq:k,cnt:byEq[k]};}).sort(function(a,b){return b.cnt-a.cnt;}).slice(0,3);
return {total:faults.length, down:down, incomplete:incomplete, top:top};
}


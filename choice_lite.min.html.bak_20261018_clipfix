function bdProjToSeg(px, py, ax, ay, bx, by) {
var dx = bx - ax, dy = by - ay, len2 = dx*dx + dy*dy;
if (len2 === 0) return [ax, ay];
var t = ((px-ax)*dx + (py-ay)*dy) / len2;
t = t < 0 ? 0 : (t > 1 ? 1 : t);
return [ax + t*dx, ay + t*dy];
}

function bdNearestBorder(cp, feats) {
if (!cp || !feats || !feats.length) return [cp[0], cp[1]];
var best = { d: Infinity, x: cp[0], y: cp[1] };
function consider(rings) {
if (!rings) return;
rings.forEach(function(ring) {
for (var i = 0; i < ring.length - 1; i++) {
var a = ring[i], b = ring[i+1];
var proj = bdProjToSeg(cp[0], cp[1], a[0], a[1], b[0], b[1]);
var dx = proj[0] - cp[0], dy = proj[1] - cp[1];
var d = Math.sqrt(dx*dx + dy*dy);
if (d < best.d) { best.d = d; best.x = proj[0]; best.y = proj[1]; }
}
});
}
feats.forEach(function(f) {
var g = f.geometry;
if (!g) return;
if (g.type === 'Polygon') consider(g.coordinates);
else if (g.type === 'MultiPolygon') g.coordinates.forEach(consider);
});
return [best.x, best.y];
}

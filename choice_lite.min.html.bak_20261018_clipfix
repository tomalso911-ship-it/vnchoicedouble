function loadJspdfThenExportLostOv(body, t) {
var doIt = function() {
var pdfClass = (typeof jsPDF !== 'undefined') ? jsPDF : (window.jspdf && window.jspdf.jsPDF);
if (!pdfClass) { showAlert(t.crm_ov_pdf_failed || 'PDF导出失败'); return; }


var origMH = body.style.maxHeight;
var origOV = body.style.overflow;
var origOVY = body.style.overflowY;
body.style.maxHeight = 'none';
body.style.overflow = 'visible';
body.style.overflowY = 'visible';

html2canvas(body, { scale: 2, useCORS: true, backgroundColor: '#fff', scrollY: 0, windowHeight: body.scrollHeight }).then(function(canvas) {

body.style.maxHeight = origMH;
body.style.overflow = origOV;
body.style.overflowY = origOVY;
var imgData = canvas.toDataURL('image/png');
var pageW = 210, pageH = 297;
var availH = pageH - 20, availW = pageW - 20;
var ratio = Math.min(availW / (canvas.width / 2), availH / (canvas.height / 2));
var scaledW = canvas.width * ratio / 2, scaledH = canvas.height * ratio / 2;
var pdf = new pdfClass({ orientation: 'portrait', unit: 'mm', format: 'a4' });
var pageCount = Math.max(1, Math.ceil(scaledH / availH));
for (var i = 0; i < pageCount; i++) {
if (i > 0) pdf.addPage();
pdf.addImage(imgData, 'PNG', 10, -i * availH, scaledW, scaledH);
}
pdf.save('lost_overview_' + new Date().toISOString().slice(0, 10) + '.pdf');
showAlert(t.crm_ov_pdf_ok || '导出成功');
}).catch(function() {

body.style.maxHeight = origMH;
body.style.overflow = origOV;
body.style.overflowY = origOVY;
});
};
if (typeof jsPDF !== 'undefined' || window.jspdf) { doIt(); return; }
var s = document.createElement('script');
s.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
s.onload = doIt;
document.head.appendChild(s);
}



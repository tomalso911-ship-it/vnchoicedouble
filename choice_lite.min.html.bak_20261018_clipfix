function inst_totalPcs(f){
var saved = (typeof PROD_CUR!=='undefined') ? PROD_CUR : undefined;
var total = 0;
try {
if(typeof PROD_CUR!=='undefined') PROD_CUR = INST_CUR;
var mm = (typeof prod_slatsMatrix==='function') ? prod_slatsMatrix() : {specs:{}};
for(var k in mm.specs){ total += (+mm.specs[k].total||0); }
} finally { if(typeof PROD_CUR!=='undefined') PROD_CUR = saved; }
return total;
}


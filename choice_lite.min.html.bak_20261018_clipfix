var r = nodes[i].getBoundingClientRect();
if(r.left < l + w && r.right > l && r.top < t + h && r.bottom > t){
var k = String(nodes[i].getAttribute('data-id'));
if(keys.indexOf(k) < 0) keys.push(k);
}

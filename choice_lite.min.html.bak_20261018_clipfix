let usersSortState = { field: null, dir: 'asc' };
let usersOriginalOrder = [];

function _sortKeyForUser(u, field){
let v = (u[field] || '');
if (field === 'position') v = posLabelLocalized(v) || v;
return String(v).trim().toLowerCase();
}
function applyUsersSort(){
if (!usersSortState.field) {
usersData = usersOriginalOrder.slice();
return;
}
const f = usersSortState.field;
const dir = usersSortState.dir;
usersData = usersData.slice().sort((a,b)=>{
const av = _sortKeyForUser(a, f);
const bv = _sortKeyForUser(b, f);
if (av === bv) return a.id - b.id;
return (av > bv ? 1 : -1) * (dir === 'asc' ? 1 : -1);
});
}
function updateUsersSortIcons(){
document.querySelectorAll('#usersThead th.sortable').forEach(th=>{
const field = th.dataset.sort;
let icon = '↕';
if (usersSortState.field === field){
icon = usersSortState.dir === 'asc' ? '▲' : '▼';
th.classList.add('active-sort');
} else {
th.classList.remove('active-sort');
}

const existing = th.querySelector('.sort-icon');
if (existing) existing.textContent = icon;
else {
const span = document.createElement('span');
span.className = 'sort-icon';
span.style.fontSize = '0.75em';
span.style.marginLeft = '6px';
span.style.opacity = '0.9';
span.textContent = icon;
th.appendChild(span);
}
});
}
function attachUsersSortHandlers(){
document.querySelectorAll('#usersThead th.sortable').forEach(th=>{
const field = th.dataset.sort;
if (!th.dataset.sortBound){
th.addEventListener('click', function(){ onUsersSortClick(field); });
th.dataset.sortBound = '1';
}
});
}
function onUsersSortClick(field){
if (usersSortState.field === field){
if (usersSortState.dir === 'asc') usersSortState.dir = 'desc';
else { usersSortState.field = null; usersSortState.dir = 'asc'; }
} else {
usersSortState.field = field;
usersSortState.dir = 'asc';
}
applyUsersSort();
renderUsers();
updateUsersSortIcons();
}



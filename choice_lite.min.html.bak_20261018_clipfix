}
}
});

cloneOptions.plugins.ovDataLabels = Object.assign({}, cloneOptions.plugins.ovDataLabels, { fontSize: 15 });
})();
window._dashLightboxChart = new Chart(ctx, {
type: srcChart.config.type,
data: cloneData,
options: cloneOptions
});
var container = document.querySelector('#dashChartLightbox .dash-chart-lightbox-body');
if (container) {
var canvas = document.getElementById('dashChartLightboxCanvas');
canvas.style.width = container.clientWidth + 'px';
canvas.style.height = container.clientHeight + 'px';
}

(function(){
if (!cloneData || !cloneData.labels || cloneData.labels.length < 4) return;
var lb = window._dashLightboxChart;
var N = cloneData.labels.length;
var view = { i0: 0, i1: N - 1 };
var full = { labels: cloneData.labels };
var fullSets = cloneData.datasets.map(function(d){ return (d.data || []).slice(); });
var hint = (CUR_LANG === 'en') ? ' (wheel: zoom, drag: pan, dblclick: reset)'
: (CUR_LANG === 'vi') ? ' (lăn chuột: thu phóng, kéo: di chuyển, nhấn đúp: đặt lại)'
: '（滚轮缩放 · 拖拽平移 · 双击复位）';
headTitle.innerText = title + hint;

function apply() {
var i0 = Math.max(0, Math.round(view.i0));
var i1 = Math.min(N - 1, Math.round(view.i1));
if (i1 - i0 < 2) return;
lb.data.labels = full.labels.slice(i0, i1 + 1);
lb.data.datasets.forEach(function(d, k){
d.data = fullSets[k].slice(i0, i1 + 1);
});
lb.update('none');
}
function xToIndex(e) {
var rect = lb.canvas.getBoundingClientRect();
var x = (e.clientX - rect.left) / rect.width;
return Math.min(1, Math.max(0, x));
}
canvas = document.getElementById('dashChartLightboxCanvas');

canvas.onwheel = function(e){
e.preventDefault();
var f = e.deltaY < 0 ? 0.82 : 1.22;
var cx = xToIndex(e);
var span = view.i1 - view.i0;
var nspan = Math.min(N - 1, Math.max(2, span * f));
var center = view.i0 + span * cx;
view.i0 = center - nspan * cx;
view.i1 = view.i0 + nspan;
if (view.i0 < 0) { view.i0 = 0; view.i1 = nspan; }
if (view.i1 > N - 1) { view.i1 = N - 1; view.i0 = N - 1 - nspan; }
apply();
};

var drag = null;
canvas.onmousedown = function(e){ drag = { x: e.clientX, i0: view.i0, i1: view.i1 }; };
window.addEventListener('mousemove', function(e){
if (!drag) return;
var rect = lb.canvas.getBoundingClientRect();
var span = drag.i1 - drag.i0;
var dx = (e.clientX - drag.x) / rect.width * span;
var i0 = drag.i0 - dx;
if (i0 < 0) i0 = 0;
if (i0 + span > N - 1) i0 = N - 1 - span;
view.i0 = i0; view.i1 = i0 + span;
apply();
});
window.addEventListener('mouseup', function(){ drag = null; });

canvas.ondblclick = function(){ view.i0 = 0; view.i1 = N - 1; apply(); };

overlay.addEventListener('transitionend', function(){
if (!overlay.classList.contains('show')) {
canvas.onwheel = canvas.onmousedown = canvas.ondblclick = null;
drag = null;
}
});
})();


function prod_mergeKeepLocal(local, server){
if(local==null) return server;
if(server==null) return local;
if(Array.isArray(local)||Array.isArray(server)){

var la=Array.isArray(local)?local:[], sa=Array.isArray(server)?server:[];
var len=Math.max(la.length, sa.length), res=[];
for(var i=0;i<len;i++){ res[i]=prod_mergeKeepLocal(la[i], sa[i]); }
return res;
}
if(typeof local!=='object'){ return (local!==''&&local!=null)?local:server; }
var o=JSON.parse(JSON.stringify(server));
for(var k in local){ if(!local.hasOwnProperty(k)) continue;
if(!(k in o)||o[k]==null||o[k]==='') o[k]=local[k];
else o[k]=prod_mergeKeepLocal(local[k], o[k]);
}

if(o && typeof o==='object' && o.outDaily && typeof o.outDaily==='object'){
var sum=0;
for(var dk in o.outDaily){ if(!o.outDaily.hasOwnProperty(dk)) continue;
var v=o.outDaily[dk];
sum += (v && typeof v==='object' ? (v.qty||0) : (parseFloat(v)||0));
}
o.out = sum;
}
return o;
}

function prod_mergeFactory(localF, serverF){
if(!localF || typeof localF!=='object') return serverF;
if(!serverF || typeof serverF!=='object') return localF;
var out = JSON.parse(JSON.stringify(serverF));

function mergeArr(localArr, serverArr, keyFn){
if(!Array.isArray(localArr)) localArr=[]; if(!Array.isArray(serverArr)) serverArr=[];
var map={}; serverArr.forEach(function(x){ try{ map[String(keyFn(x))]=x; }catch(e){} });
localArr.forEach(function(x){ try{ var k=String(keyFn(x)); if(!map[k]){ serverArr.push(x); map[k]=x; } }catch(e){} });
return serverArr;
}
out.materials = out.materials || {};
var lm = localF.materials || {};


var _delIds = {};
((out.materials.receiptsDeleted)||[]).forEach(function(id){ _delIds[id]=1; });
((lm.receiptsDeleted)||[]).forEach(function(id){ _delIds[id]=1;
if(!Array.isArray(out.materials.receiptsDeleted)) out.materials.receiptsDeleted=[];
if(out.materials.receiptsDeleted.indexOf(id)<0){ out.materials.receiptsDeleted.push(id); }
});
var _mergedReceipts = mergeArr(lm.receipts, out.materials.receipts, function(r){ return r.id; });
out.materials.receipts = _mergedReceipts.filter(function(r){ return r && !_delIds[r.id]; });

out.materials.inbound = mergeArr(lm.inbound, out.materials.inbound, function(x){ return JSON.stringify(x); });
out.materials.outbound = mergeArr(lm.outbound, out.materials.outbound, function(x){ return JSON.stringify(x); });
out.materials.items = mergeArr(lm.items, out.materials.items, function(x){ return JSON.stringify(x); });

out.equipment = out.equipment || {}; var leq = localF.equipment || {};
out.equipment.list = mergeArr(leq.list, out.equipment.list, function(x){ return JSON.stringify(x); });
out.equipment.faults = mergeArr(leq.faults, out.equipment.faults, function(x){ return JSON.stringify(x); });
out.delivery = mergeArr(localF.delivery, out.delivery, function(x){ return JSON.stringify(x); });


if(localF.profile && typeof localF.profile==='object'){
out.profile = out.profile || {};
for(var pk in localF.profile){
var lv = localF.profile[pk], sv = out.profile[pk];
if(!(pk in out.profile) || (lv && !sv)){ out.profile[pk] = lv; }
}
}
if(localF.plan && !out.plan) out.plan = localF.plan;

['installation','finished','houseOut','inventoryPlan','prepStart','prepEnd','planStart','__zonePhotos_kv','__prodPhotos_kv'].forEach(function(k){
if(localF[k]!=null) out[k]=prod_mergeKeepLocal(localF[k], out[k]);
});

['production','workers'].forEach(function(k){
var delKey = (k==='production') ? 'productionDeleted' : 'workersDeleted';
function mergeDateMap(baseM, otherM, tomb){
var res = (baseM && typeof baseM==='object') ? JSON.parse(JSON.stringify(baseM)) : {};
var om = (otherM && typeof otherM==='object') ? otherM : {};
for(var dk in om){ if(!om.hasOwnProperty(dk)) continue;
if(!(dk in res) || res[dk]==null) res[dk]=om[dk];
}
if(tomb){ for(var tk in tomb){ if(tomb.hasOwnProperty(tk) && tomb[tk]) delete res[tk]; } }
return res;
}
var tomb = {};
[localF, serverF].forEach(function(side){
var t = (side && side[delKey]) || {};
for(var dk in t){ if(t.hasOwnProperty(dk) && t[dk]) tomb[dk]=1; }
});
var mergedMap = mergeDateMap(out[k], localF[k], tomb);
if(Object.keys(mergedMap).length || out[k] || localF[k]) out[k] = mergedMap;
if(Object.keys(tomb).length) out[delKey] = tomb;
});
return prod_normalizeDates(out);
}



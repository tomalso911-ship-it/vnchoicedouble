} else if(isMoney) {
if (useFull) {

var decimals = (dataset.ovPrecision !== undefined) ? dataset.ovPrecision : (useDecimals ? 2 : 0);
var numStr = (decimals > 0) ? v.toFixed(decimals) : _ovFmt(Math.round(v), 0);

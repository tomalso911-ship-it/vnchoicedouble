function prodPieLabelPlugin(sym, total, labels){
return { id:'prodPieLabels', afterDraw:function(chart){
var ctx=chart.ctx, meta=chart.getDatasetMeta(0); if(!meta.data.length) return;
var cx=chart.chartArea.left+chart.chartArea.width/2, cy=chart.chartArea.top+chart.chartArea.height/2;
var r=Math.min(chart.chartArea.width, chart.chartArea.height)/2; if(r<=0) return;
var outer=r*1.22; ctx.save();
meta.data.forEach(function(arc,i){
var val=chart.data.datasets[0].data[i]; if(!val) return;
var mid=(arc.startAngle+arc.endAngle)/2, pct=val/total;
var lx=cx+Math.cos(mid)*r*0.78, ly=cy+Math.sin(mid)*r*0.78;
if(pct>=0.03){ ctx.fillStyle='#fff'; ctx.font='bold 12px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.fillText((pct*100).toFixed(0)+'%', lx, ly); }
var ex=cx+Math.cos(mid)*outer, ey=cy+Math.sin(mid)*outer;
ctx.strokeStyle='#bbb'; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(cx+Math.cos(mid)*(r+4), cy+Math.sin(mid)*(r+4)); ctx.lineTo(ex, ey); ctx.stroke();
var dx=Math.cos(mid)>=0?5:-5;
ctx.fillStyle='#333'; ctx.font='bold 11px sans-serif'; ctx.textAlign=Math.cos(mid)>=0?'left':'right'; ctx.textBaseline='middle';
ctx.fillText(labels[i]||'', ex+dx, ey-7);
ctx.fillStyle='#666'; ctx.font='10px sans-serif';
ctx.fillText(sym+Math.round(val).toLocaleString('en-US'), ex+dx, ey+7);
});
ctx.restore();
}};
}

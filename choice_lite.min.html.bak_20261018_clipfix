var firstDate = null, firstYmd = '';
faults.forEach(function(r){ var d = parseYmd(r.date); if(d){ if(!firstDate || d < firstDate){ firstDate = d; firstYmd = r.date; } } });
var today = parseYmd(prod_today());
var days = 1;
if(firstDate && today){ days = Math.round((today - firstDate)/86400000) + 1; if(days < 1) days = 1; }
var totalCount = faults.length;
var totalDown = faults.reduce(function(a,r){ return a + (parseFloat(String(r.down||'').trim())||0); }, 0);
var avgPerDay = totalCount / days;
var avgDownPerDay = totalDown / days;
var dailyLoss = Math.round(avgDownPerDay * 50);

var freqMap = {};
faults.forEach(function(r){ if(r.idx!=null) freqMap[r.idx] = (freqMap[r.idx]||0)+1; });
var topIdx = null, topCnt = 0;
Object.keys(freqMap).forEach(function(k){ if(freqMap[k] > topCnt){ topCnt = freqMap[k]; topIdx = k; } });
var topName = '';
if(topIdx!=null){ var cat = prod_equipItem(+topIdx) || {zh:''}; topName = prod_equipName(cat); }
var txt = eqc('eq_summary_tpl')
.replace('{date}', ymdToDmy(firstYmd))
.replace('{days}', days)
.replace('{count}', totalCount)
.replace('{hours}', totalDown.toFixed(2))
.replace('{avg}', avgPerDay.toFixed(2))
.replace('{ah}', avgDownPerDay.toFixed(2))
.replace('{loss}', dailyLoss)
.replace('{dev}', topName)
.replace('{cnt}', topCnt);
return '<div class="prod-eq-summary-wrap"><div class="prod-eq-summary-head">'+eqc('eq_summary_head')+'</div>'
+ '<div class="prod-eq-summary">'+prod_esc(txt)+'</div></div>';
}


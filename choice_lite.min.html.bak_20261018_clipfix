_syncAttempts++;
var chartPairs = [

{ from: 'crmOvProvChart', to: 'dashCrmProvChart' },
{ from: 'crmOvBuChart', to: 'dashCrmBuChart' },
{ from: 'crmOvConChart', to: 'dashCrmConstChart' },

function renderFullReport(data, wonData, t, type) {
var rows = data.rows || [];
var hasWarranty = data.hasWarranty === 'yes';
var wa = data.warrantyAmount || { rmb: 0, usd: 0, vnd: 0 };

if (type === 'cust') {
var mwReport = getMainWarrantyState();
if (mwReport) {
hasWarranty = mwReport.has === 'yes';
wa = { rmb: mwReport.rmb, usd: mwReport.usd, vnd: mwReport.vnd };

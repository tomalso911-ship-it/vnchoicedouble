function lib_postUpload(items){
if(!items || !items.length) return;
if(!lib_canEdit()){ showToast(lt('lib_forbidden_op')); return; }
var url = '/api/library/upload' + (LIB_PROJECT_ID ? '?project_id=' + LIB_PROJECT_ID : '');
var headers = {'X-User-Name': (typeof authUser!=='undefined' && authUser && authUser.username) ? authUser.username : ''};
var total = items.length, okCount = 0, doneCount = 0;

function doFetch(fd, cb){
fetch(url, { method: 'POST', headers: headers, body: fd })
.then(function(r){ return r.json().catch(function(){ return { ok: false }; }); })
.then(function(res){ cb(!!(res && res.ok)); })
.catch(function(){ cb(false); });
}

function targetPath(rel){ return lib_joinPath(LIB_CWD, rel); }

function sendBatch(batch, stream, cb){
var fd = new FormData();
if(stream){
for(var i=0;i<batch.length;i++){
try { fd.append('file', batch[i].file); fd.append('paths', targetPath(batch[i].path || batch[i].file.name)); } catch(e){}
}
doFetch(fd, cb);
return;
}
var idx = 0, added = 0;
(function step(){
if(idx >= batch.length){ if(!added){ cb(false); return; } doFetch(fd, cb); return; }
var it = batch[idx++];
lib_readAsArrayBuffer(it.file, function(ab){
var blob = lib_blobOf(it, ab);
if(blob){
try { fd.append('file', blob, it.file.name); fd.append('paths', targetPath(it.path || it.file.name)); added++; } catch(e){}
}
step();
}, function(){ step(); });
})();
}

var queue = [{ batch: items, stream: true }], inflight = false;
function pump(){
if(inflight) return;
var task = queue.shift();
if(!task){
lib_loadFiles();
showToast(lt('lib_upload_done').replace('{ok}', okCount).replace('{total}', total));
return;
}
inflight = true;
sendBatch(task.batch, task.stream, function(ok){
inflight = false;
if(ok){
okCount += task.batch.length; doneCount += task.batch.length;
showToast(lt('lib_uploading') + ' ' + doneCount + '/' + total);
pump();
return;
}
if(task.batch.length === 1){
if(task.stream){ queue.unshift({ batch: task.batch, stream: false }); }
else { doneCount += 1; }
pump();
return;
}
var mid = Math.ceil(task.batch.length / 2);
queue.unshift({ batch: task.batch.slice(mid), stream: task.stream });
queue.unshift({ batch: task.batch.slice(0, mid), stream: task.stream });
pump();
});
}
pump();
}


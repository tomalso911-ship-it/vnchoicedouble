function inst_anaKey(t){
var s = (t==null?'':String(t)).trim(); if(!s) return '';
var p = s.split('#'); return (p[0]||'')+'#'+(p[1]||'1');
}


function inst_anaResolveKey(p, H){
if(p && p.key) return inst_anaKey(p.key);
if(!p || !H || !H.length) return '';
var nm = String(p.name || '');
for(var i=0;i<H.length;i++){ if(String(H[i].name) === nm) return inst_anaKey(H[i].key); }
var m = /#\s*([^#\s]+)\s*$/.exec(nm);
if(m && p.zoneKey !== undefined && p.zoneKey !== null){
for(var j=0;j<H.length;j++){
if(String(H[j].zoneKey) !== String(p.zoneKey)) continue;
var parts = inst_anaKey(H[j].key).split('#');
if(String(parts[1]||'') === String(m[1])) return inst_anaKey(H[j].key);
}
}
return '';
}
function inst_anaPlanMap(houses){
var byKey = {}, byName = {}, changed = false;
var H = houses || [];
var key = 'gantt_'+String(INST_CUR)+'_house_plan_v1';
try{
var raw = localStorage.getItem(key);
if(raw){
var arr = JSON.parse(raw) || [];
arr.forEach(function(p){
if(!p) return;
var k = inst_anaResolveKey(p, H);
if(k){
byKey[k] = p;
if(!p.key){ p.key = k; changed = true; }
}
if(p.name) byName[String(p.name)] = p;
});
if(changed){ try{ localStorage.setItem(key, JSON.stringify(arr)); }catch(e){} }
}
}catch(e){}
return { byKey: byKey, byName: byName };
}

function inst_anaPlanOf(pm, name, key){
if(!pm) return null;
var k = inst_anaKey(key);
if(k && pm.byKey[k]) return pm.byKey[k];
return pm.byName[String(name)] || null;
}

function inst_anaActualStart(f, key){
var want = inst_anaKey(key), earliest = '';
var workers = (f && f.installation && f.installation.workers) || {};
for(var dk in workers){
if(!workers.hasOwnProperty(dk)) continue;
var wd = workers[dk]; if(wd && wd._deleted) continue;
var ztw = (wd && wd.zoneTeamWorkers) || {};
for(var zn in ztw){
if(!ztw.hasOwnProperty(zn)) continue;
(ztw[zn]||[]).forEach(function(t){
if(!t || !t.house) return;
if(inst_anaKey(t.house)!==want) return;
var ti = t.todayInstall || {}, s = 0;
for(var sp in ti){ if(ti.hasOwnProperty(sp)) s += (+ti[sp]||0); }
if(s>0){ var y=(typeof dmyToYmd==='function')?dmyToYmd(dk):''; if(y && (!earliest || y<earliest)) earliest=y; }
});
}
}
return earliest;
}
function inst_anaDiffDays(a,b){
if(!a||!b) return 0;
return Math.round((Date.parse(b+'T00:00:00Z') - Date.parse(a+'T00:00:00Z'))/86400000);
}

function inst_anaPick(tpl, n){
var parts = String(tpl==null?'':tpl).split('|');
if(parts.length < 2) return parts[0] || '';
return (n === 1 ? parts[0] : parts[1]) || '';
}
function inst_anaAddDays(y,n){
var p=String(y||'').split('-'); if(p.length<3) return '';
var d=new Date(Date.UTC(+p[0],+p[1]-1,+p[2]));
if(isNaN(d.getTime())) return '';
d.setUTCDate(d.getUTCDate()+(+n||0));
return d.toISOString().slice(0,10);
}


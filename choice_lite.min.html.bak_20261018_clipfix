var sd = WL_CUR_DATE;
var dayP = wl_dayProdTotal(f.production && f.production[sd]);
var dayL = wl_dayLaborTotal(f.workers && f.workers[sd]);
var dayI = wl_dayInstTotal(f.installation && f.installation.workers && f.installation.workers[sd]);
return '<div class="wl-sec" style="margin-top:14px"><div class="wl-sec-title">'+wl_i18n('wl_trends')+'</div>'
+ '<div class="wl-trend-summary">'
+ '<div class="wl-trend-sum-item"><span>'+wl_i18n('wl_chart_prod')+'</span><b>'+wl_fmt(dayP)+'</b></div>'
+ '<div class="wl-trend-sum-item"><span>'+wl_i18n('wl_chart_labor')+'</span><b>'+wl_fmt(dayL)+'</b></div>'
+ '<div class="wl-trend-sum-item"><span>'+wl_i18n('wl_chart_inst')+'</span><b>'+wl_fmt(dayI)+'</b></div>'
+ '</div>'
+ '<div class="wl-charts">'
+ '<div class="wl-chart-box"><div class="wl-chart-title">'+wl_i18n('wl_chart_prod')+'</div><canvas id="wlChartProd"></canvas></div>'
+ '<div class="wl-chart-box"><div class="wl-chart-title">'+wl_i18n('wl_chart_labor')+'</div><canvas id="wlChartLabor"></canvas></div>'
+ '<div class="wl-chart-box"><div class="wl-chart-title">'+wl_i18n('wl_chart_inst')+'</div><canvas id="wlChartInst"></canvas></div>'
+ '</div></div>';
}
function wl_renderCharts(f, dates){
if(typeof Chart === 'undefined') return;
var asc = dates.slice().reverse();
var prodS=[], laborS=[], instS=[];
asc.forEach(function(d){
var pt = wl_dayProdTotal(f.production && f.production[d]);
var lt = wl_dayLaborTotal(f.workers && f.workers[d]);
var it = wl_dayInstTotal(f.installation && f.installation.workers && f.installation.workers[d]);
prodS.push(pt); laborS.push(lt); instS.push(it);
});
var labels = asc.map(function(d){ return d.substring(3,5)+'/'+d.substring(0,2); });
function mk(id, data, color){
var cv=document.getElementById(id); if(!cv) return;

var stepLabels = { id:'wlStepLabels', afterDatasetsDraw: function(chart){
var ctx=chart.ctx;
chart.data.datasets.forEach(function(ds, dsIdx){
var meta=chart.getDatasetMeta(dsIdx); if(meta.hidden) return;
meta.data.forEach(function(pt, idx){
if(idx % 5 !== 0) return;
var v=ds.data[idx]; if(v==null || v===0) return;
ctx.save(); ctx.fillStyle='#333'; ctx.font='bold 10px Segoe UI, sans-serif';
ctx.textAlign='center'; ctx.textBaseline='bottom';
ctx.fillText(wl_fmt(v), pt.x, pt.y-6); ctx.restore();
});
});
} };
WL_CHARTS.push(new Chart(cv.getContext('2d'), { type:'line', plugins:[stepLabels], data:{ labels:labels, datasets:[{ label:'', data:data, borderColor:color, backgroundColor:color+'33', fill:true, tension:0.3, pointRadius:3, pointBackgroundColor:'#fff', pointBorderWidth:2 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, ovDataLabels:{display:false} }, scales:{ y:{ beginAtZero:true, ticks:{ callback:function(v){ return wl_fmt(v); } } }, x:{ ticks:{ maxRotation:0, autoSkip:true } } } } }));
}
mk('wlChartProd', prodS, '#E53935');
mk('wlChartLabor', laborS, '#1E88E5');
mk('wlChartInst', instS, '#43A047');
}
function wl_renderDaily(){
var body = document.getElementById('wl-tab-body'); if(!body) return;
var f = wl_factory();
if(!f){ body.innerHTML='<div class="wl-empty">'+wl_i18n('wl_rep_no_data')+'</div>'; return; }
var dates = wl_reportDates(f);
if(!WL_CUR_DATE){ WL_CUR_DATE = dates.length ? dates[0] : ymdToDmy(prod_today()); }
if(!WL_CAL_MONTH){ var p=WL_CUR_DATE.split('/'); WL_CAL_MONTH={ y:+p[2], m:+p[1]-1 }; }
WL_CHARTS = [];
body.innerHTML = '<div id="wl-report"></div>';
wl_renderReport(f, dates);
}
function wl_renderReport(f, dates){
var box = document.getElementById('wl-report'); if(!box) return;
var date = WL_CUR_DATE;
var dt = new Date(dmyToYmd(date));
var w = f.workers && f.workers[date];
var rec = f.production && f.production[date];
var produced={}, lines=0;
if(rec && rec.lines){
Object.keys(rec.lines).forEach(function(n){
lines++;
var L=rec.lines[n]; if(!L) return;
if(L.qty){ Object.keys(L.qty).forEach(function(s){ produced[s]=(+produced[s]||0)+(+L.qty[s]||0); }); }
else if(L.matrix){ Object.keys(L.matrix).forEach(function(hh){ Object.keys(L.matrix[hh]).forEach(function(s){ produced[s]=(+produced[s]||0)+(+L.matrix[hh][s]||0); }); }); }
else if(L.qtyDetail){ Object.keys(L.qtyDetail).forEach(function(s){ var d=L.qtyDetail[s]; if(d&&typeof d==='object'){ Object.keys(d).forEach(function(h){ produced[s]=(+produced[s]||0)+(+d[h]||0); }); } }); }
});
}
var prodTotal=0; Object.keys(produced).forEach(function(s){ prodTotal+=produced[s]; });
var workersTotal=0; if(w){ PROD_WORKERS.forEach(function(k){ workersTotal+=(+w[k[0]]||0); }); }
var wxAm = w && w.weatherAm;
var wxPm = w && w.weatherPm;
var faults=(f.equipment&&f.equipment.faults||[]).filter(function(x){ return wl_normDate(x.date)===date; });
var rcpts=(f.materials&&f.materials.receipts||[]).filter(function(r){ return wl_normDate(r.date)===date; });
var ip=(typeof inst_projectProgress==='function')?inst_projectProgress(f):{demand:0,produced:0,installed:0,prodRate:0,instRate:0};

var h='';
h += '<div class="wl-report-card">';

h += '<div class="wl-report-header">'
+ '<div class="wl-report-title">'+wl_i18n('wl_tab_daily_report')+'</div>'
+ '</div>';

var weekday = String(wl_i18n('wl_weekdays','周日,周一,周二,周三,周四,周五,周六').split(',')[dt.getDay()]||'');
h += '<div class="wl-report-top-row">'
+ '<div class="wl-report-left-col">'
+ wl_wxCardMerged(wxAm, wxPm)
+ '<div class="wl-rep-nav-group">'
+ '<button type="button" class="wl-rep-nav" onclick="wl_repStep(-1)" title="'+wl_i18n('wl_prev')+'">‹</button>'
+ '<div class="wl-rep-date">'+dmyToYmd(date)+' · '+weekday+'</div>'
+ '<button type="button" class="wl-rep-nav" onclick="wl_repStep(1)" title="'+wl_i18n('wl_next')+'">›</button>'
+ '</div></div>'
+ '<div class="wl-cal-compact">'+wl_calHtml(f, dates)+'</div>'
+ '</div>';


h += '<div class="wl-sec"><div class="wl-sec-title">'+wl_i18n('wl_procurement')+'</div><div class="wl-sec-body">';
if(!rcpts.length){ h += '<div class="wl-muted">—</div>'; }
else {
rcpts.forEach(function(r){
var mats=[]; var total=0;
if(r.rows&&r.rows.length){ r.rows.forEach(function(rr){
var q=(rr.qty!=null?rr.qty:(rr.qty_whole!=null?rr.qty_whole:rr.qty_unit));
var u=rr.unit?(' '+rr.unit):'';
var sp=rr.spec?(' ('+rr.spec+')'):'';
mats.push((rr.material||wl_i18n('wl_material'))+sp+(q!==''&&q!=null?' ×'+wl_fmt(q)+u:''));
total += (+rr.subVnd||0);
}); }
var amt = total>0 ? wl_fmt(total)+' VND' : (r.amount||r.money||r.total||'');
h += '<div class="wl-row2">'+ (mats.length?mats.join('；'):wl_i18n('wl_material')) + (amt!==''?' ｜ '+wl_i18n('wl_amount')+': '+amt:'') +'</div>';
});
}
h += '</div></div>';


h += '<div class="wl-sec"><div class="wl-sec-title">'+wl_i18n('wl_production')+'</div><div class="wl-sec-body">';
h += '<div class="wl-kpis"><div class="wl-kpi"><b>'+wl_fmt(lines)+'</b>'+wl_i18n('wl_lines')+'</div>'
+ '<div class="wl-kpi"><b>'+wl_fmt(workersTotal)+'</b>'+wl_i18n('wl_workers')+'</div>'
+ '<div class="wl-kpi"><b>'+wl_fmt(prodTotal)+'</b>'+wl_i18n('wl_total')+'</div></div>';
if(prodTotal>0){
h += '<table class="wl-tbl"><thead><tr><th>'+wl_i18n('wl_spec')+'</th><th>'+wl_i18n('wl_qty')+'</th><th>'+wl_i18n('wl_share')+'</th></tr></thead><tbody>';
Object.keys(produced).forEach(function(s){
var q=produced[s]; var pct = prodTotal? (q/prodTotal*100).toFixed(1)+'%':'0%';
h += '<tr><td>'+wl_esc(s)+'</td><td>'+wl_fmt(q)+'</td><td>'+pct+'</td></tr>';
});
h += '</tbody></table>';
} else { h += '<div class="wl-muted">—</div>'; }
h += '</div></div>';


h += '<div class="wl-sec"><div class="wl-sec-title">'+wl_i18n('wl_fault')+'</div><div class="wl-sec-body">';
if(!faults.length){ h += '<div class="wl-muted">'+wl_i18n('wl_fault_none')+'</div>'; }
else {
h += '<div class="wl-kpis"><div class="wl-kpi"><b>'+wl_fmt(faults.length)+'</b>'+wl_i18n('wl_fault_count')+'</div></div>';
faults.forEach(function(x){ h += '<div class="wl-row2">'+wl_i18n('wl_reason')+': '+(x.reason||'—')+' ｜ '+wl_i18n('wl_down')+': '+(x.down||'—')+' ｜ '+wl_i18n('wl_repair')+': '+(x.repair||'—')+'</div>'; });
}
h += '</div></div>';


var todayInstallQty = wl_dayInstallQty(f.installation && f.installation.workers && f.installation.workers[date]);
h += '<div class="wl-sec"><div class="wl-sec-title">'+wl_i18n('wl_install')+'</div><div class="wl-sec-body">';
h += '<div class="wl-kpis">'
+ '<div class="wl-kpi"><b>'+wl_fmt(todayInstallQty)+'</b>'+wl_i18n('wl_today_install')+'</div>'
+ '<div class="wl-kpi"><b>'+wl_fmt((+ip.installed)||0)+'</b>'+wl_i18n('wl_installed')+'</div>'
+ '<div class="wl-kpi"><b>'+wl_fmt((+ip.demand)||0)+'</b>'+wl_i18n('wl_demand')+'</div>'
+ '<div class="wl-kpi"><b>'+((+ip.instRate)||0).toFixed(1)+'%</b>'+wl_i18n('wl_inst_rate')+'</div></div>';
h += '</div></div>';


h += wl_trendsHtml(f, dates);

h += '</div>';
box.innerHTML = h;
wl_renderCharts(f, dates);
}

'</div>';


html += '' +
'<div class="cpr-sec">' +
'<div class="cpr-sec-title">' + (t.rpt_warranty_sec || '🔐 质保金信息') + '</div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_has_warranty || '有无质保金') + ':</span>' +
'<span class="v"><span class="cpr-badge ' + (hasWarranty?'cpr-badge-yes':'cpr-badge-no') + '">' + (hasWarranty?(t.cp_yes||'是'):(t.cp_no||'否')) + '</span></span>' +
'</div>';
if (hasWarranty) {

var dispStart = data.warrantyStart || '-';
var dispEnd = data.warrantyEnd || '-';

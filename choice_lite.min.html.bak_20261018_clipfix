body: JSON.stringify({q: text, source: source || 'auto', target: target, format: 'text'})
}).then(function(r){ if (!r.ok) throw new Error('lt-'+r.status); return r.json(); })
.then(function(d){ if (d && d.translatedText) return d.translatedText; throw new Error('lt-empty'); });
}
var p = Promise.reject(new Error('lt-init'));
instances.forEach(function(base){ p = p.catch(function(){ return tryOne(base); }); });
return p.catch(function(err){

window.__ltCoolUntil = Date.now() + 5*60*1000;
throw err;
});
}

function ptTranslateViaMyMemory(text, target) {



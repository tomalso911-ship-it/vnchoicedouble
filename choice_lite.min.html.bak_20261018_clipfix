try{ if(p.cust_view_detail){ parsed=(typeof p.cust_view_detail==='string')?JSON.parse(p.cust_view_detail):p.cust_view_detail; } }catch(e){ parsed=null; }
if(parsed && parsed.rows && parsed.rows.length){
out.ok=true; out.rows=parsed.rows; out.planned=parsed.rows.length;
out.paid=parsed.rows.filter(function(r){ var a=r&&r.actual; return a&&((+a.rmb||0)||(+a.usd||0)||(+a.vnd||0)); }).length;
parsed.rows.forEach(function(r){ out.planVnd+=rpt_toVnd(r.plan,rr,ru); out.actualVnd+=rpt_toVnd(r.actual,rr,ru); });

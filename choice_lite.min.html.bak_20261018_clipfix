function prod_weatherForDate(dmy){
var f = prod_get(PROD_CUR); if(!f) return {am:null,pm:null};
var am=null,pm=null;
var pr=(f.production&&f.production[dmy])||null; if(pr){ am=(pr.weatherAm&&pr.weatherAm.v===2)?pr.weatherAm:null; pm=(pr.weatherPm&&pr.weatherPm.v===2)?pr.weatherPm:null; }
var w=(f.workers&&f.workers[dmy])||null; if(w){ if(!am && w.weatherAm && w.weatherAm.v===2) am=w.weatherAm; if(!pm && w.weatherPm && w.weatherPm.v===2) pm=w.weatherPm; }

if(f.houseOut){
for(var _k in f.houseOut){ if(!f.houseOut.hasOwnProperty(_k)) continue; var _rec=f.houseOut[_k];
var ymd = dmyToYmd(dmy);
var _daily=(_rec.outDaily&&_rec.outDaily[ymd])||(_rec.inDaily&&_rec.inDaily[ymd]);
if(_daily){ if(!am && _daily.weatherAm && _daily.weatherAm.v===2) am=_daily.weatherAm; if(!pm && _daily.weatherPm && _daily.weatherPm.v===2) pm=_daily.weatherPm; }
}
}

if(dmyToYmd(dmy) === prod_today()){

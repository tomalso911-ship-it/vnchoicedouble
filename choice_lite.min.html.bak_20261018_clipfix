try {
window.__mmCache = window.__mmCache || {};
if (window.__mmCache[target + '|' + text]) return Promise.resolve(window.__mmCache[target + '|' + text]);
} catch (e) {}

function _mmSrc(v){
if (/[\u4e00-\u9fa5]/.test(v)) return 'zh-CN';
if (/[àáảãạăắằẳẵặâấầẩẫậđèéẻẽẹêếềểễệìíỉĩịòóỏõọôốồổỗộơớờởỡợùúủũụưứừửữựỳýỷỹỵ]/i.test(v)) return 'vi-VN';
return 'en-US';
}

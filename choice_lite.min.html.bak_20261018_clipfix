function uploadAddmDoc(idx, file, input){
var t = addmT();
var pid = addmProjectId();
var done = function(){ if (input) input.value = ''; };
if (!pid) {
done();
addmAlert(t.addm_save_first || '请先保存主表');
return;
}
var rows = addmGetRows();
var oldFile = (rows[idx] && rows[idx].file) || '';
var fd = new FormData();
fd.append('file', file);
fd.append('slot', 'doc_addendum');
if (oldFile && oldFile.indexOf('/api/files/won-docs/addm/') === 0) {
fd.append('oldfile', oldFile.split('/api/files/won-docs/addm/')[1]);
}

var row = document.createElement('div');
row.className = 'vu-row';
row.innerHTML = '<div class="vu-name"></div>' +
'<div class="vu-bar"><div class="vu-fill"></div></div>' +
'<div class="vu-meta"><span class="vu-pct">0%</span><span class="vu-st">' + (t.common_uploading || '上传中…') + '</span></div>';
row.querySelector('.vu-name').textContent = (t.addm_file || '附件') + ' · ' + (file && file.name || '');
var fill = row.querySelector('.vu-fill'), pct = row.querySelector('.vu-pct'), st = row.querySelector('.vu-st');
var base = '';
fetch(base + '/api/won-projects/' + encodeURIComponent(pid) + '/documents', { method: 'POST', body: fd })
.then(function(r){
return r.text().then(function(txt){
var b = {}; try { b = JSON.parse(txt); } catch (e) {}
return { ok: (r.ok && b && b.ok), status: r.status, body: b };
});
})
.then(function(res){
done();
if (res.ok) {
fill.style.width = '100%'; fill.classList.add('done');
pct.textContent = '100%'; st.textContent = t.common_upload_done || '完成';
var rr = addmGetRows();
if (rr[idx]) {
rr[idx].file = res.body.url;
rr[idx].filename = res.body.filename;
rr[idx].upload_count = (rr[idx].upload_count || 0) + 1;
addmSetRows(rr);
addmSaveToMain(rr);
}
addmRender();
addmAlert(t.addm_upload_ok || '上传成功', true);
} else {
fill.classList.add('fail'); st.textContent = t.common_upload_fail || '失败';
var em = (res.body && res.body.error)
? (res.body.error + '（HTTP ' + res.status + '）')
: ((t.crm_pdf_err_server || '上传失败') + '（HTTP ' + res.status + '）');
addmAlert(em);
}
setTimeout(function(){ row.remove(); }, 2500);
})
.catch(function(err){
done();
fill.classList.add('fail'); st.textContent = t.common_network_error || '网络错误';
addmAlert((t.crm_pdf_err_server || '上传失败') + '：' + ((err && err.message) || err));
setTimeout(function(){ row.remove(); }, 2500);
});
}



function prod_dailyEnsureQtyDetail(line, spec){
if(!line.qtyDetail) line.qtyDetail = {};
if(line.qtyDetail[spec]) return line.qtyDetail[spec];
var total = (+line.qty[spec]||0);
var eligible = []; var totalDemand = 0;
var mm = prod_slatsMatrix();
(line.houses||[]).forEach(function(h){
var dem = (mm.specs[spec] && mm.specs[spec].houses[h]) || 0;
if(dem > 0){ eligible.push({h:h, dem:dem}); totalDemand += dem; }
});
var detail = {};
if(!eligible.length){
(line.houses||[]).forEach(function(h){ detail[h] = total; });
} else if(eligible.length === 1){
detail[eligible[0].h] = total;
} else {
var allocated = 0, maxIdx = 0;
for(var ei=0; ei<eligible.length; ei++){
var e = eligible[ei];
var share = totalDemand > 0 ? Math.round(total * e.dem / totalDemand) : 0;
e.share = share; allocated += share;
if(share > eligible[maxIdx].share) maxIdx = ei;
}
if(allocated !== total && eligible.length) eligible[maxIdx].share += (total - allocated);
for(var ei=0; ei<eligible.length; ei++){ var e = eligible[ei]; if(e.share > 0) detail[e.h] = e.share; }
}
line.qtyDetail[spec] = detail;
return detail;
}

function prod_dailySyncQtyTotal(line, spec){
var detail = line.qtyDetail && line.qtyDetail[spec];
if(!detail) return (+line.qty[spec]||0);
var total = 0;
for(var h in detail){ if(detail.hasOwnProperty(h)) total += (+detail[h]||0); }
line.qty[spec] = total;
return total;
}


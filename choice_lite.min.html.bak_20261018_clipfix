function inst_zoneStats(f, zoneNum, houses){
if(!houses){ try{ houses = inst_buildGanttHouses(f) || []; }catch(e){ houses = []; } }
var zn = String(zoneNum);
var hs = houses.filter(function(h){ return h.zoneKey === zn; });
var bldg = hs.length;
var total = 0, done = 0;
hs.forEach(function(h){ total += (+h.panels||0); done += (+h.done||0); });
var remaining = Math.max(0, total - done);
var progress = total>0 ? Math.round(done/total*100) : 0;
var plan = (f.installation && f.installation.plan) || {};
var ratePerTeam = Math.max(1, +plan.installRatePerTeam||200);
var teams = Math.max(1, +plan.installTeams||2);
var dailyRate = ratePerTeam * teams;
var zPlan = inst_ganttZonePlan(f, zoneNum);

var installStart = (zPlan && zPlan.start) ? zPlan.start : '';
if(!installStart) installStart = (typeof prod_ymd==='function') ? prod_ymd(plan.installStartDate||'') : (plan.installStartDate||'');
if(!installStart) installStart = (typeof prod_startProdYmd==='function') ? prod_startProdYmd(f) : '';
if(!installStart) installStart = prod_today();
var byZone = {};
houses.forEach(function(h){ var z = h.zoneKey; byZone[z] = byZone[z] || {total:0}; byZone[z].total += (+h.panels||0); });
var priorPanels = 0;
Object.keys(byZone).map(function(x){ return +x; }).sort(function(a,b){ return a-b; }).forEach(function(zn2){ if(zn2 < zoneNum) priorPanels += byZone[String(zn2)].total; });
var daysBefore = priorPanels>0 ? Math.ceil(priorPanels / dailyRate) : 0;
var startYmd = inst_addWorkDays(installStart, daysBefore + 1);
var zoneDays = total>0 ? Math.ceil(total / dailyRate) : 0;
var planEnd = inst_addWorkDays(startYmd, zoneDays);
var today = prod_today();
var baseYmd = today > startYmd ? today : startYmd;
var remainDays = remaining>0 ? Math.ceil(remaining / dailyRate) : 0;
var likelyEnd = remaining>0 ? inst_addWorkDays(baseYmd, remainDays) : '';
if(zPlan && zPlan.end) planEnd = zPlan.end;
var theoryDone = 0, theoryRemaining = remaining, theoryProgress = 0;
var housePlan = null;
try{ housePlan = inst_ganttHousePlan(f); }catch(e){ housePlan = null; }
var zoneHouses = null;
if(housePlan && housePlan.length){
zoneHouses = housePlan.filter(function(x){ return String(x.zoneKey) === zn; });
}

var planUsable = false;
if(zoneHouses && zoneHouses.length){
for(var qi=0; qi<zoneHouses.length; qi++){
var qz = zoneHouses[qi];
if(qz && (+qz.panels||0)>0 && qz.start && qz.end){ planUsable = true; break; }
}
}
if(planUsable){

zoneHouses.forEach(function(hz){
var p = +hz.panels||0;
if(!p || !hz.start || !hz.end) return;
if(today >= hz.end){ theoryDone += p; }
else if(today >= hz.start){
var dur = Math.max(1, +hz.days || (inst_daysBetween(hz.start, hz.end)+1));
var elp = inst_daysBetween(hz.start, today) + 1;
theoryDone += p * Math.min(1, elp / dur);
}
});
theoryDone = Math.min(total, Math.round(theoryDone));
theoryRemaining = Math.max(0, total - theoryDone);
theoryProgress = total>0 ? Math.round(theoryDone/total*100) : 0;
} else if(zPlan && zPlan.start && zPlan.end){
if(today >= zPlan.end){
theoryDone = total; theoryRemaining = 0; theoryProgress = 100;
} else if(today >= zPlan.start){
var elapsed = inst_daysBetween(zPlan.start, today) + 1;
theoryProgress = Math.min(100, Math.round(elapsed / zPlan.days * 100));
theoryDone = Math.round(total * elapsed / zPlan.days);
theoryRemaining = Math.max(0, total - theoryDone);
}
} else if(startYmd && today >= startYmd){
var workDays = inst_workDaysBetween(startYmd, today);
theoryDone = Math.min(total, workDays * dailyRate);
theoryRemaining = Math.max(0, total - theoryDone);
theoryProgress = total>0 ? Math.round(theoryDone/total*100) : 0;
}
return { bldg:bldg, total:total, done:done, remaining:remaining, progress:progress, start:startYmd, planEnd:planEnd, likelyEnd:likelyEnd, dailyRate:dailyRate, theoryDone:theoryDone, theoryRemaining:theoryRemaining, theoryProgress:theoryProgress };
}


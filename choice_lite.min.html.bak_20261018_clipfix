risks.push((t.rpt_unpaid_risk||'存在未付金额 ¥{rmb} | ${usd} | ₫{vnd}')
.replace('{rmb}', fmtN(outstanding.rmb))
.replace('{usd}', fmtN(outstanding.usd))
.replace('{vnd}', fmtN(outstanding.vnd)));
}
if (actualSum.rmb === 0 && rows.length > 0) risks.push(t.rpt_no_actual || '尚未有任何实际付款记录');


var html = '';


html += '' +
'<div class="cpr-sec" style="background:#f0f4f8;">' +
'<div class="cpr-sec-title">📋 ' + (type === 'cust' ? (t.rpt_title || '客户付款智能报告') : (t.rpt_title || 'AGI→GS 付款智能报告')) + '</div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_contract || '合同编号') + ':</span> <span class="v">' + (wonData ? wonData.contract_no || '-' : '-') + '</span></div>' +
'<div class="cpr-row"><span class="k">' + (t.rpt_lang || '语言') + ':</span> <span class="v">' + lang.toUpperCase() + '</span></div>' +

var radius = Math.min(chartArea.right - chartArea.left, chartArea.bottom - chartArea.top) / 2;
var innerRadius = radius * 0;
var cumulativeAngle = -Math.PI / 2;
for(var i=0;i<data.length;i++){
var v = data[i];
if(v == null || v === 0){ cumulativeAngle += 2 * Math.PI * (v / (total || 1)); continue; }
var sliceAngle = 2 * Math.PI * (v / total);
var midAngle = cumulativeAngle + sliceAngle / 2;

var midRadius = (radius + innerRadius) / 2;
var cx = centerX + midRadius * Math.cos(midAngle);
var cy = centerY + midRadius * Math.sin(midAngle);
var pct = ((v/total)*100).toFixed(1);


v=_ovNum(v);
if(v>=1000000){
var ms=(v/1000000).toFixed(2).replace(/\.?0+$/,'');
var parts=ms.split('.');
parts[0]=parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
return sym+parts.join('.')+'M';
}
return sym+_ovFmt(Math.round(v));
}

Object.keys(specData.houses||{}).forEach(function(h){
if(!prod_specHasDemandForHouse(h, spec)) return;
var bc=prod_buildingCountForHouse(h)||0;
var per=prod_outDemandPerBldg(h, spec);
for(var i=1;i<=bc;i++){
if(String(assign[h+'#'+i])===String(zone)) sum+=per;
}
});
return sum;
}

function prod_outShippedSummary(spec){
var f=prod_get(PROD_CUR); if(!f) return {bldg:{}, zone:{}};
var assign=(f.installation&&f.installation.assign)||{};
var ho=f.houseOut||{};
var bldg={}, zone={};
for(var key in ho){ if(!ho.hasOwnProperty(key)) continue;
var kp=key.split('|'); var keySpec=kp.slice(1).join('|');
if(keySpec!==spec) continue;
var rec=ho[key]||{}; var od=rec.outDaily||{}; var srcKey=kp[0];
for(var d in od){ if(!od.hasOwnProperty(d)) continue;
var e=od[d]; var destHouse=e.destHouse||'';
(e.lines||[]).forEach(function(L){
var b=L.dest||'', q=+(L.qty||0)||0; if(!b || !q) return;
var nb=String(parseInt(b,10)||0);

var hs=[];
if(destHouse){ hs=[destHouse]; }
else if(e.zone){
for(var ak in assign){ if(!assign.hasOwnProperty(ak)) continue;
if(String(assign[ak])!==String(e.zone)) continue;
var ap=ak.split('#');
if(String(parseInt(ap[1]||'0',10))===nb) hs.push(ap[0]);
}
}
hs.forEach(function(hh){
var bk=hh+'#'+b; bldg[bk]=(bldg[bk]||0)+q;
var z=assign[bk]; if(z) zone[z]=(zone[z]||0)+q;
});
});
}
}
return {bldg:bldg, zone:zone};
}


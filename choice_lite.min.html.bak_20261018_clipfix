dt.setDate(dt.getDate()+delta);
var y=dt.getFullYear(),m=('0'+(dt.getMonth()+1)).slice(-2),dd=('0'+dt.getDate()).slice(-2);
return y+'-'+m+'-'+dd;
}

function rpt_toVnd(o, rr, ru){
o=o||{}; return (+o.vnd||0)+((+o.rmb||0)*(+rr||0))+((+o.usd||0)*(+ru||0));

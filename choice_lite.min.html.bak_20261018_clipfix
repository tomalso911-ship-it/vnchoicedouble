function syncAgiPaymentFields() {

if (typeof signingLockInfo === 'function' && signingLockInfo().lockAgi) return;
var rmbVal = 0, usdVal = 0, vndVal = 0, payCount = 0;
var data = null;


if (_agiPayStore) {
try { data = JSON.parse(JSON.stringify(_agiPayStore)); } catch(e) { data = null; }
}

if (!data) {
var id = (el('wonModal') && el('wonModal').dataset.id) || _agiPayCurrentId || _custPayCurrentId;
if (id && globalWonData && globalWonData.length) {
var p = globalWonData.find(function(x){ return x.id == id; });
if (p && p.agi_view_detail) {
try {
var raw = typeof p.agi_view_detail === 'string' ? p.agi_view_detail : JSON.stringify(p.agi_view_detail);
data = JSON.parse(raw);
} catch(e) { data = null; }
}
}
}

if (!data) {
var hid = el('agi_view_detail');
if (hid && hid.value && hid.value.trim()) {
try { data = JSON.parse(hid.value.trim()); } catch(e) { data = null; }
}
}

if (data && data.rows && data.rows.length > 0) {
for (var ri = 0; ri < data.rows.length; ri++) {
var r = data.rows[ri];
var a = (r && r.actual) || {};
var d = (r && r.actualDate) || '';
var arm = parseFloat(a.rmb) || 0;
var aus = parseFloat(a.usd) || 0;
var avn = parseFloat(a.vnd) || 0;
if (d.trim() !== '' && (arm > 0 || aus > 0 || avn > 0)) {
rmbVal += arm;
usdVal += aus;
vndVal += avn;
payCount++;
}
}
}


if (rmbVal === 0 && usdVal === 0 && vndVal === 0) {
var agiBody = el('agiRptBody');
if (agiBody) {
var sec3 = agiBody.querySelector('.cpr-sec:nth-child(3)');
if (sec3) {

var actualRow = sec3.querySelector('.cpr-row:nth-child(4) .v');
if (actualRow) {
var spans = actualRow.querySelectorAll('span');
rmbVal = spans.length > 0 ? stripToNumber(spans[0].textContent) : 0;
usdVal = spans.length > 1 ? stripToNumber(spans[1].textContent) : 0;
vndVal = spans.length > 2 ? stripToNumber(spans[2].textContent) : 0;
}

var pcRow = sec3.querySelector('.cpr-row:nth-child(9) .v b');
if (pcRow) payCount = parseInt(pcRow.textContent) || 0;
}
}
}


var prEl = el('w_agi_paid_rmb');
if (prEl) prEl.value = rmbVal > 0 ? formatCurrencyWithSymbol(rmbVal, 'RMB') : '';
var puEl = el('w_agi_paid_usd');
if (puEl) puEl.value = usdVal > 0 ? formatCurrencyWithSymbol(usdVal, 'USD') : '';
var pvEl = el('w_agi_paid_vnd');
if (pvEl) pvEl.value = vndVal > 0 ? formatCurrencyWithSymbol(vndVal, 'VND') : '';


var pcEl = el('w_agi_pay_count');
if (pcEl) pcEl.value = payCount > 0 ? payCount : '';


var payableRmb = stripToNumber((el('w_agi_payable_rmb') && el('w_agi_payable_rmb').value) || 0);
var payableUsd = stripToNumber((el('w_agi_payable_usd') && el('w_agi_payable_usd').value) || 0);
var payableVnd = stripToNumber((el('w_agi_payable_vnd') && el('w_agi_payable_vnd').value) || 0);
var unpaidRmb = Math.max(0, payableRmb - rmbVal);
var unpaidUsd = Math.max(0, payableUsd - usdVal);
var unpaidVnd = Math.max(0, payableVnd - vndVal);
var urEl = el('w_agi_unpaid_rmb');
if (urEl) urEl.value = unpaidRmb > 0 ? formatCurrencyWithSymbol(unpaidRmb, 'RMB') : '';
var uuEl = el('w_agi_unpaid_usd');
if (uuEl) uuEl.value = unpaidUsd > 0 ? formatCurrencyWithSymbol(unpaidUsd, 'USD') : '';
var uvEl = el('w_agi_unpaid_vnd');
if (uvEl) uvEl.value = unpaidVnd > 0 ? formatCurrencyWithSymbol(unpaidVnd, 'VND') : '';
}

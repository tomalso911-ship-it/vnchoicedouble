if (dir.indexOf('s') >= 0) newH = state.origH + dy;
if (dir.indexOf('n') >= 0) { newH = state.origH - dy; newTop = state.origTop + dy; }

if (newW < minW) { if (dir.indexOf('w') >= 0) newLeft = state.origLeft + (state.origW - minW); newW = minW; }
if (newH < minH) { if (dir.indexOf('n') >= 0) newTop = state.origTop + (state.origH - minH); newH = minH; }
if (newW > maxW) { if (dir.indexOf('w') >= 0) newLeft = state.origLeft + (state.origW - maxW); newW = maxW; }
if (newH > maxH) { if (dir.indexOf('n') >= 0) newTop = state.origTop + (state.origH - maxH); newH = maxH; }

if (window.__modalZoom) window.__modalZoom.apply(box, newW, newH);
box.style.left = newLeft + 'px';
if (dir.indexOf('n') >= 0) box.style.top = newTop + 'px';
});

document.addEventListener('mouseup', function() { state = null; });
}


function makeCalendarDraggable(popupSelector, handleSelector) {
var popup = document.querySelector(popupSelector);
if (!popup) return;
var handle = popup.querySelector(handleSelector) || popup;

var dragging = false, startX, startY, origTop, origLeft;

handle.addEventListener('mousedown', function(e) {

if (e.target.tagName.toLowerCase() === 'button') return;
if (!popup.classList.contains('show')) return;
dragging = true;
startX = e.clientX;
startY = e.clientY;
var cs = window.getComputedStyle(popup);
origTop = parseFloat(cs.top) || 0;
origLeft = parseFloat(cs.left) || 0;
popup.classList.add('dragging');
e.preventDefault();
});

document.addEventListener('mousemove', function(e) {
if (!dragging) return;
var dx = e.clientX - startX;
var dy = e.clientY - startY;
var newTop = origTop + dy;
var newLeft = origLeft + dx;

var rect = popup.getBoundingClientRect();
if (newTop < 0) newTop = 0;
if (newLeft < 0) newLeft = 0;
if (newTop + rect.height > window.innerHeight) newTop = window.innerHeight - rect.height - 4;
if (newLeft + rect.width > window.innerWidth) newLeft = window.innerWidth - rect.width - 4;
popup.style.top = newTop + 'px';
popup.style.left = newLeft + 'px';
});

document.addEventListener('mouseup', function() {
if (!dragging) return;
dragging = false;
popup.classList.remove('dragging');
});
}





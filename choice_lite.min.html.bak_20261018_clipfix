headEl.appendChild(actions);
} else {
if (cs.position === 'static') box.style.position = 'relative';
box.appendChild(actions);
}
return;
}


box.appendChild(btn);
}

document.querySelectorAll(BOX_SEL).forEach(injectMaxBtn);

new MutationObserver(function(muts) {

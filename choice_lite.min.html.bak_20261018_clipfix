function prodReceiptPhotoResize(file, cb, maxBytes){
maxBytes = maxBytes || 120*1024;
var img = new Image();
var url = URL.createObjectURL(file);
img.onload = function(){
URL.revokeObjectURL(url);
var w=img.width, h=img.height;
function attempt(maxDim, quality){
var cw=w, ch=h;
if(cw>maxDim || ch>maxDim){ var s=maxDim/Math.max(cw,ch); cw=Math.round(cw*s); ch=Math.round(ch*s); }
var canvas=document.createElement('canvas'); canvas.width=cw; canvas.height=ch;
canvas.getContext('2d').drawImage(img,0,0,cw,ch);
canvas.toBlob(function(blob){
if(blob.size<=maxBytes || (maxDim<=400 && quality<=0.5)){
var name=file.name.replace(/\.[^.]+$/,'')+'_resized.jpg';
cb(new File([blob], name, {type:'image/jpeg', lastModified:Date.now()}));
} else if(quality>0.5){
attempt(maxDim, Math.max(0.5, quality-0.1));
} else {
attempt(Math.round(maxDim*0.8), 0.9);
}
}, 'image/jpeg', quality);
}
attempt(1920, 0.9);
};
img.onerror = function(){ URL.revokeObjectURL(url); cb(file); };
img.src = url;
}

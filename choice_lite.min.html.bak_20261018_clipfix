function __libHasFiles(dt){
if(!dt || !dt.types) return false;
var types = dt.types;
if(typeof types.contains === 'function') return types.contains('Files');
if(typeof types.indexOf === 'function') return types.indexOf('Files') !== -1;
for(var i=0;i<types.length;i++){ if(types[i] === 'Files') return true; }
return false;
}
document.addEventListener('dragenter', function(e){
if(window.currentView !== 'library') return;
if(!__libHasFiles(e.dataTransfer)) return;
__libDragCounter++;
__libShowDragOverlay(true);
});
document.addEventListener('dragover', function(e){
if(window.currentView !== 'library') return;
if(!__libHasFiles(e.dataTransfer)) return;
e.preventDefault();
if(e.dataTransfer) e.dataTransfer.dropEffect = 'copy';
__libShowDragOverlay(true);
});
document.addEventListener('dragleave', function(e){
if(window.currentView !== 'library') return;
__libDragCounter--;
if(__libDragCounter <= 0){ __libDragCounter = 0; __libShowDragOverlay(false); }
});
document.addEventListener('drop', function(e){
if(window.currentView !== 'library') return;
__libDragCounter = 0;
__libShowDragOverlay(false);
var dt = e.dataTransfer;
if(!dt) return;
if(!lib_canEdit()) return;

var items = dt.items, hasEntry = false;
if(items && items.length){
for(var k=0;k<items.length;k++){ if(items[k].webkitGetAsEntry && items[k].webkitGetAsEntry()){ hasEntry = true; break; } }
}
if(hasEntry){
e.preventDefault();
var entries = [];
for(var m=0;m<items.length;m++){
if(items[m].webkitGetAsEntry){ var en = items[m].webkitGetAsEntry(); if(en) entries.push(en); }
}
if(!entries.length) return;
var out = [], pending = entries.length, finished = false;
var finish = function(){ if(finished) return; finished = true; if(out.length) lib_postUpload(out); else showToast(lt('lib_no_files')); };
entries.forEach(function(en){
lib_collectEntry(en, '', function(list){
for(var z=0;z<list.length;z++) out.push(list[z]);
if(--pending === 0) finish();
});
});
return;
}
var files = dt.files;
if(files && files.length){
e.preventDefault();
lib_uploadFiles(files);
}
});

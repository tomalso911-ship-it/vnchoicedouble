function onUsersRowDblClick(uid){
if(!canReorderUsers()) return;
if(window.__selectedUserId === uid) window.__selectedUserId = null;
else window.__selectedUserId = uid;
renderUsers();
}
function moveUserRow(dir, uid, e){
if(e && e.stopPropagation) e.stopPropagation();
if(!canReorderUsers()) return;
const idx = usersData.findIndex(function(u){ return u.id === uid; });
if(idx < 0) return;
if(dir === 'up' && idx === 0) return;
if(dir === 'down' && idx === usersData.length - 1) return;
const swapIdx = dir === 'up' ? idx - 1 : idx + 1;
const tmp = usersData[idx];
usersData[idx] = usersData[swapIdx];
usersData[swapIdx] = tmp;

const orders = usersData.map(function(u, i){ return { id: u.id, sort_order: (i + 1) * 1000 }; });
renderUsers();
saveUserOrder(orders);
}
function saveUserOrder(orders){
const body = JSON.stringify({ orders: orders });
const opts = { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: body };

fetch('/api/users/reorder', opts).then(function(r){ return r.json(); }).then(function(j){
if(!j || !j.ok) showAlert((j && (j.message || j.error)) || '保存顺序失败');
}).catch(function(e){
console.error('saveUserOrder error', e);
showAlert('保存顺序失败');
});
}


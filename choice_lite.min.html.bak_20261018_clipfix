function onRowAmtInput(src,inputEl){
var tr=inputEl.closest('tr'); if(!tr) return;
var rE=tr.querySelector('.cm-amt-rmb'),uE=tr.querySelector('.cm-amt-usd'),vE=tr.querySelector('.cm-amt-vnd');
var v=getNum(inputEl); var rates=getRates(); var usd=0;
var rmb=0,usd2=0,vnd=0;
if(v){ if(src==='rmb'){rmb=Math.round(v);usd2=Math.round(rmb/rates.r2u);vnd=Math.round(usd2*rates.u2v);}
else if(src==='usd'){usd2=Math.round(v);rmb=Math.round(usd2*rates.r2u);vnd=Math.round(usd2*rates.u2v);}
else if(src==='vnd'){vnd=Math.round(v);usd2=Math.round(vnd/rates.u2v);rmb=Math.round(usd2*rates.r2u);}
rE.value=rmb>0?formatCurrencyWithSymbol(rmb,'RMB'):'';
uE.value=usd2>0?formatCurrencyWithSymbol(usd2,'USD'):'';
vE.value=vnd>0?formatCurrencyWithSymbol(vnd,'VND'):'';
} else { rE.value='';uE.value='';vE.value=''; }
calcSum();
}



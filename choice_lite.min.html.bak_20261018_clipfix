function addmDescTranslate(idx,lang,val,immediate){
if(!navigator.onLine||typeof ptTranslateText!=='function') return;
console.warn('[addm-desc] translate start', idx, lang, immediate ? 'immediate' : 'debounce');
function run(){
var rows2=addmGetRows(); var r2=rows2[idx]; if(!r2) return;
var body=addmEl('addmBody');
var srcInput=body&&body.querySelector('tr[data-i="'+idx+'"] td:nth-child(6) input[data-dlang="'+lang+'"]');
var src=srcInput?(srcInput.value||''):(tlObj(r2.desc)[lang]||'');
console.warn('[addm-desc] translate run', idx, lang, src);
if(!src.trim()) return;
if(!window.__addmDescAuto) window.__addmDescAuto = {};
['zh','en','vi'].forEach(function(t){
if(t===lang) return;
var tb=body&&body.querySelector('tr[data-i="'+idx+'"] td:nth-child(6) input[data-dlang="'+t+'"]');
if(!tb) return;
var cur=(tb.value||'').trim();
var last=window.__addmDescAuto[idx+'_'+t];
if(cur && cur!==last) return;
ptTranslateText(src,t).then(function(res){
console.warn('[addm-desc] translate result', idx, t, res);
if(!res) return;
if(tb.value!==res){
tb.value=res;
window.__addmDescAuto[idx+'_'+t]=res;
var rows3=addmGetRows(); var r3=rows3[idx]; if(!r3) return;
var o3=tlObj(r3.desc);
if(o3[t]!==res){ o3[t]=res; r3.desc=o3; addmSetRows(rows3); }
}
}).catch(function(err){ console.warn('[addm-desc] translate error', idx, t, err); });
});
}
if(_adTm2[idx]) clearTimeout(_adTm2[idx]);
if(immediate) run();
else _adTm2[idx]=setTimeout(run, 800);
}

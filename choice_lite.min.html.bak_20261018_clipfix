function rpt_recentOutput(f, days){
var prod=f.production||{}; var today=rpt_todayYmd(); var cut=rpt_ymdAddDays(today,-(days-1));
var total=0;
for(var d in prod){ if(!prod.hasOwnProperty(d)) continue; var ymd=dmyToYmd(d); if(!ymd||ymd<cut||ymd>today) continue;
var rec=prod[d]; if(!rec||!rec.lines) continue;
for(var n in rec.lines){ if(!rec.lines.hasOwnProperty(n)) continue; var add={}; prod_lineAddQty(rec.lines[n],add); for(var s in add) total+=(+add[s]||0); }
}
return total;
}

function rpt_producedBySpec(f){
var per={}; var prod=f.production||{};
for(var d in prod){ if(!prod.hasOwnProperty(d)) continue; var rec=prod[d]; if(!rec||!rec.lines) continue;
for(var n in rec.lines){ if(!rec.lines.hasOwnProperty(n)) continue; var add={}; prod_lineAddQty(rec.lines[n],add); for(var s in add){ per[s]=(per[s]||0)+(+add[s]||0); } }
}
return per;
}

function rpt_outBySpec(f){ return prod_houseOutBySpec(f)||{}; }

function rpt_demandBySpec(){
var mm=prod_slatsMatrix(); var out={};
Object.keys(mm.specs).forEach(function(k){ out[k]=mm.specs[k].total||0; });
return out;
}

function rpt_installedBySpec(f){
var mm=prod_slatsMatrix(); var workers=(f.installation&&f.installation.workers)||{}; var res={};
mm.houseOrder.forEach(function(h){
if(!h||h==='—') return;
var bc=prod_buildingCountForHouse(h)||0; if(!bc) return;
Object.keys(mm.specs).forEach(function(sp){
if(!mm.specs.hasOwnProperty(sp)) return;
var total=mm.specs[sp].houses[h]||0; if(!total) return;
var perDemand=Math.round(total/bc); if(perDemand<=0) return;
for(var b=1;b<=bc;b++){ var inst=inst_bldgSpecInstalled(workers,h,b,sp); res[sp]=(res[sp]||0)+Math.min(perDemand, inst); }
});
});
return res;
}

function rpt_avgWorkers(f){
var w=f.workers||{}; var days=0,total=0;
for(var d in w){ if(!w.hasOwnProperty(d)) continue; var rec=w[d]; if(!rec||typeof rec!=='object') continue; if(rec.holiday==='yes') continue;
var sum=0; PROD_WORKERS.forEach(function(k){ sum+=(+rec[k[0]]||0); }); total+=sum; days++; }
return {avg: days>0? total/days : 0, days:days, total:total};
}

function rpt_custPay(p){
var rr=(+p.rate_rmb_vnd||0), ru=(+p.rate_usd_vnd||0);

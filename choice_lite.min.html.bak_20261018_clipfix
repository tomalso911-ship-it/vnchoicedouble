window.addmOnFile=function(idx,input){
var t = addmT();
var file = input.files && input.files[0];
if (!file){ return; }
var name = String(file.name || '').toLowerCase();

if (!name.endsWith('.pdf')) {
input.value = '';
addmAlert(t.crm_pdf_err_ext || '所选文件不是PDF格式，请重新选择');
return;
}
var reader = new FileReader();
reader.onload = function(ev){
var arr = new Uint8Array(ev.target.result);

var windowLen = Math.min(arr.length, 1024 + 5);
var found = -1;
for (var i = 0; i + 5 <= windowLen && i < 1024; i++) {
if (arr[i] === 0x25 && arr[i+1] === 0x50 && arr[i+2] === 0x44 && arr[i+3] === 0x46 && arr[i+4] === 0x2D) { found = i; break; }
}
if (found < 0) {
input.value = '';
addmAlert(t.crm_pdf_err_ext || '所选文件不是PDF格式，请重新选择');
return;
}
uploadAddmDoc(idx, file, input);
};
reader.onerror = function(){
input.value = '';

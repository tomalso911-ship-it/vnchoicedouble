function prod_outDestItems(spec, selVal, zone, srcHouse){
var f=prod_get(PROD_CUR); if(!f) return [];
var assign=(f.installation&&f.installation.assign)||{};
var matrix=prod_slatsMatrix();
var specData=matrix.specs[spec]; if(!specData) return [];
var shipped=prod_outShippedSummary(spec).bldg;
var srcType=srcHouse ? prod_phName(srcHouse) : '';
var all=[];
Object.keys(specData.houses||{}).forEach(function(h){
if(!prod_specHasDemandForHouse(h, spec)) return;
if(srcType && prod_phName(h)!==srcType) return;
var bc=prod_buildingCountForHouse(h)||0;
var per=prod_outDemandPerBldg(h, spec);
for(var i=1;i<=bc;i++){
var val=h+'#'+i;
var inArea=assign[val];
var txt=prod_phName(h)+'#'+i;
var red=(per>0 && (shipped[val]||0)>=per);
var tip=prod_outBldgTipHtml(h, i, txt, spec);
all.push({val:val, txt:txt, red:red, tip:tip, inArea:inArea});
}
});

if(selVal && !all.some(function(it){ return it.val===selVal; })){
var parsed=prod_parseBldgVal(selVal);
if(parsed.h){
var _val=parsed.h+'#'+parsed.b;
var _txt=prod_phName(parsed.h)+'#'+parsed.b;
all.unshift({val:_val, txt:_txt, red:false, tip:'', inArea:prod_bldgToZone(parsed.h, parsed.b)});
}
}
var items = zone ? all.filter(function(it){ return String(it.inArea)===String(zone) || it.val===selVal; }) : all;
if(!items.length) items = all;

var ord = (function(){
var fi = prod_get(PROD_CUR) || {}; var inst = fi.installation || {};
var assign = inst.assign || {};
var zc = inst.zoneCount || 0;
for(var kk in assign){ var zz = +assign[kk]; if(zz > zc) zc = zz; }
var userOrder = (Array.isArray(inst.order) ? inst.order : []).filter(function(k){ return assign[k] !== undefined; });
var seen = {}; userOrder.forEach(function(k){ seen[k] = 1; });
var byZone = {};
for(var k in assign){ if(!seen[k]){ var z = +assign[k] || 0; (byZone[z] || (byZone[z] = [])).push(k); } }
var seq = userOrder.slice();
for(var z=1; z<=zc; z++){ (byZone[z] || []).forEach(function(k){ seq.push(k); }); }
return seq;
})();
items.sort(function(a,b){
var ia = ord.indexOf(a.val); if(ia<0) ia = 1e9;
var ib = ord.indexOf(b.val); if(ib<0) ib = 1e9;
if(ia !== ib) return ia - ib;
var an = parseInt(((a.val||'').split('#')[1]||'0'),10) || 0;
var bn = parseInt(((b.val||'').split('#')[1]||'0'),10) || 0;
return an - bn;
});
return items;
}


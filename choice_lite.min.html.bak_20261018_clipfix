function addmSummaryDescCell(desc, idx, onDone){
var L = (window.CUR_LANG || 'en');
var o = tlObj(desc);
var cur = _tlCleanZero(o[L] || '');
if (cur) return { text: cur, translated: false };
var src = _tlCleanZero(o.zh || o.en || o.vi || '');
if (!src) return { text: '', translated: false };
if (typeof ptTranslateText !== 'function' || !navigator.onLine) return { text: src, translated: false };
var cacheKey = src + '\u2192' + L;
if (!window.__addmSumTrans) window.__addmSumTrans = {};
if (window.__addmSumTrans[cacheKey]) return { text: window.__addmSumTrans[cacheKey], translated: true };
ptTranslateText(src, L).then(function(res){
if (!res) return;
window.__addmSumTrans[cacheKey] = res;
if (typeof onDone === 'function') onDone(res);
}).catch(function(){});
return { text: src, translated: true };
}



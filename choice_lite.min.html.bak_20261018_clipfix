var cwdParts = lib_pathParts(LIB_CWD), depth = cwdParts.length;
var files = [], map = {}, order = [];
(LIB_FILES||[]).forEach(function(f){
var parts = lib_pathParts(lib_relPath(f));
var fname = parts.pop();
if(!fname || parts.length < depth) return;
var match = true;
for(var i=0;i<depth;i++){ if(parts[i] !== cwdParts[i]){ match = false; break; } }
if(!match) return;
if(parts.length > depth){
var sub = parts[depth];
var path = lib_joinPath(LIB_CWD, sub);
var e = map[path];
if(!e){
e = map[path] = { type:'folder', name: sub, path: path, count:0, size:0, modified:'', uploader:'' };
order.push(path);
}
e.count++;
e.size += (f.size || 0);
var d = String(f.created_at || '');
if(d > e.modified) e.modified = d;
if(f.uploader) e.uploader = f.uploader;
} else {
files.push(f);
}
});
var folders = order.map(function(k){ return map[k]; });
folders.sort(function(a,b){ return String(a.name).localeCompare(String(b.name)); });
return { folders: folders, files: lib_sortFiles(files), search: false };
}


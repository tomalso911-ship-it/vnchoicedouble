function _commCellFitWidth(cell){
if (!cell) return 0;

var btn = cell.querySelector ? cell.querySelector('.btn-action-sm') : null;
if (btn){
var r = btn.getBoundingClientRect();
if (r.width > 0) return Math.round(r.width) + 12;
}
var txt = (cell.innerText || cell.textContent || '').trim();
if (!txt) return 0;
var cs = window.getComputedStyle(cell);
var pl = parseFloat(cs.paddingLeft) || 0, pr = parseFloat(cs.paddingRight) || 0;
return Math.round(_textWidth(txt, cell) + pl + pr + 6);
}
function autoFitCommissionTable(){
var tbl = document.getElementById('commissionTable');
var cg = document.getElementById('commissionCols');
if (!tbl || !cg) return;
var cols = cg.querySelectorAll('col');
var n = cols.length;
if (!n) return;


for (var c = 0; c < n; c++) cols[c].style.width = '';
tbl.style.width = '';


var headRows = tbl.querySelectorAll('thead tr');
var grid = [];
for (var r = 0; r < headRows.length; r++){
grid[r] = [];
var cells = headRows[r].children, ci = 0;
for (var a = 0; a < cells.length; a++){
var cell = cells[a];
while (grid[r][ci]) ci++;
var cspan = parseInt(cell.getAttribute('colspan') || '1', 10) || 1;
var rspan = parseInt(cell.getAttribute('rowspan') || '1', 10) || 1;
for (var rr = 0; rr < rspan; rr++){
if (!grid[r + rr]) grid[r + rr] = [];
for (var cc = 0; cc < cspan; cc++) grid[r + rr][ci + cc] = cell;
}
ci += cspan;
}
}


var widths = [];
for (var c0 = 0; c0 < n; c0++) widths[c0] = 0;
function _take(cell, cIdx, span){
var w = _commCellFitWidth(cell);
if (!w) return;
var per = span > 1 ? Math.ceil(w / span) : w;    // colspan 表头：宽度均摊到各列
for (var s = 0; s < span; s++){
if (cIdx + s < n && per > widths[cIdx + s]) widths[cIdx + s] = per;
}
}
for (var hr = 0; hr < grid.length; hr++){
for (var hc = 0; hc < n; hc++){
var th = grid[hr] ? grid[hr][hc] : null;
if (!th) continue;
var span = parseInt(th.getAttribute('colspan') || '1', 10) || 1;
_take(th, hc, span);
hc += span - 1;
}
}
var bodyRows = tbl.querySelectorAll('tbody tr');
for (var br = 0; br < bodyRows.length; br++){
var tds = bodyRows[br].children;
if (tds.length <= 1) continue;
for (var bc = 0; bc < tds.length && bc < n; bc++) _take(tds[bc], bc, 1);
}


var total = 0;
for (var c1 = 0; c1 < n; c1++){
var w = Math.max(64, Math.min(320, Math.ceil(widths[c1])));
cols[c1].style.width = w + 'px';
total += w;
}
tbl.style.width = total + 'px';
tbl.style.minWidth = '100%';


var wrap = document.getElementById('commissionTableWrap');
if (wrap){
var top = wrap.getBoundingClientRect().top;

if (top > 0){
var dataRowCount = 0;
for(var br=0;br<bodyRows.length;br++){ if(bodyRows[br].children.length > 1) dataRowCount++; }
if(dataRowCount <= 10){
wrap.style.maxHeight = 'none';
} else {
wrap.style.maxHeight = Math.max(240, Math.round(window.innerHeight - top - 24)) + 'px';
}
}
}

if (headRows[0] && headRows[1]){
var h1 = headRows[0].getBoundingClientRect().height;
if (h1 > 0){
var ths2 = headRows[1].children;
for (var k = 0; k < ths2.length; k++) ths2[k].style.top = Math.round(h1) + 'px';
}
}
}


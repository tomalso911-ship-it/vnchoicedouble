var n=addmParseNum(rawVal);
var r=addmGetRates();
var vnd=0;
if(oneCur==='rmb') vnd=n*r.rmb_vnd;
else if(oneCur==='usd') vnd=n*r.usd_vnd;
else if(oneCur==='vnd') vnd=n;
else return;
if(oneCur!=='rmb') rows[idx].amt_rmb= Math.round(vnd/r.rmb_vnd);
if(oneCur!=='usd') rows[idx].amt_usd= Math.round(vnd/r.usd_vnd);
if(oneCur!=='vnd') rows[idx].amt_vnd= Math.round(vnd);
}



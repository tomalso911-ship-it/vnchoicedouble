var c = document.createElement('script');
c.src = cdn;
c.onload = function(){ LIB_VENDOR_LOADED[url] = true; if(cb) cb(); };
c.onerror = function(){ if(fail) fail(); };
document.head.appendChild(c);
};
document.head.appendChild(s);
}

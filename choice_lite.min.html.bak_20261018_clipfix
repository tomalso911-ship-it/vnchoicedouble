var dateLike = text.match(/\b\d{1,4}[-/]\d{1,2}[-/]\d{1,4}\b/g) || [];
dateLike.forEach(function(m){
if(!/^\d{2}[-/.]\d{2}[-/.]\d{4}$/.test(m)) console.warn('[date-fmt-guard] 检测到非 DD/MM/YYYY 日期: "'+m+'"（应按约定统一为 DD/MM/YYYY）');
});
}



function _ovNum(v){ v=parseFloat(v); return isFinite(v)?v:0; }
function _ovFmt(n, decimals){
n = (n||0);
if (decimals === undefined || decimals === null) {
var cur = (typeof dashCur !== 'undefined' && dashCur) ? dashCur : 'RMB';
decimals = (cur === 'VND') ? 0 : 2;
}
return n.toLocaleString(undefined, {minimumFractionDigits: decimals, maximumFractionDigits: decimals});
}
function _ovMoneyShort(v, sym){

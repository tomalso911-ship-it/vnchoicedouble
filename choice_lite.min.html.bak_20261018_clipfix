function getRates() {
var rmbVnd = stripToNumber(el('w_rate_rmb_vnd').value) || 1;
var usdVnd = stripToNumber(el('w_rate_usd_vnd').value) || 1;
return { rmbVnd: rmbVnd, usdVnd: usdVnd };
}

function convertFromRMB(rmbVal) {
var rates = getRates();
var rmb = moneyToNumber(rmbVal);
var usd = rates.rmbVnd > 0 ? Math.round(rmb * rates.rmbVnd / rates.usdVnd) : 0;
var vnd = rmb * rates.rmbVnd;
return { rmb: rmb, usd: usd, vnd: vnd };
}

function convertFromUSD(usdVal) {
var rates = getRates();
var usd = moneyToNumber(usdVal);
var rmb = rates.usdVnd > 0 ? Math.round(usd * rates.usdVnd / rates.rmbVnd) : 0;
var vnd = usd * rates.usdVnd;
return { rmb: rmb, usd: usd, vnd: vnd };
}

function convertFromVND(vndVal) {
var rates = getRates();
var vnd = moneyToNumber(vndVal);
var rmb = rates.rmbVnd > 0 ? Math.round(vnd / rates.rmbVnd) : 0;
var usd = rates.usdVnd > 0 ? Math.round(vnd / rates.usdVnd) : 0;
return { rmb: rmb, usd: usd, vnd: vnd };
}



var ticks=[];
function addMonths(d,n){ var x=new Date(d); x.setMonth(x.getMonth()+n); return x; }
if(scale==='month'){
var t=new Date(min.getFullYear(), min.getMonth(), 1);
while(t<=max){ ticks.push(new Date(t)); t=addMonths(t,1); }
} else if(scale==='week'){
var t2=new Date(min); var dow=(t2.getDay()+6)%7; t2.setDate(t2.getDate()-dow);
while(t2<=max){ ticks.push(new Date(t2)); t2.setDate(t2.getDate()+7); }
} else {
var t3=new Date(min); t3.setHours(0,0,0,0);

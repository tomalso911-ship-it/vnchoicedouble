var INST_WX_BACKFILLING = false, INST_WX_BACKFILL_AT = 0;
function inst_backfillWeather(force){
if(!INST_CUR || INST_WX_BACKFILLING) return;
if(!force && Date.now() - INST_WX_BACKFILL_AT < 300000) return;
var prov = inst_provKey(); if(!prov) return;
var f = inst_get(INST_CUR); f.installation = f.installation || {}; f.installation.workers = f.installation.workers || {};
var today = prod_today();
var missing = [];
Object.keys(f.installation.workers).forEach(function(dd){
var ymd = dmyToYmd(dd); if(!ymd || ymd >= today) return;
var w = f.installation.workers[dd]; if(!w || w._deleted) return;
if((!w.weatherAm || w.weatherAm.v!==2) || (!w.weatherPm || w.weatherPm.v!==2)) missing.push({dd:dd, ymd:ymd});
});
if(!missing.length) return;
missing.sort(function(a,b){ return a.ymd.localeCompare(b.ymd); });
var start = missing[0].ymd, end = missing[missing.length-1].ymd;
if(typeof prodLoadWeatherArchive!=='function') return;
INST_WX_BACKFILL_AT = Date.now();
INST_WX_BACKFILLING = true;
prodLoadWeatherArchive(prov, start, end, function(hr){
INST_WX_BACKFILLING = false;
if(!hr) return;
var ch = false;
missing.forEach(function(m){
var w = f.installation.workers[m.dd];
var am = (typeof prodWxFromHourly==='function' && typeof prodHourIdx==='function') ? prodWxFromHourly(hr, prodHourIdx(hr, m.ymd, '09')) : null;
var pm = (typeof prodWxFromHourly==='function' && typeof prodHourIdx==='function') ? prodWxFromHourly(hr, prodHourIdx(hr, m.ymd, '14')) : null;
if(am && (!w.weatherAm || w.weatherAm.v!==2)){ w.weatherAm = am; ch = true; }
if(pm && (!w.weatherPm || w.weatherPm.v!==2)){ w.weatherPm = pm; ch = true; }
});
if(ch){ inst_save(f); if(INST_ACTIVE_TAB==='C') inst_renderTab('C'); }
});
}



function inst_tabCMissingCount(){
var f = inst_get(INST_CUR); if(!f || !f.installation || !f.installation.workers) return 0;
var workers = f.installation.workers, count = 0;
for(var d in workers){ if(!workers.hasOwnProperty(d)) continue;
var w = workers[d]; if(!w || w.holiday === 'yes' || w._deleted) continue;
var allZero = true;
INST_ROLES.forEach(function(rk){ if(rk[0]==='reporter' || rk[0]==='leader') return; if((+w[rk[0]]||0) !== 0){ allZero = false; } });
if(allZero) count++;
}
return count;
}

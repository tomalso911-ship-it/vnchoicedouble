var _commSortList = [];
var _commSortOriginal = null;
var COMM_SORT_NUMERIC = { equipRMB:1, equipUSD:1, equipVND:1 };
function commSort(key, withCtrl){
withCtrl = !!withCtrl && (typeof event !== 'undefined' ? event.ctrlKey : false);
if (key === 'no') return;

var idx = -1;
for (var i = 0; i < _commSortList.length; i++){
if (_commSortList[i].key === key){ idx = i; break; }
}
if (idx >= 0 && !withCtrl){

if (_commSortList[idx].asc){
_commSortList[idx].asc = false;
} else {
_commSortList.splice(idx, 1);
}
} else if (idx >= 0 && withCtrl){

_commSortList[idx].asc = !_commSortList[idx].asc;
} else {

if (withCtrl){
_commSortList.push({ key: key, asc: true });
} else {
_commSortList = [{ key: key, asc: true }];
}
}
applyCommSort();
}

function applyCommSort(){
if (_commSortList.length === 0){

if (_commSortOriginal && _commSortOriginal !== COMM_RECORDS){
COMM_RECORDS.splice(0, COMM_RECORDS.length);
for (var i = 0; i < _commSortOriginal.length; i++) COMM_RECORDS.push(_commSortOriginal[i]);
}
_commSortOriginal = null;
updateCommSortIndicators();
renderCommission();
return;
}
if (!_commSortOriginal){

_commSortOriginal = COMM_RECORDS.slice();
}
var list = _commSortList.slice();
COMM_RECORDS.sort(function(a, b){
for (var k = 0; k < list.length; k++){
var s = list[k];
var num = COMM_SORT_NUMERIC[s.key];
var c;
if (num){
var x = parseFloat(a[s.key]), y = parseFloat(b[s.key]);
var xa = isFinite(x) ? x : -Infinity, ya = isFinite(y) ? y : -Infinity;
c = s.asc ? xa - ya : ya - xa;
} else {
var sa = String(a[s.key] == null ? '' : a[s.key]);
var sb = String(b[s.key] == null ? '' : b[s.key]);
c = sa.localeCompare(sb, 'zh-Hans-CN', { numeric: true });
if (!s.asc) c = -c;
}
if (c !== 0) return c;
}
return 0;
});
updateCommSortIndicators();
renderCommission();
}


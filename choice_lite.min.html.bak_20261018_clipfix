if(ch){ f.installation.workers[tk] = clone; inst_save(f); if(typeof INST_ACTIVE_TAB!=='undefined' && INST_ACTIVE_TAB==='C') inst_renderTab('C'); }
});
}
}

function inst_copyWorkers(dd){
if(!dd) return;
var f = inst_get(INST_CUR); if(!f) return;
f.installation = f.installation || {}; f.installation.workers = f.installation.workers || {};
var workers = f.installation.workers;
var src = workers[dd]; if(!src) return;
var tk = prod_prevDateDmy(dd);
var guard = 0;
while(workers[tk] && guard < 3650){ tk = prod_prevDateDmy(tk); guard++; }
if(!tk) return;

var startDmy = (typeof inst_getInstallStart==='function') ? inst_getInstallStart() : '';
var startYmd = startDmy ? dmyToYmd(startDmy) : '';
if(startYmd && dmyToYmd(tk) < startYmd){
try{ prod_toast(it('inst_copy_before_start')); }catch(e){ alert(it('inst_copy_before_start')); }
return;
}
var ymd = dmyToYmd(tk);
var over = inst_copyOverflowCheck(f, src, tk);
if(over.length){
var overTotal = over.reduce(function(a,b){ return a + b.over; }, 0);
instShowCopyConfirm(overTotal,
function(){ inst_copyDo(f, src, tk, ymd, true, false); },
function(){ inst_copyDo(f, src, tk, ymd, false, true); },
function(){ }
);
return;
}
inst_copyDo(f, src, tk, ymd, false, false);
}

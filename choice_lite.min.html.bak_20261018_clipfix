}
return fetch('https://api.mymemory.translated.net/get?q=' + encodeURIComponent(text) + '&langpair=' + encodeURIComponent(_mmSrc(text)+'|'+_mmTgt(target)))
.then(function(r){

if (r.status === 429) { window.__mmCool = Date.now() + 5 * 60 * 1000; }
if (!r.ok) throw new Error('mm-' + r.status);
return r.json();
})
.then(function(d){

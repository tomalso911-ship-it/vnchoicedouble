function _tlCleanZero(v){ var s=(v==null?'':String(v)); return (s.trim()==='0') ? '' : s; }

function rmFillFromData(base, p){
var pre = base === RM_CRM_BASE ? 'c_' : 'w_';
var zh = _tlCleanZero(p[base+'_zh']), en = _tlCleanZero(p[base+'_en']), vi = _tlCleanZero(p[base+'_vi']);


if (!zh && !en && !vi) {
var rawBase = p && p[base];
var baseStr = typeof rawBase === 'string' ? rawBase.trim() : '';
if (baseStr && baseStr.charAt(0) !== '{') {
var L = window.CUR_LANG || 'en';
var old = _tlCleanZero(rawBase);
if (L === 'zh') zh = old;
else if (L === 'vi') vi = old;
else en = old;
} else {
var o = tlObj(rawBase);
zh = o.zh; en = o.en; vi = o.vi;
}
}
var hz = el(pre+base+'_zh'), he = el(pre+base+'_en'), hv = el(pre+base+'_vi');
if (hz) hz.value = zh; if (he) he.value = en; if (hv) hv.value = vi;
var LANG = (window.CUR_LANG||'en');
var vis = el(rmVisibleId(base));
if (vis) vis.value = (LANG==='zh'?zh:(LANG==='vi'?vi:en));


if (base !== RM_CRM_BASE && typeof wonRemarkFillAll === 'function') wonRemarkFillAll(base);
else rmFillMissing(base);
}


function rmClear(base){

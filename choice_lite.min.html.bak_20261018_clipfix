return Math.floor(Date.UTC(yy, mm - 1, dd) / 86400000) + 25569;
}

var m = /^\s*(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})\s*$/.exec(t);
if (!m) return null;
var a = parseInt(m[1], 10), b = parseInt(m[2], 10), y = parseInt(m[3], 10);
if (m[3].length <= 2) y += (y < 70 ? 2000 : 1900);
var d, mo;

}


function inst_projectProgress(f){
var savedCur = INST_CUR, savedProd = (typeof PROD_CUR!=='undefined') ? PROD_CUR : undefined;
try{
INST_CUR = (f && f.id) || INST_CUR;
if(typeof PROD_CUR!=='undefined') PROD_CUR = INST_CUR;
var gh = inst_buildGanttHouses(f) || [];
var demand = 0, installed = 0;
gh.forEach(function(h){ demand += (+h.panels||0); installed += (+h.done||0); });
var produced = 0; var fn = (f && f.finished) || {};
for(var sp in fn){ if(fn.hasOwnProperty(sp)) produced += (+((fn[sp]&&fn[sp].produced)||0)); }
return {
demand: demand, installed: installed, produced: produced,
prodRate: demand > 0 ? produced/demand*100 : 0,
instRate: demand > 0 ? installed/demand*100 : 0
};
} finally {
INST_CUR = savedCur;
if(typeof PROD_CUR!=='undefined') PROD_CUR = savedProd;
}
}

function inst_totalWorkers(f){
var total = 0, date = '';
try{
var ws = ((f && f.installation) || {}).workers || {};
var dates = (typeof prod_sortDateKeys === 'function') ? prod_sortDateKeys(Object.keys(ws), false) : Object.keys(ws);
for(var i = dates.length - 1; i >= 0; i--){
var ww = ws[dates[i]]; if(!ww || ww._deleted) continue;
var sum = 0;
INST_ROLES.forEach(function(rk){ if(rk[0]==='reporter' || rk[0]==='leader') return; sum += (+ww[rk[0]]||0); });
if(sum > 0){ total = sum; date = dates[i]; break; }
}
}catch(e){}
return { total: total, date: date };
}

function cpPad(n) { return n < 10 ? '0' + n : '' + n; }
function cpFmtDDMMYYYY(y, m, d) { return cpPad(d) + '/' + cpPad(m + 1) + '/' + y; }
function cpParseDDMMYYYY(s) {
if (!s) return null;
var m = s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})$/);
return m ? { y: +m[3], m: +m[2] - 1, d: +m[1] } : null;
}
function cpDisplayDate(v) {
if (!v) return '';
if (/^\d{4}-\d{2}-\d{2}$/.test(v)) { var p = v.split('-'); return p[2] + '/' + p[1] + '/' + p[0]; }
return v;
}


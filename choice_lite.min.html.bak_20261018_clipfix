function ymdToDmy(ymd) { if(!ymd) return ''; var p=String(ymd).split(/[-/.]/); if(p.length!==3) return ymd; if(p[0].length===4) return p[2]+'/'+p[1]+'/'+p[0]; return ymd; }

function fmtDate(ymd){ return ymdToDmy(ymd); }
function parseYmd(ymd){
if(!ymd) return null;
var s = String(ymd).trim();
if(/^\d{4}[-/.]\d{1,2}[-/.]\d{1,2}$/.test(s)){ var p=s.split(/[-/.]/); return new Date(+p[0], +p[1]-1, +p[2]); }
if(/^\d{8}$/.test(s)){ return new Date(+s.substr(0,4), +s.substr(4,2)-1, +s.substr(6,2)); }
if(/^\d{1,2}[-/.]\d{1,2}[-/.]\d{4}$/.test(s)){ var q=s.split(/[-/.]/); return new Date(+q[2], +q[1]-1, +q[0]); }
return null;
}


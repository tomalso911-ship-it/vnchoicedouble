lib_loadVendor('/vendor/mammoth.browser.min.js', 'https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js', run, function(){ lib_viewFail(body); });
}
function lib_viewXlsx(url, body){
function run(){
fetch(url).then(function(r){ return r.arrayBuffer(); }).then(function(buf){
var wb = XLSX.read(new Uint8Array(buf), { type: 'array' });
var names = wb.SheetNames || [];
var wrap = document.createElement('div');
wrap.style.cssText = 'background:#fff;min-height:100%;';

function instShowDelConfirm(btn, dd, onConfirm){
var old = document.getElementById('instDelConfirmPop'); if(old) old.remove();
var prevPos = (window.__instActiveDel && window.__instActiveDel.pos) ? window.__instActiveDel.pos : null;
var pop = document.createElement('div'); pop.id = 'instDelConfirmPop'; pop.className = 'inst-del-pop';
pop.innerHTML = '<div class="inst-del-pop-hd" data-i18n="inst_confirm_del_title"></div>'+
'<div class="inst-del-pop-bd" data-i18n="inst_confirm_del"></div>'+
'<div class="inst-del-pop-ft">'+
'<button type="button" class="inst-del-pop-btn inst-del-pop-cancel" data-i18n="inst_btn_cancel"></button>'+
'<button type="button" class="inst-del-pop-btn inst-del-pop-ok" data-i18n="inst_btn_confirm"></button>'+
'</div>';
document.body.appendChild(pop);
inst_localizePop(pop);
window.__instActiveDel = {btn:btn, dd:dd, onConfirm:onConfirm, pos:null};
var width = pop.offsetWidth || 200, height = pop.offsetHeight || 120, left, top;
if(btn && btn.getBoundingClientRect){
var rect = btn.getBoundingClientRect();
left = rect.left; top = rect.bottom + 6;
if(left + width > window.innerWidth - 8) left = window.innerWidth - width - 8;
if(top + height > window.innerHeight - 8) top = rect.top - height - 6;
if(top < 8) top = 8;
} else if(prevPos){
left = prevPos.left; top = prevPos.top;
} else {
left = Math.max(8, (window.innerWidth - width) / 2);
top = Math.max(8, (window.innerHeight - height) / 2);
}
window.__instActiveDel.pos = {left:left, top:top};
pop.style.left = left + 'px'; pop.style.top = top + 'px';
function close(){ var p=document.getElementById('instDelConfirmPop'); if(p) p.remove(); document.removeEventListener('click', outside); document.removeEventListener('keydown', esc); window.__instActiveDel = null; }
function outside(e){ if(e.target!==btn && !pop.contains(e.target)){ if(e.target.closest && e.target.closest('#langSwitch, #loginLangSwitch, .lang-switch, .login-lang-switch')) return; close(); } }
function esc(e){ if(e.key==='Escape') close(); }
var okBtn = pop.querySelector('.inst-del-pop-ok');
var cancelBtn = pop.querySelector('.inst-del-pop-cancel');
okBtn.onclick = function(){ close(); if(onConfirm) onConfirm(); };
cancelBtn.onclick = close;
okBtn.focus();
setTimeout(function(){ document.addEventListener('click', outside); document.addEventListener('keydown', esc); }, 0);
}


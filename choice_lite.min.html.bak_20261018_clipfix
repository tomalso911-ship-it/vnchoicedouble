{ from: 'ovBuSalesChart', to: 'dashWonBuBarChart' },
{ from: 'ovPieBuAllChart', to: 'dashWonPieAllChart' },
{ from: 'ovPieBuAllChart', to: 'dashWonPieYearChart' },
{ from: 'ovPayGapChart', to: 'dashWonContractChart' },
{ from: 'ovCumPayChart', to: 'dashWonContractTotalChart' },
{ from: 'ovCommSummaryChart', to: 'dashWonCommTotalChart' },
{ from: 'ovCommYearChart', to: 'dashWonCommChart' }
];
var synced = 0;
var total = chartPairs.length;
chartPairs.forEach(function(pair){
var src = _ovChartsById[pair.from];
var dst = _ovChartsById[pair.to];
if(src && dst && src.data && dst.data){

dst.data.labels = src.data.labels ? src.data.labels.slice() : [];

dst.data.datasets = src.data.datasets ? src.data.datasets.map(function(ds){
var newDs = {};
for(var k in ds){
if(ds.hasOwnProperty(k)){
if(Array.isArray(ds[k])){
newDs[k] = ds[k].slice();
} else if(ds[k] && typeof ds[k] === 'object'){
newDs[k] = JSON.parse(JSON.stringify(ds[k]));
} else {
newDs[k] = ds[k];
}
}
}
return newDs;
}) : [];

dst.options = src.options ? JSON.parse(JSON.stringify(src.options)) : {};
dst.update();
synced++;
}
});


if (synced < total && _syncAttempts < _syncMaxAttempts) {
setTimeout(function() {
syncDashCrmCharts();
}, 300);
} else if (_syncAttempts >= _syncMaxAttempts) {
_syncAttempts = 0;
}
}



function _countryColor(code) {
if (_FEED_COUNTRY_COLORS[code]) return _FEED_COUNTRY_COLORS[code];

var h = 0;
for (var i = 0; i < code.length; i++) h = (h * 31 + code.charCodeAt(i)) >>> 0;
var base = (h % 360);
var hue = (base + 137.508 * (h % 17)) % 360;

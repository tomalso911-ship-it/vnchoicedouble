function lib_collectEntry(entry, prefix, cb){
if(!entry){ cb([]); return; }
if(entry.isFile){
entry.file(function(f){ cb([{file: f, path: prefix + f.name}]); }, function(){ cb([]); });
return;
}
if(entry.isDirectory){
var reader = entry.createReader(), all = [];
var readAll = function(){
reader.readEntries(function(ents){
if(!ents.length){
if(!all.length){ cb([]); return; }
var res = [], pending = all.length, done = false;
var fin = function(){ if(done) return; done = true; cb(res); };
all.forEach(function(ch){
lib_collectEntry(ch, prefix + entry.name + '/', function(list){
for(var z=0;z<list.length;z++) res.push(list[z]);
if(--pending === 0) fin();
});
});
return;
}
for(var i=0;i<ents.length;i++) all.push(ents[i]);
readAll();
}, function(){ cb([]); });
};
readAll();
return;
}
cb([]);
}


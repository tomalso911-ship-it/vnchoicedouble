function prodApprReceiptRecompute(){
if(typeof prodGetRates!=='function') return;
var r=prodGetRates(); var totV=0,totR=0,totU=0;
for(var i=0;i<200;i++){
var pvEl=document.getElementById('apr_rc_'+i+'_price'); if(!pvEl) break;
var pv=parseFloat(String(pvEl.value||'').replace(/[^0-9.\-]/g,''))||0;
var pqEl=document.getElementById('apr_rc_'+i+'_qty'); var pq=parseFloat(String((pqEl?pqEl.value:'0')||'').replace(/[^0-9.\-]/g,''))||0;
var subV=pv*pq; var subR=r.rmb?subV/r.rmb:0; var subU=r.usd?subV/r.usd:0;
totV+=subV; totR+=subR; totU+=subU;
var sv=document.getElementById('apr_rc_'+i+'_sv'); if(sv) sv.textContent=subV?prodFormatMoney(subV,'VND'):'';
var sr=document.getElementById('apr_rc_'+i+'_sr'); if(sr) sr.textContent=subR?prodFormatMoney(subR,'RMB'):'';
var su=document.getElementById('apr_rc_'+i+'_su'); if(su) su.textContent=subU?prodFormatMoney(subU,'USD'):'';
}
var tv=document.getElementById('apr_rc_total_v'); if(tv) tv.textContent=prodFormatMoney(totV,'VND');
var tr=document.getElementById('apr_rc_total_r'); if(tr) tr.textContent=prodFormatMoney(totR,'RMB');
var tu=document.getElementById('apr_rc_total_u'); if(tu) tu.textContent=prodFormatMoney(totU,'USD');
}
function prodApprReceiptResolve(id, action){
var x = APPROVAL_BY_ID[id]; if(!x) return;
var t=(typeof pt==='function')?pt:function(k){return k;};
var pl=null; try{ pl=JSON.parse(x.payload||'{}'); }catch(e){ pl={}; }
if(action==='approve'){
var rates=prodGetRates();
pl.rows=(pl.rows||[]).map(function(rw,i){
var g=function(suf){ var elx=document.getElementById('apr_rc_'+i+'_'+suf); return elx?elx.value:rw[suf]; };
var priceVnd=parseFloat(String(g('price')).replace(/[^0-9.\-]/g,''))||0;
var qty=parseFloat(String(g('qty')).replace(/[^0-9.\-]/g,''))||0;
var subV=priceVnd*qty;

var subR=rates.rmb?+(subV/rates.rmb).toFixed(2):(+(rw.subRmb||0));
var subU=rates.usd?+(subV/rates.usd).toFixed(2):(+(rw.subUsd||0));
return {material:rw.material, spec:String(g('spec')), unit:rw.unit, priceVnd:priceVnd, qty:qty, note:rw.note||'', noteTr:rw.noteTr||{zh:'',en:'',vi:''}, subVnd:Math.round(subV), subRmb:subR, subUsd:subU};
});
}
var me=(authUser&&authUser.username)||'';
function sendResolve(act, note){
return fetch('/api/approval-requests/'+id+'/resolve',{method:'POST',headers:{'Content-Type':'application/json'},
body:JSON.stringify({action:act, resolver:me, resolver_name:(authUser&&authUser.real_name)||me, note:note||''})})
.then(function(r){ return r.json().catch(function(){ return {ok:false}; }); });
}
function finish(){
if(action==='approve' && pl && pl.receiptId){ prodApprApplyInbound(pl); }
else if(action==='return' && pl && pl.receiptId){ prodApprMarkNeedEdit(pl); }
else if(action==='reject' && pl && pl.receiptId){ prodApprMarkReturned(pl); }
showToast(action==='approve' ? (t('toast_sent_approve')||'已通过')
: action==='return' ? (t('toast_receipt_need_edit')||'已返回重新填写')
: (t('appr_rejected')||'已驳回'));
closeApprovalDetail(); loadApprovals(); refreshPendBadge();
}
sendResolve(action, '').then(function(d){
if(d && d.ok){ finish(); return; }


if(action==='return'){
sendResolve('reject', 'RETURN_FOR_EDIT').then(function(d2){
if(d2 && d2.ok){ finish(); }
else showToast((d2&&d2.msg)||(d&&d.msg)||'操作失败');
}).catch(function(){ showToast('操作失败'); });
return;
}
showToast((d&&d.msg)||'操作失败');
}).catch(function(){ showToast('操作失败'); });
}

function prodApprLoadFactory(pid, cb){
var me=(authUser&&authUser.username)||'';
if(!me){ cb(prod_get(pid)); return; }
fetch('/api/prod-factory/'+encodeURIComponent(pid)+'?me='+encodeURIComponent(me))
.then(function(r){ return r.ok? r.json():null; })
.then(function(d){ cb((d && d.ok && d.data) ? d.data : prod_get(pid)); })
.catch(function(){ cb(prod_get(pid)); });
}

function prodApprEnsureReceipt(f, pl){
f.materials=f.materials||{items:[],inbound:[],outbound:[],receipts:[]};
var rec=(f.materials.receipts||[]).find(function(r){return r.id===pl.receiptId;});
if(!rec){
rec={id:pl.receiptId, date:pl.date||'', floors:pl.floors||[], houses:pl.houses||[], photos:pl.photos||[], rows:pl.rows||[], status:'pending', approvedBy:'', createdAt:''};
f.materials.receipts.push(rec);
}
return rec;
}
function prodApprApplyInbound(pl){
var pid=pl.project; if(!pid) return;
prodApprLoadFactory(pid, function(f){
if(!f) return;
var rec=prodApprEnsureReceipt(f, pl);
var r=prodGetRates();
rec.rows = (pl.rows||[]).map(function(rw){
var subV=(+rw.priceVnd||0)*(+rw.qty||0); rw.subVnd=Math.round(subV);

rw.subRmb = r.rmb ? +(subV/r.rmb).toFixed(2) : (+(rw.subRmb||0));
rw.subUsd = r.usd ? +(subV/r.usd).toFixed(2) : (+(rw.subUsd||0));
return rw;
});
rec.status='confirmed'; rec.approvedBy=(authUser&&authUser.username)||'';
rec.date=pl.date||rec.date; rec.floors=pl.floors||rec.floors; rec.houses=pl.houses||rec.houses; rec.photos=pl.photos||rec.photos;
f.materials.inbound=f.materials.inbound||[];
(pl.rows||[]).forEach(function(rw){
f.materials.inbound.push({date:rec.date, name:rw.material, qty:rw.qty, note:'收货确认: '+(rw.spec||'')+(rec.floors&&rec.floors.length?(' '+rec.floors.join('、')):'')});
});
prod_save(f); if(PROD_CUR===pid && typeof prod_renderTab==='function') prod_renderTab('D');
});
}
function prodApprMarkReturned(pl){
var pid=pl.project; if(!pid) return;
prodApprLoadFactory(pid, function(f){
if(!f) return;
var rec=prodApprEnsureReceipt(f, pl);
rec.status='returned';
prod_save(f); if(PROD_CUR===pid && typeof prod_renderTab==='function') prod_renderTab('D');
});
}

function prodApprMarkNeedEdit(pl){
var pid=pl.project; if(!pid) return;
prodApprLoadFactory(pid, function(f){
if(!f) return;
var rec=prodApprEnsureReceipt(f, pl);
rec.status='need_edit';
prod_save(f); if(PROD_CUR===pid && typeof prod_renderTab==='function') prod_renderTab('D');
});
}

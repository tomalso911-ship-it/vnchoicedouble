#!/bin/sh
# 「锁死」契约检查（git pre-commit 钩子）
#
# 目前锁定的契约：
#   1) check_modal_format.py   —— 模态框放大态 .mmax 几何唯一、无特例覆盖、入口唯一
#   2) check_print_logic.py    —— 打印逻辑（甘特左右两栏/一页装下、智能报告块级流/兜底目标、
#                                 打印标记生命周期），见 choice_lite.html 中 [FROZEN 契约 · 打印]
#   3) check_fin_hi_lock.py    —— 财务表屏幕高亮锁死区（FIN-HI-LOCK-20261011）：
#                                 ① 高亮写入必须开静默窗口 finHiQuietUntil（不得触发自动保存）
#                                 ② fin_inlineStyles 只能在克隆副本上剥离红+粗，绝不碰实时样式库
#                                 ③ finHiRecompute 行号没变也要抽查红+粗，被洗掉即自愈补回
#                                 ④ 高亮是纯屏幕效果，保存副本里必须已剥离红+粗
#   4) check_fin_excel_keys_lock.py
#                              —— 财务 Univer「Excel 键盘行为补丁」锁死区
#                                 （FIN-EXCEL-KEYS-LOCK-20261011）：
#                                 ① window 捕获阶段监听 + 幂等 + 只在 Univer 内生效（认 .univer-editor）
#                                 ② 编辑态只补 Delete（doc.command.delete-right），其余交回 Univer
#                                 ③ 边界只用 finSheetSize()，基准只用按键前快照 finPrevCur，撤销回卷
#                                 ④ 算不出边界/量不到行数必须交回 Univer，绝不吞键
#                                 ⑤ finExcelKeysBind() 必须绑在 finReady = true; 之前
#                                 ⑥ 必须与验证床 _univer_kb_fix.html 逐行一致（改后跑 python _port_fin_keys.py）
#
#   以上四条是【硬锁】（代码逻辑，静态扫描 HTML，失败即拦截提交，禁止篡改）。
#
#   5) check_fin_snap_cache.py —— 财务 Univer 快照缓存（FIN-SNAP-CACHE-20261011）：
#                                 ① 缓存键 = 源 xlsx 的 mtime + size（缺一必误命中）
#                                 ② 三个写入点都必须 _fin_cache_invalidate()
#                                 ③ 写缓存必须原子（.tmp + os.replace），且先数据文件后键文件
#                                 ④ GET 必须走缓存判定，不得再直接 xlsx_to_univer
#                                 ⑤ 出缓存必须 conditional=True（重复加载退化为 304）
#                                 ⑥ 必须带内容指纹 .fp 并逐次校验（FIN-SNAP-FP-20261015）
#                                    —— 防"绕过转换器手改快照再被命中下发"（#VALUE! 血案）
#
#   7) check_fin_no_trans_lock.py —— 财务「品牌名不翻译」锁死区（FIN-NO-TRANS-20261013）：
#                                 ① 前端 FIN_NO_TRANS / fin_hasNoTrans（大小写无关子串匹配）
#                                 ② 三条使用点：fin_transChecked 退回原文 / fin_targetName 退回原名 /
#                                    fin_requestTrans 对含保护词的文字不发翻译请求
#                                 ③ 服务端 _FIN_NO_TRANS + fin_translate「译丢保护词就退回原文」
#                                 ④ 落地数据：fin_sheet_titles.json / fin_trans_cache.json 里
#                                    'Thu Dabaco' 的译文必须仍含 Dabaco，且不得再出现「达巴科」
#
#   8) check_prod_date_rule.py —— 生产操作日期 ≥ 排产开始日期（数据一致性巡检）
#   9) check_prod_out_rule.py  —— 出库量 ≤ 当前生产总量（数据一致性巡检）
#
#   10) check_fin_formula_lock.py —— 财务 Univer sheets-formula「bufferWhen 爆栈防护」锁死区
#                                  （FIN-FORMULA-STACK-20261013）：
#                                  ① importmap 必须把 @univerjs/sheets-formula 指到 preset-sheets-core
#                                     内部引用的同一个文件 URL（否则浏览器加载第二个模块实例 →
#                                     DI token 不同 → 补丁打在错的类上，控制台依旧爆栈）
#                                  ② importmap 必须有 "rxjs" → /rxjs@>=7.0.0?target=es2022（同一份 rxjs）
#                                  ③ fin_patchFormulaService 必须：包 _initFormulaRegister、把
#                                     calculateStarted$ 换成「无回放转发外壳」、外壳 pipe 前插 skip(1)
#                                     （★核心一行，删掉即复发 max call stack）、orig.call(self) 调回原实现
#                                  ④ 打补丁【必须早于】presets.createUniver(...)：服务的构造函数在其内部跑
#                                  ⑤ 自检 fin_formulaSafeCheck 只在原型上查标记，不得早调 injector.get()
#                                     （单元未建/服务未注册时 redi 会抛 required dependency items）
#
#   11) check_fin_cn_lock.py —— 中国财务报表「统计栏 + 保存不丢」锁死区
#                                 （FIN-CN-STAT-LOCK-20261013）：
#                                 ① 统计栏必须从【命令流 set-selections】取全部选区
#                                    （门面 getSelection() 这版只给一格 → 拉选一整段仍显示 计数:1）
#                                 ② 统计栏必须【逐格去重】（selections 带"整块+锚点"，不去重会算两遍）
#                                 ③ 挂起窗口内的改动必须【defer】不是 drop
#                                    （旧实现 `if (Date.now() < finCnHoldUntil) return;` 会把勾选核销
#                                      / 录入数字永久丢掉；另需 2 秒看门狗兜底）
#                                 ④ 保存异步 2~4 秒：只有 finDirtyGen 代数没变才允许清 finDirty
#                                    （旧实现无条件清 → 保存期间的新勾选被静默吞掉）
#                                 ⑤ 服务端 CN-BASIS-GUARD 金额守卫（勿移除）：÷3882 换算污染 /
#                                    三块不同量级 一律拒收落盘、保留服务器文件
#                                 ⑥ 归一化必须原子落盘 _cn_ws_save_atomic（禁止就地 wb.save）
#                                    ⑦ 前端三块对账 FIN-CN-TRI-CONSIST（基准块被污染后能自愈）
#
#   后两条是【数据一致性巡检】：扫描 agi_pm.db，专门抓绕过前端（旧草稿/手工改库）写入的非法记录。
#   它们以【警告】形式运行，不阻断提交（避免历史遗留脏数据阻塞正常推送）；
#   但会在提交时打印，便于及时发现并修复。CI 中建议作为独立步骤做硬阻断。
#
# 激活方式（本仓库已用 core.hooksPath=.githooks 启用）：
#   git config core.hooksPath .githooks
#
# 也可在 CI 中单独执行：python check_modal_format.py / python check_print_logic.py
# （退出码非 0 即构建失败。）
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$ROOT" ] || ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "未找到 python，跳过契约检查（请安装 Python 后重试）。"
  exit 0
fi

# ===== 硬锁：静态 HTML 契约，失败即拦截 =====
rc=0
for f in check_modal_format.py check_print_logic.py check_fin_hi_lock.py check_fin_excel_keys_lock.py check_fin_snap_cache.py check_fin_no_trans_lock.py check_fin_formula_lock.py check_fin_cn_lock.py; do
  if [ -f "$f" ]; then
    echo "— 契约检查（硬锁）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f"; then
      echo "✗ 提交被拦截：$f 未通过（契约被破坏），请修复后再提交。"
      rc=1
    fi
  fi
done

# ===== 软告警：生产业务规则数据一致性巡检，仅提示不阻断 =====
for f in check_prod_date_rule.py check_prod_out_rule.py; do
  if [ -f "$f" ]; then
    echo "— 业务规则巡检（警告）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f" >/dev/null 2>&1; then
      echo "  ⚠ $f 发现可疑记录（历史遗留数据，未阻断提交；请尽快修复）。"
    fi
  fi
done

exit $rc

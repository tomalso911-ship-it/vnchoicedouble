#!/bin/sh
# 「锁死」契约检查（git pre-commit 钩子）
#
# 目前锁定的契约：
#   1) check_modal_format.py   —— 模态框放大态 .mmax 几何唯一、无特例覆盖、入口唯一
#   2) check_print_logic.py    —— 打印逻辑（甘特左右两栏/一页装下、智能报告块级流/兜底目标、
#                                 打印标记生命周期），见 choice_lite.html 中 [FROZEN 契约 · 打印]
#
#   以上两条是【硬锁】（代码逻辑，静态扫描 HTML，失败即拦截提交，禁止篡改）。
#
#   3) check_prod_date_rule.py —— 生产操作日期 ≥ 排产开始日期（数据一致性巡检）
#   4) check_prod_out_rule.py  —— 出库量 ≤ 当前生产总量（数据一致性巡检）
#
#   后两条是【数据一致性巡检】：扫描 agi_pm.db，专门抓绕过前端（旧草稿/手工改库）写入的非法记录。
#   它们以【警告】形式运行，不阻断提交（避免历史遗留脏数据阻塞正常推送）；
#   但会在提交时打印，便于及时发现并修复。CI 中建议作为独立步骤做硬阻断。
#
# 激活方式（本仓库已用 core.hooksPath=.githooks 启用）：
#   git config core.hooksPath .githooks
#
# 也可在 CI 中单独执行：python check_modal_format.py / python check_print_logic.py
# （退出码非 0 即构建失败。）
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$ROOT" ] || ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "未找到 python，跳过契约检查（请安装 Python 后重试）。"
  exit 0
fi

# ===== 硬锁：静态 HTML 契约，失败即拦截 =====
rc=0
for f in check_modal_format.py check_print_logic.py; do
  if [ -f "$f" ]; then
    echo "— 契约检查（硬锁）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f"; then
      echo "✗ 提交被拦截：$f 未通过（契约被破坏），请修复后再提交。"
      rc=1
    fi
  fi
done

# ===== 软告警：生产业务规则数据一致性巡检，仅提示不阻断 =====
for f in check_prod_date_rule.py check_prod_out_rule.py; do
  if [ -f "$f" ]; then
    echo "— 业务规则巡检（警告）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f" >/dev/null 2>&1; then
      echo "  ⚠ $f 发现可疑记录（历史遗留数据，未阻断提交；请尽快修复）。"
    fi
  fi
done

exit $rc

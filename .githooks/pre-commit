#                                     calculateStarted$ 换成「无回放转发外壳」、外壳 pipe 前插 skip(1)
#                                     （★核心一行，删掉即复发 max call stack）、orig.call(self) 调回原实现
#                                  ④ 打补丁【必须早于】presets.createUniver(...)：服务的构造函数在其内部跑
#                                  ⑤ 自检 fin_formulaSafeCheck 只在原型上查标记，不得早调 injector.get()
#                                     （单元未建/服务未注册时 redi 会抛 required dependency items）
#
#   11) check_fin_cn_lock.py —— 中国财务报表「统计栏 + 保存不丢」锁死区
#                                 （FIN-CN-STAT-LOCK-20261013）：
#                                 ① 统计栏必须从【命令流 set-selections】取全部选区
#                                    （门面 getSelection() 这版只给一格 → 拉选一整段仍显示 计数:1）
#                                 ② 统计栏必须【逐格去重】（selections 带"整块+锚点"，不去重会算两遍）
#                                 ③ 挂起窗口内的改动必须【defer】不是 drop
#                                    （旧实现 `if (Date.now() < finCnHoldUntil) return;` 会把勾选核销
#                                      / 录入数字永久丢掉；另需 2 秒看门狗兜底）
#                                 ④ 保存异步 2~4 秒：只有 finDirtyGen 代数没变才允许清 finDirty
#                                    （旧实现无条件清 → 保存期间的新勾选被静默吞掉）
#                                 ⑤ 服务端 CN-BASIS-GUARD 金额守卫（勿移除）：÷3882 换算污染 /
#                                    三块不同量级 一律拒收落盘、保留服务器文件
#                                 ⑥ 归一化必须原子落盘 _cn_ws_save_atomic（禁止就地 wb.save）
#                                    ⑦ 前端三块对账 FIN-CN-TRI-CONSIST（基准块被污染后能自愈）
#
#   12) check_fin_cn_hide_checked_lock.py —— 中国报表「隐藏核销记录」按钮锁死区
#                                 （FIN-CN-HIDE-CHECKED-20261015）：
#                                 ① 三语 key fin_btn_hide_checked / fin_btn_show_checked 各 3 份
#                                 ② 按钮 id=fin_cn_hide_checked_btn，位置在「查报表」与「导出 xlsx」之间
#                                 ③ 仅中国报表显示（fin_applyReadonlyUI 按 isCn 显隐）+ 刷新文案
#                                 ④ 调用必须在 fin_rptHideInView 之前（后跑者优先）
#                                 ⑤ 只写显示快照 rowData[行].hd=1（克隆），恢复 delete .hd，
#                                    ★绝不碰 cellData、绝不删数据
#
#   13) check_fin_merge_cn_blue_lock.py —— 合并报表「中国区块蓝字守卫」锁死区
#                                 （FIN-MERGE-CN-BLUE-GUARD-20261015）：
#                                 ① 只在合并报表 + 「中国成本独立显示」分组状态生效
#                                 ② 中国区块行号取 __FIN_MERGE_CN_ROWBASE/ROWS（AN 列已被裁掉）
#                                 ③ ★红高亮行整行不碰（按 finHiState + 红字两条判），
#                                    用户 2026-10-15 选 A：保留"离今天最近那一行"的红高亮
#                                 ④ 静默写入（finHiApplying + finHiQuietUntil），只换字色 cl
#                                 ⑤ 必须排在高亮之后兜底调用（载入块 + 2 秒轮询 + 两条重建路径）
#                                 ⑥ 两条重建路径（fin_loadReport / fin_applySnapshot）
#                                    必须清空陈旧高亮坐标 finHiState（否则撤高亮按旧行号
#                                    把分组后的中国行写成黑色 = 2026-10-15 的 BUG 根因）
#
#   14) check_fin_keep_sheet_lock.py —— 「重建后留在用户原来看的那张工作表」锁死区
#                                 （FIN-KEEP-SHEET-20261015，用户 2026-10-15 要求）：
#                                 ① fin_reload 必须【先记后重建】：fin_captureSheetState()
#                                    在 fin_applySnapshot(snap) 之前
#                                 ② 重建后必须 fin_restoreSheetState(keepSheet) 且补 ≥3 次
#                                    （首帧渲染会把表/滚动再跳一次）
#                                 ③ 合并报表强切「中国区块」只能由按钮触发：
#                                    __FIN_MERGE_FOCUS_CN 在 fin_mergeToggleCnGroup 置位、
#                                    在 fin_applySnapshot 消费并清零；查报表/复位/刷新不许强切
#                                 ④ 有强切标记时 fin_reload 的恢复必须让位
#                                 ⑤ 查报表确认必须仍走 fin_reload({keepFilter:true})
#                                 ⑥ 语言切换路径的 FIN-KEEP-SHEET-20261012 恢复不得被删
#
#   15) check_eq_cur_notrans_lock.py —— 股东权益报表「货币代码/货币对不翻译」锁死区
#                                 （EQ-CURR-NOTRANS-LOCK-20261016，用户 2026-10-16 要求）：
#                                 ① eqNoTransCur()：整格归一化后 = RMB/VND/USD，或由它们
#                                    用 - – — / \ | 组成的货币对（RMB-VND / USD/VND …）
#                                 ② needTrans 直接 return false（绝不发 /api/translate）
#                                 ③ transOf 直接 return null（缓存里已存过译文也不套用）
#                                 ④ requestTrans 直接回调 null（不发请求）
#                                 + loadTrans 清缓存脏译文（自愈）+ applyTrans 显式跳过（双保险）
#                                 落点：equity_report.xlsx「Đầu tư Trung Quốc」H3:L3
#                                 （H3=RMB I3=VND J3=USD K3=RMB-VND L3=USD-VND）
#
#   16) check_hscroll_lock.py —— 财务/股东权益 Univer「Excel 风格水平滚动条」锁死区
#                                 （FIN-HSCROLL-LOCK-20261017，用户 2026-10-17 要求锁死）：
#                                 ① 节点必须 append 到 document.body + id 复用
#                                    （挂容器里会被 Univer 重渲染清空 = "一拖就没"）
#                                 ② 驱动必须 FWorksheet.getScrollState() + scrollToCell(curRow, target)
#                                    ★第 1 参必须带当前 sheetViewStartRow，写 0 会把纵向重置到第 1 行
#                                 ③ ★禁止向 canvas 派发合成 WheelEvent（Univer 0.5.5 不认，
#                                    且与真滚动互相拉扯 = "拖了不动 / 闪烁跳动" 的历史根因）
#                                 ④ sheet.command.scroll-to-cell 只能作兜底，必须在 if (!ok) 之后
#                                 ⑤ visible 必须取 getVisibleRange()（固定 73px 会算出
#                                    visible>=total → 滑块撑满 → 拖不动）
#                                 ⑥ 拖拽状态/几何量必须外置到 bar.__hsState / __hsGeom
#                                    （轮询 400ms 重入新建闭包，函数内 var 会让 pointermove 读旧闭包）
#                                 ⑦ 拖动必须 requestAnimationFrame 合并 + 同列去重 + 定位防抖
#                                 ⑧ CSS：thumb 有 left/width 过渡，.fin-hs-drag 时 transition:none
#
#   17) check_clip_robust_lock.py —— 财务/股东权益 Ctrl+C / Ctrl+X / Ctrl+V 锁死区
#                                 （CLIP-ROBUST-LOCK-20261018，用户 2026-10-18 要求锁死）：
#                                 ① 两张表都必须注册 copy/cut 捕获阶段补写（finClipFill / eqClipFill）
#                                    —— 真机 http 下 execCommand 会「假成功」，setData 才是唯一稳定通道
#                                 ② __finClipPending 通道（execCommand 触发的那次 copy 直接落盘）
#                                 ③ 临时候选区必须在视口内且不得 ta.focus() 抢焦点
#                                 ④ 无条件再走一次 navigator.clipboard.writeText
#                                 ⑤ 剪切有清空兜底（fin_clipCutClearSoon / __eqClipCutClearSoon）
#                                 ⑥ C/X/V 补丁分支内不得 preventDefault / stopPropagation
#                                 ⑦ 复制内容必须经 win_fmtNum 还原屏幕文本（货币符号/千分位）
#                                 ⑧ 3 秒自检必须断言两条 copy 通道（__clipEvtFin / __clipEvtEq）
#
#   18) check_eq_geom_lock.py —— 股东权益「列宽/行高自由调整且永不回弹」+「权益版 bufferWhen 防护」
#                                 锁死区（EQ-GEOM-KEEP/STORE-20261018、FIN-FORMULA-STACK-20261018）：
#                                 ① render() 第一步必须 eqCaptureGeomToSnap()，且在 disposeUnit 之前
#                                 ② buildView() 之后、createUnit 之前必须 eqApplyGeomStore(v)
#                                 ③ localStorage 键仍是 'eq_geom_v1'
#                                 ④ eqApplyGeomStore 只许写 .w / .h，★绝不许碰 cellData
#                                 ⑤ eqCaptureGeomToSnap 必须记 w / h，★不许记 hd（查报表隐藏行）
#                                 ⑥ bindChange 必须在列宽/行高命令上记账（拖完立刻 F5 也不丢）
#                                 ⑦ eqUnitAlive 销毁后 false、建表后 true
#                                 ⑧ 权益那套独立 Univer 必须在自己的 createUniver 之前
#                                    await window.fin_ensureFormulaPatch()
#                                 ⑨ 财务侧必须暴露 __finFormulaMods + fin_ensureFormulaPatch
#                                 ⑩ 补丁核心 skip(1) 不得删
#
#   19) check_py_name_lock.py —— 后端 app.py【函数名/调用名一致性】硬锁
#                                 （PY-NAME-LOCK-20261026，线上 500 事故复盘）：
#                                 ① 顶层函数不得重名（除非刻意覆盖 —— 顶掉的那个必然失效）
#                                 ② 不得调用「app.py 里从未定义/赋值/导入」的私有名字
#                                 事故原样：中国报表每日备份函数被改名成 _fin_daily_backup，
#                                 既顶掉了越南报表的同名函数，又让三处 _cn_daily_backup() 变
#                                 NameError → POST /api/finance/cn-report/save 恒 500。
#                                 这类错误 compile 不报，只有跑到那行才炸，且发生在
#                                 os.replace 之后（数据已写、却报错），必须静态拦住。
#                                 反向测试：python _lock_reverse_test_pyname.py（5/5）
#
#   后两条是【数据一致性巡检】：扫描 agi_pm.db，专门抓绕过前端（旧草稿/手工改库）写入的非法记录。
#   它们以【警告】形式运行，不阻断提交（避免历史遗留脏数据阻塞正常推送）；
#   但会在提交时打印，便于及时发现并修复。CI 中建议作为独立步骤做硬阻断。
#
# 激活方式（本仓库已用 core.hooksPath=.githooks 启用）：
#   git config core.hooksPath .githooks
#
# 也可在 CI 中单独执行：python check_modal_format.py / python check_print_logic.py
# （退出码非 0 即构建失败。）
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[ -n "$ROOT" ] || ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT"

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "未找到 python，跳过契约检查（请安装 Python 后重试）。"
  exit 0
fi

# ===== 硬锁：静态 HTML 契约，失败即拦截 =====
rc=0
for f in check_modal_format.py check_print_logic.py check_fin_hi_lock.py check_fin_excel_keys_lock.py check_fin_snap_cache.py check_fin_no_trans_lock.py check_fin_formula_lock.py check_fin_cn_lock.py check_fin_cn_hide_checked_lock.py check_fin_merge_cn_blue_lock.py check_fin_keep_sheet_lock.py check_equity_lock.py check_eq_cur_notrans_lock.py check_hscroll_lock.py check_clip_robust_lock.py check_undo_everystep_lock.py check_eq_geom_lock.py check_py_name_lock.py; do
  if [ -f "$f" ]; then
    echo "— 契约检查（硬锁）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f"; then
      echo "✗ 提交被拦截：$f 未通过（契约被破坏），请修复后再提交。"
      rc=1
    fi
  fi
done

# ===== 软告警：生产业务规则数据一致性巡检，仅提示不阻断 =====
for f in check_prod_date_rule.py check_prod_out_rule.py; do
  if [ -f "$f" ]; then
    echo "— 业务规则巡检（警告）：$f"
    if ! PYTHONIOENCODING=utf-8 "$PY" "$f" >/dev/null 2>&1; then
      echo "  ⚠ $f 发现可疑记录（历史遗留数据，未阻断提交；请尽快修复）。"
    fi
  fi
done

exit $rc

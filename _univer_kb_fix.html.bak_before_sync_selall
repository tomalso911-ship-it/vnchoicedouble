<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>Univer 0.5.5 Excel 键盘补丁 验证床</title>
<script type="importmap">
{
  "imports": {
    "@univerjs/presets": "https://esm.sh/@univerjs/presets@0.5.5",
    "@univerjs/presets/": "https://esm.sh/@univerjs/presets@0.5.5/"
  }
}
</script>
<link rel="stylesheet" href="https://esm.sh/@univerjs/presets@0.5.5/lib/styles/preset-sheets-core.css">
<link rel="stylesheet" href="https://esm.sh/@univerjs/design@0.5.5/lib/index.css">
<link rel="stylesheet" href="https://esm.sh/@univerjs/ui@0.5.5/lib/index.css">
<style>
  body{margin:0;background:#fff;font-family:system-ui,Arial}
  #c{height:420px;border:1px solid #ddd}
</style>
</head>
<body>
<div id="c"></div>
<script>
window.__ready = false; window.__err = null;
(async function(){
  try {
    const presets  = await import('@univerjs/presets');
    const corePreset = await import('@univerjs/presets/preset-sheets-core');
    const localeMod = await import('@univerjs/presets/preset-sheets-core/locales/en-US');
    const en = (localeMod && (localeMod.default || localeMod)) || {};
    const snapshot = {
      id: 't', name: 't', sheetOrder: ['s1'],
      sheets: { s1: { id: 's1', name: 'S1', rowCount: 200, columnCount: 20,
        cellData: { '0': { '0': { v: 'A1' }, '1': { v: 'B1' } },
                    '1': { '0': { v: 11 } },
                    '2': { '0': { v: 22 } },
                    '3': { '0': { v: 'ABCDE' } },
                    '60': { '0': { v: 'LAST60' } } } } },
      styles: {}
    };
    const r = presets.createUniver({
      theme: presets.defaultTheme,
      locale: presets.LocaleType.EN_US,
      locales: { [presets.LocaleType.EN_US]: en },
      presets: [ corePreset.UniverSheetsCorePreset({ container: 'c' }) ]
    });
    window.presets = presets; window.u = r.univer; window.api = r.univerAPI;
    const UNIT = (presets.UniverInstanceType && presets.UniverInstanceType.UNIVER_SHEET) || 2;
    window.sheet = window.u.createUnit(UNIT, snapshot);
    window.__ready = true;
    // 补丁必须在 createUnit 之后绑定（此时 api 可用）
    try { finExcelKeysBind(); window.__fixBound = true; } catch(e){ window.__fixErr = String(e); }
  } catch (e) { window.__err = String((e && e.message) || e); }
})();
</script>

<script>
/* =========================================================================
   ★ Excel 键盘行为补丁（FIN-EXCEL-KEYS）—— 与 choice_lite.html 中保持同一份实现
   这里的 finUniverAPI 在测试页里用 window.api 兜底
   ========================================================================= */

/* ===================== ★ 锁死区 ★ FIN-EXCEL-KEYS-LOCK-20261011 =====================
   本补丁的契约常量 + 【行为级】自检。
   ★任何重构都不得删除、改名或弱化本区块，也不得移除 finExcelKeysBind() 末尾对
     finExcelKeysLockCheck() 的调用。
   为什么需要：本补丁每条规则都建立在「实测得来」的前提上（见下面各 ★ 注释），前提一旦
   被重构掉，症状是「Excel 手感又坏了」，但代码看起来依旧完整 —— 静态扫描发现不了，
   所以这里在运行时真的验证一遍：函数是否都在、接线是否成立、行列数/画布是否可取得。
   自检只报错（console.error + window.__FIN_EXCEL_KEYS_LOCK_FAILED），不抛异常、
   不影响表格使用。静态硬锁见仓库根 check_fin_excel_keys_lock.py + .githooks/pre-commit。
   ================================================================================== */
var FIN_EXCEL_KEYS_LOCK = {
  id: 'FIN-EXCEL-KEYS-LOCK-20261011',
  captureOnWindow: true,    /* 必须挂 window 捕获阶段：挂 document 会被 Univer 抢先 */
  editDeleteRight: true,    /* 编辑态 Delete = 删除光标右侧字符 */
  sheetSizeOnly: true,      /* 边界唯一来源 finSheetSize()，不得回退 getMaxRows() */
  snapshotBase: true,       /* Ctrl+方向键基准 = 「按键之前」的快照 finPrevCur */
  neverSwallow: true,       /* 算不出边界 / 量不到行数一律交回 Univer，绝不吞键 */
  boundFlag: '__finExcelKeysBound'
};

function finExcelKeysLockCheck(){
  var bad = [], warn = [];
  try {
    var need = {
      finExcelKeysBind: typeof finExcelKeysBind,
      finAPI: typeof finAPI,
      finSheetObj: typeof finSheetObj,
      finIsEditingCell: typeof finIsEditingCell,
      finActiveCell: typeof finActiveCell,
      finVisibleRange: typeof finVisibleRange,
      finScrollState: typeof finScrollState,
      finScrollTo: typeof finScrollTo,
      finScrollToSoon: typeof finScrollToSoon,
      finEnsureVisible: typeof finEnsureVisible,
      finLastUsedCell: typeof finLastUsedCell,
      finRowLastCol: typeof finRowLastCol,
      finSheetSize: typeof finSheetSize,
      finGridCanvas: typeof finGridCanvas,
      finPageRows: typeof finPageRows,
      finGotoCell: typeof finGotoCell,
      finDataEdge: typeof finDataEdge,
      finRememberCur: typeof finRememberCur,
      finRememberSoon: typeof finRememberSoon,
      finContainer: typeof finContainer
    };
    for (var k in need) { if (need[k] !== 'function') bad.push(k + ' 缺失'); }
    if (window[FIN_EXCEL_KEYS_LOCK.boundFlag] !== true) bad.push('未绑定（__finExcelKeysBound !== true）');
    if (FIN_EXCEL_KEYS_LOCK.id !== 'FIN-EXCEL-KEYS-LOCK-20261011') bad.push('契约常量 id 被改动');
    /* 有工作表才校验行列数；绑定时机早于 createUnit，无表时跳过（不误报） */
    try {
      var sz = finSheetSize();
      if (sz && (!(sz.rows > 0) || !(sz.cols > 0))) bad.push('finSheetSize() 异常: ' + JSON.stringify(sz));
    } catch(e1){ bad.push('finSheetSize() 抛错: ' + e1); }
    try {
      var c = finContainer();
      if (c && c.offsetHeight && !finGridCanvas()) warn.push('取不到主表格画布（PageUp/PageDown 可能失效）');
    } catch(e2){ warn.push('finGridCanvas() 抛错: ' + e2); }
  } catch(e){ bad.push('自检自身抛错: ' + e); }
  if (warn.length) { try { console.warn('[fin-keys] 锁死区告警：' + warn.join('；')); } catch(e5){} }
  if (bad.length) {
    window.__FIN_EXCEL_KEYS_LOCK_FAILED = bad.slice();
    try { console.error('✗ [FIN-EXCEL-KEYS-LOCK] 锁死区自检未通过：' + bad.join('；')); } catch(e3){}
    return false;
  }
  window.__FIN_EXCEL_KEYS_LOCK_OK = true;
  try { console.log('%c[fin-keys] 锁死区自检通过 FIN-EXCEL-KEYS-LOCK-20261011', 'color:#0a0;font-weight:bold'); } catch(e4){}
  return true;
}

function finAPI(){ try { return (typeof finUniverAPI !== 'undefined' && finUniverAPI) ? finUniverAPI : (window.finUniverAPI || window.api); } catch(e){ return window.api; } }

function finSheetObj(){
  try { var a = finAPI(); var wb = a && a.getActiveWorkbook && a.getActiveWorkbook(); return (wb && wb.getActiveSheet) ? wb.getActiveSheet() : null; } catch(e){ return null; }
}

/* 是否正在编辑单元格。
   ★不能看 document.activeElement：Univer 的输入宿主 .univer-editor 在非编辑态也是 activeElement（实测）。
   可靠判据：单元格编辑覆盖层 .univer-editor-container 的尺寸 —— 空闲时约 2×2，进入编辑后变成单元格大小（如 90×26）。 */
function finIsEditingCell(){
  try {
    /* ★★FIN-EDIT-SCOPE-20261017★★ 只扫【财务自己的容器】。
       旧写法 document.querySelectorAll('.univer-editor-container') 是全局扫描：
       本页同时存在财务 / 股东权益两套 Univer 实例，只要任意一套的编辑覆盖层有尺寸
       （哪怕它是隐藏 view 里的残留），这里就会恒判"编辑中" →
       Ctrl+C / Ctrl+X 的补写分支被整体跳过 → 剪贴板恒为空、复制"没反应"。
       这与"只要一改快捷键就坏"的现象完全对应。 */
    var host = document.getElementById('univer_container') || document;
    var boxes = host.querySelectorAll('.univer-editor-container');
    for (var i = 0; i < boxes.length; i++) {
      var r = boxes[i].getBoundingClientRect();
      if (r.width > 10 && r.height > 10) return true;
    }
  } catch(e){}
  return false;
}

function finActiveCell(){
  try {
    var sh = finSheetObj(); if (!sh) return null;
    var sel = sh.getSelection && sh.getSelection();
    var ar = sel && sel.getActiveRange && sel.getActiveRange();
    if (!ar) return null;
    return { row: ar.getRow(), col: ar.getColumn() };
  } catch(e){ return null; }
}

/* 可见区（兼容两种返回：FRange 门面 / 纯 {startRow,endRow,...} 对象，实测两者都出现过） */
function finVisibleRange(){
  try {
    var sh = finSheetObj(); if (!sh) return null;
    var vr = sh.getVisibleRange && sh.getVisibleRange();
    if (!vr) return null;
    if (typeof vr.startRow === 'number' && typeof vr.endRow === 'number') {
      return { startRow: vr.startRow, endRow: vr.endRow, startColumn: vr.startColumn, endColumn: vr.endColumn };
    }
    if (vr.getRow && vr.getNumRows) {
      var r0 = vr.getRow(), c0 = vr.getColumn();
      return { startRow: r0, endRow: r0 + vr.getNumRows() - 1,
               startColumn: c0, endColumn: c0 + vr.getNumColumns() - 1 };
    }
  } catch(e){}
  return null;
}

/* 当前滚动位置（视口左上角落在哪一行/列） */
function finScrollState(){
  try {
    var sh = finSheetObj(); if (!sh || !sh.getScrollState) return null;
    var s = sh.getScrollState();
    if (!s) return null;
    return { row: s.sheetViewStartRow || 0, col: s.sheetViewStartColumn || 0 };
  } catch(e){ return null; }
}

/* 滚动到「让 startRow/startCol 落在视口左上角」。
   实测 scrollToCell(n, m) 的语义就是把第 n 行/第 m 列顶到视口左上角（并自动夹紧到边界），
   因此可以用它实现 Excel 的「最小滚动」。 */
function finScrollTo(startRow, startCol){
  try {
    var sh = finSheetObj(); if (!sh || !sh.scrollToCell) return false;
    if (startRow < 0) startRow = 0;
    if (startCol < 0) startCol = 0;
    sh.scrollToCell(startRow, startCol);
    return true;
  } catch(e){ return false; }
}

/* ★Excel 的「选区跟随滚动」：选区出了可见区才滚，且只滚到刚好露出来（不把单元格顶到最上面）。
   ★为什么必须自己做：真实财务报表页（choice_lite.html → #univer_container，带 filter/sort 插件、
   容器 overflow:visible）里 Univer 0.5.5 的方向键【完全不会】把选区带进视野 —— 实测按住 ↓ 一路走到
   第 26 行，scrollState 始终 [0,0]、可见区始终 0..14，选中的格子早就跑到屏幕外看不见了。
   而在另建的极简验证床上同一个版本是会滚的，说明这是宿主环境差异，不能指望 Univer 自己修好。
   这里统一在按键之后补一次「最小滚动」，让两个宿主表现一致（Excel 行为）。 */
function finEnsureVisible(){
  try {
    var cur = finActiveCell(); if (!cur) return;
    var vr = finVisibleRange(); if (!vr) return;
    var ss = finScrollState(); if (!ss) return;
    var nsr = ss.row, nsc = ss.col;
    if (cur.row > vr.endRow) nsr = ss.row + (cur.row - vr.endRow);
    else if (cur.row < vr.startRow) nsr = ss.row - (vr.startRow - cur.row);
    if (typeof vr.endColumn === 'number') {
      if (cur.col > vr.endColumn) nsc = ss.col + (cur.col - vr.endColumn);
      else if (cur.col < vr.startColumn) nsc = ss.col - (vr.startColumn - cur.col);
    }
    if (nsr < 0) nsr = 0;
    if (nsc < 0) nsc = 0;
    if (nsr !== ss.row || nsc !== ss.col) finScrollTo(nsr, nsc);
  } catch(e){}
}

function finIsDateSerialish(x){ return typeof x === 'number' && isFinite(x); }

/* 取得"最后一个有内容的单元格"（Ctrl+End），Excel 语义。
   ★不能拿 getDataRange() 的行列数去推：Univer 0.5.5 的 getDataRange() 总是从 A1 开始，
   且 FRange 上【没有】getNumRows/getNumColumns/getRowCount/getColumnCount（实测全 undefined），
   旧写法会一路兜底成 1×1，于是 Ctrl+End 永远停在 A1（实测 act=[0,0]）。
   正确来源是 Worksheet 门面上的 getLastRow()/getLastColumn()（实测 60/1 正确）。*/
function finLastUsedCell(){
  try {
    var sh = finSheetObj(); if (!sh) return null;
    var lr = (typeof sh.getLastRow === 'function') ? sh.getLastRow() : null;
    var lc = (typeof sh.getLastColumn === 'function') ? sh.getLastColumn() : null;
    if (typeof lr === 'number' && typeof lc === 'number' && lr >= 0 && lc >= 0) {
      return { row: lr, col: lc };
    }
    /* 兜底：在 getDataRange() 的值矩阵里从右下往上找最后一个非空格 */
    var rng = sh.getDataRange && sh.getDataRange();
    if (!rng || !rng.getValues) return null;
    var v = rng.getValues(); if (!v || !v.length) return null;
    var r0 = rng.getRow ? rng.getRow() : 0, c0 = rng.getColumn ? rng.getColumn() : 0;
    for (var i = v.length - 1; i >= 0; i--) {
      var row = v[i] || [];
      for (var j = row.length - 1; j >= 0; j--) {
        var val = row[j];
        if (val !== null && val !== undefined && val !== '') return { row: r0 + i, col: c0 + j };
      }
    }
    return null;
  } catch(e){ return null; }
}

/* 某一行的最后一个有内容的列（End 键；Excel 语义：本行最右边有数据的格子） */
function finRowLastCol(row){
  try {
    var sh = finSheetObj(); if (!sh) return 0;
    var maxC = (typeof sh.getMaxColumns === 'function') ? sh.getMaxColumns() : 0;
    var lastC = (typeof sh.getLastColumn === 'function') ? sh.getLastColumn() : 0;
    if (maxC > 0 && lastC > maxC - 1) lastC = maxC - 1;
    if (lastC <= 0) return 0;
    var vals = sh.getRange(row, 0, 1, lastC + 1).getValues();
    var r = vals && vals[0]; if (!r) return 0;
    for (var c = r.length - 1; c >= 0; c--) {
      var v = r[c];
      if (v !== null && v !== undefined && v !== '') return c;
    }
  } catch(e){}
  return 0;
}

/* 表格总行/列数（边界判定的唯一来源）。
   ★不能只用 getMaxRows()/getMaxColumns()：实测真实财务报表里 getMaxRows() 返回 42，
     而 getLastRow() 是 43（xlsx→快照时 rowCount 没跟着数据一起更新）。
     拿它当边界会把光标卡在第 41 行、最后几行永远走不到。
     所以取「声明行列数」与「最后一个有数据的行列 + 1」中的较大值。 */
function finSheetSize(){
  try {
    var sh = finSheetObj(); if (!sh) return null;
    var r = (sh.getMaxRows ? sh.getMaxRows() : 0) || 0;
    var c = (sh.getMaxColumns ? sh.getMaxColumns() : 0) || 0;
    try {
      var lr = (typeof sh.getLastRow === 'function') ? sh.getLastRow() : -1;
      var lc = (typeof sh.getLastColumn === 'function') ? sh.getLastColumn() : -1;
      if (typeof lr === 'number' && lr >= 0) r = Math.max(r, lr + 1);
      if (typeof lc === 'number' && lc >= 0) c = Math.max(c, lc + 1);
    } catch(e2){}
    return { rows: r, cols: c };
  } catch(e){ return null; }
}

/* 取"主表格画布"。
   ★不能直接用 document.querySelector('.univer-render-canvas')：DOM 里第一个匹配的是
   公式栏里的小画布（实测 888×27，父节点 .univer-sheet-embedding-formula-editor-text），
   拿它算不出可见行数（曾导致 finPageRows() 返回 0、PageUp/PageDown 完全不生效）。
   主表格画布是 .univer-workbench-container-canvas 里的那块（实测 1098×323 / 真实报表 1380×561）。 */
function finGridCanvas(){
  try {
    var cv = document.querySelector('.univer-workbench-container-canvas canvas.univer-render-canvas');
    if (cv && cv.getBoundingClientRect().height > 60) return cv;
    /* 兜底：排除公式栏内的小画布，取最高的一块 */
    var all = document.querySelectorAll('canvas.univer-render-canvas');
    var best = null, bestH = 0;
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (el.closest && el.closest('.univer-sheet-embedding-formula-editor')) continue;
      var r = el.getBoundingClientRect();
      if (r.height > bestH) { bestH = r.height; best = el; }
    }
    return (best && bestH > 60) ? best : null;
  } catch(e){ return null; }
}

/* 一屏能显示多少行（用于 PageUp/PageDown；取不到就返回 0 = 不接管） */
function finPageRows(){
  try {
    var vr = finVisibleRange();
    if (vr && typeof vr.endRow === 'number') {
      var n = vr.endRow - vr.startRow;      // Excel：PageDown 走「可见行数 - 1」行
      if (n >= 1) return n;
    }
    var cv = finGridCanvas();
    if (!cv) return 0;
    var h = cv.getBoundingClientRect().height;
    if (!h || h < 60) return 0;
    var rowH = 24;   // Univer 0.5.5 默认行高（实测：y=61 起、每行 24px）
    try {
      var sh = finSheetObj();
      var cur = finActiveCell();
      var ws = sh && sh.getSheet && sh.getSheet();
      var rd = (ws && ws.getRowData && cur) ? ws.getRowData(cur.row) : null;
      if (rd && rd.h) rowH = rd.h;
    } catch(e){}
    return Math.max(2, Math.floor((h - 26) / rowH) - 1);
  } catch(e){ return 0; }
}

/* 跳到某格：activate() 换掉选区。不主动滚动，由 finEnsureVisible() 统一按 Excel 语义补最小滚动 */
function finGotoCell(row, col){
  try {
    var sh = finSheetObj(); if (!sh) return false;
    var sz = finSheetSize() || {};
    var maxR = sz.rows || 100000;
    var maxC = sz.cols || 200;
    if (row < 0) row = 0;
    if (col < 0) col = 0;
    if (row > maxR - 1) row = maxR - 1;
    if (col > maxC - 1) col = maxC - 1;
    var rng = sh.getRange(row, col);
    if (rng && rng.activate) rng.activate();
    else if (sh.setActiveRange) sh.setActiveRange(rng);
    finRememberCur({ row: row, col: col });     /* 主动跳格后同步快照 */
    return true;
  } catch(e){ return false; }
}

/* ★FIN-EXCEL-SELALL-20261016（用户 2026-10-16：「快捷键还是没有用，包括鼠标右键点击出现的
   弹出框，选择全部功能也没作用」）：
   现象：Ctrl+A 与右键菜单「选择全部」都像没反应。
   根因（Univer 0.5.5 sheets-ui 产物实测）：全选命令 id = 'sheet.command.select-all'
   （快捷键 A + CTRL_COMMAND），但它的 handler 取的是【当前活动工作簿】
   （IUniverInstanceService.getCurrentUnitForType(UNIVER_SHEET)）。
   本页同时存在两套 Univer 实例（财务 univer_container + 权益 equity_container），
   财务容器没有成为"当前单元"时，这条命令就作用到了【权益】那张不可见的工作簿上
   —— 看起来就是"点了没反应"（与「插入行插到权益表」是同一类根因）。
   做法：不依赖"当前单元"，显式拿财务自己的 Worksheet 框选整张表（activate 是按对象作用的）。 */
function finSelectAll(){
  try {
    var sh = finSheetObj(); if (!sh) return 0;
    var sz = finSheetSize() || {};
    var maxR = (sz.rows > 0) ? sz.rows : ((sh.getMaxRows && sh.getMaxRows()) || 0);
    var maxC = (sz.cols > 0) ? sz.cols : ((sh.getMaxColumns && sh.getMaxColumns()) || 0);
    if (!(maxR > 0)) maxR = 1;
    if (!(maxC > 0)) maxC = 1;
    var rng = sh.getRange(0, 0, maxR, maxC);
    if (rng && rng.activate) rng.activate();
    else if (sh.setActiveRange && rng) sh.setActiveRange(rng);
    finRememberCur({ row: 0, col: 0 });
    try { fin_statSchedule(); } catch(e){}     /* 统计栏跟着刷新（走既有的 debounce） */
    return maxR * maxC;
  } catch(e){ return 0; }
}
/* 「选择全部」菜单项的三语文案（Univer 菜单文案随界面语言走）：
   zh 选择全部 / 全部选择 / 全选 · en Select all · vi Chọn tất cả */
var FIN_SELALL_WORD = /(选择全部|全部选择|全选|select\s*all|chọn\s*tất\s*cả|chon\s*tat\s*ca)/i;

/* ★Ctrl+方向键：跳到「数据边界」（Excel 语义）。
   实测 Univer 原生只做到「本块末尾」，再按一次直接跳到整表最后一行/列，跨过空档不会停在下一块数据上。
   这里按 Excel 规则自己算：邻格有内容 → 跳到本连续块的最后一个；邻格为空 → 跳到该方向上下一个非空格；
   该方向再无数据 → 跳到整表最后一行/列。扫描范围超过 MAXSCAN 就放弃（交回 Univer 原生），避免大表卡死。 */
var FIN_EDGE_SCAN = 4000;
function finDataEdge(dr, dc, base){
  try {
    var sh = finSheetObj(); if (!sh) return null;

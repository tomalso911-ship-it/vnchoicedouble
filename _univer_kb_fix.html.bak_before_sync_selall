          r0 = g0.startRow; c0 = g0.startColumn;
        }
      } catch(eG){}
      if (r0 < 0){
        try {
          var _fr = (typeof fin_getSelectionRanges === 'function') ? fin_getSelectionRanges() : null;
          if (_fr && _fr.length && typeof _fr[0].startRow === 'number'){
            r0 = _fr[0].startRow; c0 = _fr[0].startColumn;

        return false;
      }
      /* ★CLIP-TILE-20261018：选区是源块整数倍时铺满整个选区 */
      var _td0 = fin_clipTileDims(sh0, r0, c0, m0.length, m0[0].length);
      var _tn0 = _td0.tr, _tc0 = _td0.tc;
      if (_tn0 * _tc0 > 20000){ _tn0 = m0.length; _tc0 = m0[0].length; }
      var _mv0 = (_tn0 === m0.length && _tc0 === m0[0].length) ? m0 : fin_clipTileMat(m0, _tn0, _tc0);
      sh0.getRange(r0, c0, _tn0, _tc0).setValues(_mv0);
      try { if (typeof fin_markDirty === 'function') fin_markDirty(); } catch(eD){}
      try { window.__finClipLast = { len: String(text).length, ok: true, paste: true }; } catch(eL){}
      return true;
    } catch(err){ return false; }
  }
  /* ★★CLIP-RICH-20261018（用户 2026-10-18：「复制粘贴的时候，单元格的格式、颜色、字号、
     对齐方式，等等一切都要 100% 和被复制的内容一样！」）★★
     本页复制过【同一段文本】时走这里：值 + 公式 + 整块样式对象一起还原。
     样式还原用【两遍法】（沿用撤销账本 FIN-UNDO-STYLE 的实测结论）：
       第一遍 {v,f,t,s:null} —— 覆盖值，同时把目标格原有样式整体清掉；
       第二遍 {s: 源样式}    —— 把源格的样式整块铺回去（字体/字号/粗斜体/字色/底色/
                                边框/水平垂直对齐/自动换行/数字格式 pattern 全在里面）。
     为什么必须先清：这一版 Univer 的 set-range-values 对样式是 merge 语义，
     不清的话目标格原有的底色/字色会残留在「源格没有该键」的位置 → 做不到 100% 一样。
     ★跨应用复制（剪贴板文本与镜像不一致）仍走纯文本粘贴，不受影响。 */
  function fin_clipPasteRich(text){
    try {
      var M = window.__finClipMirror;
      /* ★CLIP-RICH-XMODULE-20261018：本表没有镜像时用全局镜像（另一张表刚复制的） */
      if ((!M || !M.mat || !M.mat.length) && window.__clipRichGlobal && window.__clipRichGlobal.mat) M = window.__clipRichGlobal;
      if (!M || !M.mat || !M.mat.length) return false;
      /* ★CLIP-TEXT-NORM-20261018：必须用换行归一化比较 —— 系统剪贴板会把 \n 变 \r\n，
         严格相等会让多行复制粘贴永远失配 → 静默退回纯文本（用户看到的就是"格式没过去") */
      var _nt = (window.clipNormText || function(x){ return String(x == null ? '' : x).replace(/\r\n?/g, '\n'); });
      if (_nt(M.text) !== _nt(text)) return false;                             /* 不是本页刚复制的那段 */
      if (!(Date.now() - (M.at || 0) < 30 * 60 * 1000)) return false;          /* 镜像过期 → 纯文本 */
      var api0 = finAPI(); if (!api0 || !api0.executeCommand) return false;
      var wb0 = api0.getActiveWorkbook(); if (!wb0) return false;
      var sh0 = wb0.getActiveSheet(); if (!sh0) return false;
      var r0 = -1, c0 = -1;
      try {
        var g0 = sh0.getSelection().getActiveRange().getRange();
        if (g0 && typeof g0.startRow === 'number'){
          r0 = g0.startRow; c0 = g0.startColumn;
        }
      } catch(eG){}
      if (r0 < 0){
        try {
          var _fr = (typeof fin_getSelectionRanges === 'function') ? fin_getSelectionRanges() : null;
          if (_fr && _fr.length && typeof _fr[0].startRow === 'number'){
            r0 = _fr[0].startRow; c0 = _fr[0].startColumn;
          }
        } catch(eF){}
      }
      if (r0 < 0 || c0 < 0){
        console.warn('[fin-paste] 取不到粘贴落点，已放弃（绝不写回 A1）');
        return false;
      }
      var nr = M.mat.length, nc = 0, i2;
      for (i2 = 0; i2 < nr; i2++){ if (M.mat[i2] && M.mat[i2].length > nc) nc = M.mat[i2].length; }
      if (!(nr > 0) || !(nc > 0) || nr * nc > 20000) return false;
      /* ★CLIP-TILE-20261018：选区是源块整数倍 → 铺满选区（Excel 行为） */
      var _td1 = fin_clipTileDims(sh0, r0, c0, nr, nc);
      var tr = _td1.tr, tc = _td1.tc;
      if (tr * tc > 20000) return false;
      var sid = '';
      try { sid = (sh0.getSheetId) ? sh0.getSheetId() : ''; } catch(eS){ sid = ''; }
      var uid = (typeof fin_unitId === 'function') ? (fin_unitId() || '') : '';
      var m1 = [], m2 = [], anyS = false, r, c;
      for (r = 0; r < tr; r++){
        var row1 = [], row2 = [];
        for (c = 0; c < tc; c++){
          var cell = (M.mat[r % nr] && M.mat[r % nr][c % nc]) ? M.mat[r % nr][c % nc] : null;
          var o1 = { v: (cell && cell.v !== undefined) ? cell.v : null,
                     f: (cell && cell.f !== undefined) ? cell.f : null,
                     t: (cell && cell.t !== undefined) ? cell.t : null };
          if (!(cell && cell.uc)) o1.s = null;          /* 第一遍：清样式（第二遍再铺回去） */
          row1.push(o1);
          if (cell && cell.s){
            var sCopy = null;
            try { sCopy = JSON.parse(JSON.stringify(cell.s)); } catch(eC){ sCopy = cell.s; }
            row2.push({ s: sCopy }); anyS = true;
          } else row2.push({});                          /* 空对象 = 不动 */
        }
        m1.push(row1); m2.push(row2);
      }
      var rg = { startRow: r0, startColumn: c0, endRow: r0 + tr - 1, endColumn: c0 + tc - 1 };
      var applyStyles = function(){
        if (!anyS) return;
        try {
          var p2 = api0.executeCommand('sheet.command.set-range-values', {
            unitId: uid, subUnitId: sid, range: rg, value: m2
          });
          if (p2 && typeof p2.then === 'function') p2.catch(function(){});
        } catch(e2){}
      };
      var p1 = api0.executeCommand('sheet.command.set-range-values', {
        unitId: uid, subUnitId: sid, range: rg, value: m1
      });
      if (p1 && typeof p1.then === 'function') p1.then(applyStyles, applyStyles);
      else applyStyles();
      /* ★FIN-UNDO-ONEGESTURE-20261018：粘贴后把选区留在【整个粘贴区】（Excel 手感）。
         同时这也是记账必要的：撤销账本按"当前选区"兜底取范围，选区只有 1 格时
         撤销只会写回第一格 → 第二格撤不干净（探针 48 实测 ["",222]）。 */
      try { sh0.getRange(r0, c0, tr, tc).activate(); } catch(eA0){}
      try { if (typeof fin_markDirty === 'function') fin_markDirty(); } catch(eD){}
      try { window.__finClipLast = { len: String(text).length, ok: true, paste: true, rich: true }; } catch(eL){}
      return true;
    } catch(err){ return false; }
  }
  function fin_clipClearSel(){
    try {
      var api0 = finAPI(); if (!api0) return false;
      var pr = api0.executeCommand('sheet.command.clear-selection-content', {});
      if (pr && typeof pr.then === 'function') pr.catch(function(){});
      try { if (typeof fin_markDirty === 'function') fin_markDirty(); } catch(eD){}
      return true;
    } catch(err){ return false; }
  }
  /* 兼容老调用点/探针：名字保留，内部统一走引擎 */
  function fin_clipWrite(text){
    try { return !!(window.__clipEngine && window.__clipEngine.write(text)); } catch(err){ return false; }
  }
  /* ★CLIP-TEXT-NORM-20261018：换行归一化器暴露到 window，财务/权益两套适配器共用，
     防止系统剪贴板把 \n 变成 \r\n 后带格式粘贴静默失效 */
  try { if (window.__clipEngine && window.__clipEngine.normText) window.clipNormText = window.__clipEngine.normText; } catch(eN0){}
  try {
    if (window.__clipEngine && window.__clipEngine.register){
      window.__clipEngine.register('fin', {
        el: function(){ return document.getElementById('univer_container'); },
        text: fin_clipMatrixText,
        write: fin_clipPasteText,
        /* ★CLIP-RICH-20261018：带格式粘贴（本页复制过的内容才生效，否则引擎自动退回 write） */
        rich: fin_clipPasteRich,
        clear: fin_clipClearSel
      });
      window.__clipEvtFin = true;          /* 接线标记（3 秒自检 + 硬锁脚本用） */
    }
  } catch(errReg){}
  function finIsUniverElem(el){
    try {
      if (!el || el.nodeType !== 1) return false;
      if (el.classList && el.classList.contains('univer-editor')) return true;
      if (el.closest && el.closest('.univer-editor-container')) return true;
      if (el.closest && el.closest('.univer-workbench-layout')) return true;
      if (el.closest && el.closest('.univer-container')) return true;
    } catch(err){}
    return false;
  }
  function inScope(e){
    try {
      var c = finContainer(); if (!c) return false;
      if (!c.offsetHeight && !c.getClientRects().length) return false;   // 容器不可见 → 不接管
      var t = e && e.target, a = document.activeElement;
      if (t && c.contains(t)) return true;
      if (a && c.contains(a)) return true;
      if (finIsUniverElem(t) || finIsUniverElem(a)) return true;
      return false;
    } catch(err){ return false; }
  }

  window.addEventListener('keydown', function(e){
    try {
      if (!e || e.isComposing) return;
      /* 诊断开关：window.__finDebug = [] 时记录每个按键走了哪条路（排障用，未开启时零开销） */
      if (window.__finDebug) { try { window.__finDebug.push(e.key + (inScope(e) ? '' : '|OUTSCOPE')); } catch(e3){} }
      finLastKeyAt = Date.now();
      if (!inScope(e)) return;
      var k = e.key;
      var editing = finIsEditingCell();

      /* ★★FIN-CLIP-PASS-LOCK-20261017（用户 2026-10-17：「Ctrl+C / Ctrl+X / Ctrl+V 又不能使用了」）★★
         剪贴板三键【永不拦截】：一律原样交给 Univer 自己的复制 / 剪切 / 粘贴。
         历史上它们反复失效，都是因为有人在这段键盘补丁里"顺手"把它们 preventDefault /
         stopPropagation 掉了（补丁是 window 捕获阶段，抢在 Univer 之前，一拦就彻底没反应）。
         这里显式放行，并由 check_fin_excel_keys_lock.py 不变量⑧ 静态校验；
         任何重构都不得在这三个键上加 preventDefault / stopPropagation，也不得删掉本段。 */
      var finClipKey = (k === 'c' || k === 'C' || k === 'x' || k === 'X' || k === 'v' || k === 'V');
      if (e.ctrlKey && !e.shiftKey && !e.altKey && finClipKey) {
        /* ★CLIP-ENGINE-20261018：C/X/V 统一交给全局引擎（见文件顶部 CLIP-ENGINE 说明）。
           · C/X：引擎自己写系统剪贴板（同步 execCommand + copy/cut 事件双通道），X 还会立刻清空选区
           · V：引擎不拦，等浏览器发 paste 事件后由引擎接管（从 clipboardData 读，绕开权限）
           这里【绝不】preventDefault / stopPropagation。 */
        try { if (window.__clipEngine) window.__clipEngine.handleKey(e, 'fin'); } catch(errClip){}
        return;   /* ★绝不 preventDefault / stopPropagation —— 放行给 Univer 自己的命令 */
      }

      /* ① 编辑态：Delete = 删除光标右侧一个字符（Excel 行为）。
            Univer 0.5.5 在编辑态对 Delete 完全不处理（实测无任何命令），
            这里直接派发文档域的向前删除命令。 */
      if (editing) {
        if (k === 'Delete' && !e.ctrlKey && !e.altKey && !e.metaKey) {
          e.preventDefault();
          e.stopPropagation();
          try { finAPI().executeCommand('doc.command.delete-right', {}); } catch(err){}
          return;
        }
        return;   // 编辑态的其它按键一律交回 Univer
      }

      /* ①-a ★FIN-EXCEL-SELALL-20261016：Ctrl+A / ⌘A = 全选（Excel 行为）。
         为什么自己实现、不派发 sheet.command.select-all：那条命令的 handler 内部取的是
         "当前活动工作簿"（getCurrentUnitForType），两套 Univer 实例下会落到权益那张表上
         —— 正是用户反馈的"右键菜单里的选择全部没作用"。见 finSelectAll() 的注释。 */
      if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && (k === 'a' || k === 'A')) {
        e.preventDefault(); e.stopPropagation();
        finSelectAll();
        return;
      }

      if (e.altKey || e.metaKey) return;
      /* ★FIN-TYPE-EDIT-20261018：非编辑态敲可打印字符 → 直接进入编辑并写入该字符（Excel 行为）。
         命中后 preventDefault + stopPropagation，避免 Univer 再按自己的语义处理一遍。
         汉字/输入法不走这里（那些 keydown 的 isComposing = true，上面早就 return 了），
         由下方 compositionend 分支接管。 */
      if (!e.ctrlKey && k && k.length === 1) {
        if (fin_typeHostBlocked(e)) return;      /* 输入框/公式栏里打字 → 交给它们自己 */
        if (Date.now() - fin_typeImeAt < 200) return;   /* 输入法刚落字，别再补一次 */
        e.preventDefault(); e.stopPropagation();
        fin_typeToEdit(k);
        return;
      }
      var cur = finActiveCell();
      if (!cur) return;
      if (window.__finDebug) { try { window.__finDebug[window.__finDebug.length - 1] += '|cur=' + cur.row + ',' + cur.col; } catch(e4){} }
      var sz = finSheetSize() || {};
      var maxR = sz.rows || 0;
      var maxC = sz.cols || 0;

      /* ② 普通方向键：Excel 走到表格边界就停住，不会回卷到下一列/上一行（Univer 会回卷）。
            判据用「按键之前」的快照 prev（Univer 可能已经先动过手了），并直接识别回卷特征。 */
      if (!e.ctrlKey && (k === 'ArrowUp' || k === 'ArrowDown' || k === 'ArrowLeft' || k === 'ArrowRight')) {
        var prev = finPrevCur || cur;
        var wrapped = (k === 'ArrowDown' && cur.row < prev.row)
                   || (k === 'ArrowUp' && cur.row > prev.row)
                   || (k === 'ArrowRight' && cur.col < prev.col)
                   || (k === 'ArrowLeft' && cur.col > prev.col);
        var atEdge = (k === 'ArrowDown' && maxR > 0 && prev.row >= maxR - 1)
                  || (k === 'ArrowUp' && prev.row <= 0)
                  || (k === 'ArrowRight' && maxC > 0 && prev.col >= maxC - 1)
                  || (k === 'ArrowLeft' && prev.col <= 0);
        if (atEdge || wrapped) {
          e.preventDefault(); e.stopPropagation();
          if (cur.row !== prev.row || cur.col !== prev.col) finGotoCell(prev.row, prev.col);   // 撤销 Univer 的回卷
          finRememberCur(prev);
          followSoon();
          return;
        }
        followSoon();
        finRememberSoon();
        return;
      }

      /* ③ Ctrl+方向键：Excel 的数据边界语义（邻格有值→本块末尾；邻格为空→跨空档到下一块；
            该方向没数据→整表最后一行/列）。基准取「按键之前」的快照，避开 Univer 已先移动的干扰。 */
      if (e.ctrlKey && !e.shiftKey && (k === 'ArrowUp' || k === 'ArrowDown' || k === 'ArrowLeft' || k === 'ArrowRight')) {
        var base = finPrevCur || cur;
        var dr = (k === 'ArrowDown') ? 1 : (k === 'ArrowUp' ? -1 : 0);
        var dc = (k === 'ArrowRight') ? 1 : (k === 'ArrowLeft' ? -1 : 0);
        var t = finDataEdge(dr, dc, base);
        if (t) {
          e.preventDefault(); e.stopPropagation();
          finGotoCell(t.row, t.col);
          finRememberCur(t);
          followSoon();
          return;
        }
        followSoon();     /* 算不出来（超大表）就交回 Univer 原生，滚动照样要跟 */
        finRememberSoon();
        return;
      }

      if (!e.ctrlKey && !e.shiftKey && k === 'Home') {          /* 行首（A 列），纵向视口不动 */
        e.preventDefault(); e.stopPropagation();
        var ssH = finScrollState();
        finGotoCell(cur.row, 0);
        finScrollToSoon(ssH ? ssH.row : 0, 0);
        return;
      }
      if (!e.ctrlKey && !e.shiftKey && k === 'End') {           /* 本行最后一个有内容的列（贴右边缘露出） */
        e.preventDefault(); e.stopPropagation();
        var ssE = finScrollState(), vrE = finVisibleRange();
        var tc = finRowLastCol(cur.row);
        var nsc = ssE ? ssE.col : 0;
        var vcols = (vrE && typeof vrE.endColumn === 'number') ? Math.max(1, vrE.endColumn - vrE.startColumn + 1) : 1;
        if (tc < nsc) nsc = tc;
        else if (tc > nsc + vcols - 1) nsc = tc - vcols + 1;
        finGotoCell(cur.row, tc);
        finScrollToSoon(ssE ? ssE.row : 0, Math.max(0, nsc));
        return;
      }
      if (e.ctrlKey && !e.shiftKey && k === 'Home') {           /* A1（Excel：视口也回到左上角） */
        e.preventDefault(); e.stopPropagation();
        finGotoCell(0, 0);
        finScrollToSoon(0, 0);
        return;
      }
      if (e.ctrlKey && !e.shiftKey && k === 'End') {            /* 最后一个有内容的格子（Excel：贴右下角露出） */
        e.preventDefault(); e.stopPropagation();
        var last = finLastUsedCell();
        if (last) {
          var vr = finVisibleRange();
          var rows = vr ? Math.max(1, vr.endRow - vr.startRow + 1) : 1;
          var cols = (vr && typeof vr.endColumn === 'number') ? Math.max(1, vr.endColumn - vr.startColumn + 1) : 1;
          finGotoCell(last.row, last.col);
          finScrollToSoon(Math.max(0, last.row - rows + 1), Math.max(0, last.col - cols + 1));
        }
        return;
      }
      if (!e.ctrlKey && !e.shiftKey && (k === 'PageDown' || k === 'PageUp')) {
        var page = finPageRows();
        if (page <= 0) return;                     // 量不到就不接管，保持 Univer 原样
        e.preventDefault(); e.stopPropagation();
        var ss = finScrollState();
        var target = (k === 'PageDown') ? cur.row + page : cur.row - page;
        finGotoCell(target, cur.col);
        /* Excel：选区与视口移动同样多的行 → 选区在屏幕上的相对位置保持不变 */
        if (ss) finScrollToSoon((k === 'PageDown') ? ss.row + page : Math.max(0, ss.row - page), ss.col);
        else followSoon();
        return;
      }

      /* ④ 其它会动选区的键（Tab / Enter / Shift+方向键…）：不拦，只补跟随滚动 */
      if (k === 'Tab' || k === 'Enter') followSoon();
    } catch(err){}
  }, true);

  /* ★★FIN-TYPE-EDIT-IME-20261018（用户 2026-10-18：「直接打汉字也能输入」）★★
     汉字/日文/韩文走输入法：这些按键的 keydown 都是 isComposing = true（keyCode 229），
     上面的键盘补丁一律 return，Univer 在非编辑态也不会把它们写进单元格。
     做法：等输入法在 compositionend 把整段文字交出来时，用同一套「先写值再多开编辑器」
     （fin_typeToEdit）把它写进当前格并打开编辑器，光标落在末尾。
     · 只在【非编辑态】且事件归属财务表时接管（inScope 已含可见性判断）；
     · 不 preventDefault / stopPropagation —— 输入法自身的收尾交给浏览器。 */
  window.addEventListener('compositionend', function(e){
    try {
      if (!e || e.isComposing) return;
      var txt = e.data;
      if (!txt) return;
      if (fin_typeHostBlocked(e)) return;
      if (!inScope(e)) return;
      if (finIsEditingCell()) return;
      fin_typeImeAt = Date.now();
      fin_typeToEdit(txt);
    } catch(err){}
  }, true);

  /* ★锁死区自检（FIN-EXCEL-KEYS-LOCK-20261011）：确认依赖的函数与接线都在。
     只报错，不抛异常、不影响表格使用。★不得移除本调用。 */
  try { finExcelKeysLockCheck(); } catch(e){}
}
